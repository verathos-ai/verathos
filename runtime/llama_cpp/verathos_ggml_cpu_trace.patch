+static int64_t verathos_cpu_graph_sequence = 0;
+static int64_t verathos_cpu_intra_graph_index = 0;
+static int64_t verathos_cpu_graph_dim_valid_ops = 0;
+static int64_t verathos_cpu_graph_written_rows = 0;
+static int64_t verathos_cpu_graph_max_src1_rows = 0;
