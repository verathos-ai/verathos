+static int64_t verathos_cpu_trace_sequence = 0;
+static int64_t verathos_cpu_manifest_sequence = 0;
+static char verathos_cpu_trace_capture_token[4096] = {0};
+static int64_t verathos_cpu_selected_manifest_indexes[64] = {0};
