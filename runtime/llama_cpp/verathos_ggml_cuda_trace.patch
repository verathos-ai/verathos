+static int64_t verathos_cuda_env_i64(const char * name, int64_t fallback) {
+    const char * raw = std::getenv(name);
+    if (raw == nullptr || raw[0] == '\0') {
+        return fallback;
+    }
+    try {
+        return std::stoll(raw);
+    } catch (...) {
+        return fallback;
+    }
+}
