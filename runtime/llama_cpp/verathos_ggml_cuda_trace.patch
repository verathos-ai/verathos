+        return;
+    }
+    if (!selected_op_dump && !verathos_cuda_should_dump_manifest_index(manifest_index)) {
+        return;
+    }
+    const int64_t sequence = ++verathos_cuda_trace_sequence;
+
+    const bool skip_src0_dump = verathos_cuda_env_bool("VERATHOS_GGML_TRACE_SKIP_SRC0_DUMP", false);
+    std::vector<uint8_t> src0_raw;
+    std::vector<uint8_t> src1_raw;
+    std::vector<uint8_t> dst_raw;
+    if ((!skip_src0_dump && !verathos_cuda_tensor_raw_to_host(ctx, src0, src0_raw)) ||
+        !verathos_cuda_tensor_raw_to_host(ctx, src1, src1_raw) ||
+        !verathos_cuda_tensor_raw_to_host(ctx, dst, dst_raw)) {
+        return;
+    }
+    CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+
+    std::vector<float> src0_f32;
+    std::vector<float> src1_f32;
+    std::vector<float> dst_f32;
+    if ((!skip_src0_dump && !verathos_cuda_raw_to_f32(src0, src0_raw, src0_f32)) ||
+        !verathos_cuda_raw_to_f32(src1, src1_raw, src1_f32) ||
+        !verathos_cuda_raw_to_f32(dst, dst_raw, dst_f32)) {
+        return;
+    }
+
+    std::ostringstream prefix;
+    prefix << dir << "/trace-" << now_ns << "-cuda" << ctx.device << "-op" << manifest_index;
+    const std::string src0_path = prefix.str() + "-src0.f32";
+    const std::string src0_raw_path = prefix.str() + "-src0.raw";
+    const std::string src1_path = prefix.str() + "-src1.f32";
+    const std::string dst_path  = prefix.str() + "-dst.f32";
+    const std::string json_path = prefix.str() + ".json";
+    if ((!skip_src0_dump && !verathos_cuda_write_f32(src0_path, src0_f32)) ||
+        (!skip_src0_dump && !verathos_cuda_write_raw(src0_raw_path, src0_raw)) ||
+        !verathos_cuda_write_f32(src1_path, src1_f32) ||
+        !verathos_cuda_write_f32(dst_path, dst_f32)) {
+        return;
+    }
+
+    std::ofstream meta(json_path);
+    if (!meta) {
+        return;
+    }
+    meta << "{\n";
+    meta << "  \"version\": 1,\n";
+    meta << "  \"created_unix_ns\": " << now_ns << ",\n";
+    meta << "  \"manifest_index\": " << manifest_index << ",\n";
+    meta << "  \"graph_seq\": " << verathos_cuda_graph_sequence << ",\n";
+    meta << "  \"intra_graph_index\": " << intra_graph_index << ",\n";
+    meta << "  \"graph_id\": \"cuda" << ctx.device << "-mul-mat-" << manifest_index << "\",\n";
+    meta << "  \"op_index\": " << manifest_index << ",\n";
+    meta << "  \"op_type\": \"GGML_OP_MUL_MAT\",\n";
+    meta << "  \"tensor_name\": \"" << verathos_cuda_json_escape(src0->name) << "\",\n";
+    meta << "  \"src0_name\": \"" << verathos_cuda_json_escape(src0->name) << "\",\n";
+    meta << "  \"src1_name\": \"" << verathos_cuda_json_escape(src1->name) << "\",\n";
+    meta << "  \"dst_name\": \"" << verathos_cuda_json_escape(dst->name) << "\",\n";
+    meta << "  \"src0_shape\": [" << src0->ne[0] << "," << src0->ne[1] << "," << src0->ne[2] << "," << src0->ne[3] << "],\n";
+    meta << "  \"src1_shape\": [" << src1->ne[0] << "," << src1->ne[1] << "," << src1->ne[2] << "," << src1->ne[3] << "],\n";
+    meta << "  \"dst_shape\": [" << dst->ne[0] << "," << dst->ne[1] << "," << dst->ne[2] << "," << dst->ne[3] << "],\n";
+    if (!skip_src0_dump) {
+        meta << "  \"src0_f32\": \"" << verathos_cuda_filename(src0_path) << "\",\n";
+        meta << "  \"src0_raw\": \"" << verathos_cuda_filename(src0_raw_path) << "\",\n";
+    }
+    meta << "  \"src0_raw_type\": \"" << ggml_type_name((ggml_type) src0->type) << "\",\n";
+    meta << "  \"src1_f32\": \"" << verathos_cuda_filename(src1_path) << "\",\n";
+    meta << "  \"dst_f32\": \"" << verathos_cuda_filename(dst_path) << "\",\n";
+    meta << "  \"source_types\": {\"src0\": \"" << ggml_type_name((ggml_type) src0->type)
+         << "\", \"src1\": \"" << ggml_type_name((ggml_type) src1->type)
+         << "\", \"dst\": \"" << ggml_type_name((ggml_type) dst->type) << "\"},\n";
+    meta << "  \"backend\": \"llama_cpp_cuda\",\n";
+    meta << "  \"device\": \"CUDA" << ctx.device << "\"\n";
+    meta << "}\n";
+}
