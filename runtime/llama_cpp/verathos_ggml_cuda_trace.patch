+static bool verathos_cuda_env_bool(const char * name, bool fallback) {
+    const char * raw = std::getenv(name);
+    if (raw == nullptr || raw[0] == '\0') {
+        return fallback;
+    }
+    return raw[0] == '1' || raw[0] == 't' || raw[0] == 'T' ||
+           raw[0] == 'y' || raw[0] == 'Y';
+}
