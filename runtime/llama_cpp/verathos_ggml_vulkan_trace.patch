+static int64_t verathos_vk_trace_sequence = 0;
+static int64_t verathos_vk_manifest_sequence = 0;
+static std::string verathos_vk_trace_capture_token;
+static std::vector<int64_t> verathos_vk_selected_manifest_indexes;
+static int64_t verathos_vk_graph_sequence = 0;
+static int64_t verathos_vk_intra_graph_index = 0;
+static int64_t verathos_vk_graph_dim_valid_ops = 0;
+static int64_t verathos_vk_graph_written_rows = 0;
+static int64_t verathos_vk_graph_max_src1_rows = 0;
+static std::vector<std::pair<int64_t, int64_t>> verathos_vk_selected_ops;
+static std::ofstream verathos_vk_manifest_stream;
+static std::string verathos_vk_manifest_path;
+
+static const char * verathos_vk_trace_dir() {
+    return std::getenv("VERATHOS_GGML_TRACE_DIR");
+}
+
+static int64_t verathos_vk_env_i64(const char * name, int64_t fallback) {
+    const char * raw = std::getenv(name);
+    if (raw == nullptr || raw[0] == '\0') {
+        return fallback;
+    }
+    try {
+        return std::stoll(raw);
+    } catch (...) {
+        return fallback;
+    }
+}
+
+static bool verathos_vk_env_bool(const char * name, bool fallback) {
+    const char * raw = std::getenv(name);
+    if (raw == nullptr || raw[0] == '\0') {
+        return fallback;
+    }
+    return raw[0] == '1' || raw[0] == 't' || raw[0] == 'T' ||
+           raw[0] == 'y' || raw[0] == 'Y';
+}
+
+static int64_t verathos_vk_trace_max_ops() {
+    const char * per_capture = std::getenv("VERATHOS_GGML_TRACE_MAX_OPS_PER_CAPTURE");
+    if (per_capture != nullptr && per_capture[0] != '\0') {
+        return verathos_vk_env_i64("VERATHOS_GGML_TRACE_MAX_OPS_PER_CAPTURE", 64);
+    }
+    return verathos_vk_env_i64("VERATHOS_GGML_TRACE_MAX_OPS_TOTAL", 64);
+}
+
+static bool verathos_vk_read_capture_token(const char * path, std::string & token) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        return false;
+    }
+    std::ostringstream out;
+    out << in.rdbuf();
+    token = out.str();
+    while (!token.empty() &&
+           (token.back() == '\n' || token.back() == '\r' || token.back() == ' ' || token.back() == '\t')) {
+        token.pop_back();
+    }
+    if (token.empty()) {
+        token = "present";
+    } else if (token.size() > 4095) {
+        token.resize(4095);
+    }
+    return true;
+}
+
+static void verathos_vk_parse_selected_manifest_indexes(const std::string & token) {
+    verathos_vk_selected_manifest_indexes.clear();
+    const std::string marker = "selected=";
+    size_t pos = token.find(marker);
+    if (pos == std::string::npos) {
+        return;
+    }
+    pos += marker.size();
+    while (pos < token.size() && verathos_vk_selected_manifest_indexes.size() < 64) {
+        while (pos < token.size() && (token[pos] == ' ' || token[pos] == '\t' || token[pos] == ',')) {
+            ++pos;
+        }
+        if (pos >= token.size() || token[pos] < '0' || token[pos] > '9') {
+            break;
+        }
+        size_t end = pos;
+        while (end < token.size() && token[end] >= '0' && token[end] <= '9') {
+            ++end;
+        }
+        try {
+            verathos_vk_selected_manifest_indexes.push_back(std::stoll(token.substr(pos, end - pos)));
+        } catch (...) {
+            break;
+        }
+        pos = end;
+    }
+}
+
+static void verathos_vk_parse_selected_ops(const std::string & token) {
+    verathos_vk_selected_ops.clear();
+    const std::string marker = "selected_v3=";
+    size_t pos = token.find(marker);
+    if (pos == std::string::npos) {
+        return;
+    }
+    pos += marker.size();
+    while (pos < token.size() && verathos_vk_selected_ops.size() < 64) {
+        while (pos < token.size() && (token[pos] == ' ' || token[pos] == '\t' || token[pos] == ',')) {
+            ++pos;
+        }
+        if (pos >= token.size() || token[pos] < '0' || token[pos] > '9') {
+            break;
+        }
+        size_t end = pos;
+        while (end < token.size() && token[end] >= '0' && token[end] <= '9') {
+            ++end;
+        }
+        if (end >= token.size() || token[end] != ':') {
+            break;
+        }
+        int64_t graph_value = 0;
+        int64_t intra_value = 0;
+        try {
+            graph_value = std::stoll(token.substr(pos, end - pos));
+        } catch (...) {
+            break;
+        }
+        pos = end + 1;
+        end = pos;
+        while (end < token.size() && token[end] >= '0' && token[end] <= '9') {
+            ++end;
+        }
+        if (end == pos) {
+            break;
+        }
+        try {
+            intra_value = std::stoll(token.substr(pos, end - pos));
+        } catch (...) {
+            break;
+        }
+        verathos_vk_selected_ops.emplace_back(graph_value, intra_value);
+        pos = end;
+    }
+}
+
+static bool verathos_vk_should_dump_selected_op(int64_t graph_sequence, int64_t intra_index) {
+    for (const auto & item : verathos_vk_selected_ops) {
+        if (item.first == graph_sequence && item.second == intra_index) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool verathos_vk_should_dump_manifest_index(int64_t manifest_index) {
+    if (!verathos_vk_selected_manifest_indexes.empty()) {
+        for (int64_t selected : verathos_vk_selected_manifest_indexes) {
+            if (selected == manifest_index) {
+                return true;
+            }
+        }
+        return false;
+    }
+    const int64_t max_total = verathos_vk_trace_max_ops();
+    return max_total < 0 || verathos_vk_trace_sequence < max_total;
+}
+
+static void verathos_vk_refresh_capture_token(const char * enable_file) {
+    std::string token;
+    if (!verathos_vk_read_capture_token(enable_file, token)) {
+        token = "present";
+    }
+    if (token != verathos_vk_trace_capture_token) {
+        verathos_vk_trace_capture_token = token;
+        verathos_vk_trace_sequence = 0;
+        verathos_vk_manifest_sequence = 0;
+        verathos_vk_graph_sequence = 0;
+        verathos_vk_intra_graph_index = 0;
+        verathos_vk_graph_dim_valid_ops = 0;
+        verathos_vk_graph_written_rows = 0;
+        verathos_vk_graph_max_src1_rows = 0;
+        verathos_vk_parse_selected_manifest_indexes(token);
+        verathos_vk_parse_selected_ops(token);
+        if (verathos_vk_manifest_stream.is_open()) {
+            verathos_vk_manifest_stream.flush();
+            verathos_vk_manifest_stream.close();
+        }
+        verathos_vk_manifest_path.clear();
+    }
+}
+
+static bool verathos_vk_trace_enabled() {
+    const char * dir = verathos_vk_trace_dir();
+    if (dir == nullptr || dir[0] == '\0') {
+        return false;
+    }
+    const char * enable_file = std::getenv("VERATHOS_GGML_TRACE_ENABLE_FILE");
+    if (enable_file != nullptr && enable_file[0] != '\0') {
+#if defined(_WIN32)
+        if (_access(enable_file, 0) != 0) {
+#else
+        if (access(enable_file, F_OK) != 0) {
+#endif
+            return false;
+        }
+        verathos_vk_refresh_capture_token(enable_file);
+    }
+    return true;
+}
+
+static int64_t verathos_vk_unix_ns() {
+    using namespace std::chrono;
+    return duration_cast<nanoseconds>(system_clock::now().time_since_epoch()).count();
+}
+
+static void verathos_vk_trace_mkdir(const char * dir) {
+    if (dir == nullptr || dir[0] == '\0') {
+        return;
+    }
+#if defined(_WIN32)
+    _mkdir(dir);
+#else
+    mkdir(dir, 0755);
+#endif
+}
+
+static std::string verathos_vk_json_escape(const char * raw) {
+    std::ostringstream out;
+    for (const char * p = raw ? raw : ""; *p; ++p) {
+        switch (*p) {
+            case '\\': out << "\\\\"; break;
+            case '"': out << "\\\""; break;
+            case '\n': out << "\\n"; break;
+            case '\r': out << "\\r"; break;
+            case '\t': out << "\\t"; break;
+            default: out << *p; break;
+        }
+    }
+    return out.str();
+}
+
+static std::string verathos_vk_hex_escape(const char * raw) {
+    static const char * hex = "0123456789abcdef";
+    std::string out;
+    for (const unsigned char * p = reinterpret_cast<const unsigned char *>(raw ? raw : ""); *p; ++p) {
+        out.push_back(hex[*p >> 4]);
+        out.push_back(hex[*p & 0x0f]);
+    }
+    return out;
+}
+
+static std::string verathos_vk_compact_field(const char * raw) {
+    std::string out(raw ? raw : "");
+    for (char & ch : out) {
+        if (ch == '\t' || ch == '\n' || ch == '\r') {
+            ch = ' ';
+        }
+    }
+    return out;
+}
+
+static bool verathos_vk_manifest_v3() {
+    const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && std::string(raw) == "compact-raw-v3";
+}
+
+static bool verathos_vk_manifest_compact() {
+    const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "compact" ||
+        std::string(raw) == "compact-raw" ||
+        std::string(raw) == "compact-raw-v2" ||
+        std::string(raw) == "compact-raw-v3" ||
+        std::string(raw) == "raw" ||
+        std::string(raw) == "decode" ||
+        std::string(raw) == "decode-only");
+}
+
+static bool verathos_vk_manifest_compact_raw() {
+    const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "compact-raw" ||
+        std::string(raw) == "compact-raw-v2" ||
+        std::string(raw) == "compact-raw-v3" ||
+        std::string(raw) == "raw");
+}
+
+static bool verathos_vk_manifest_disabled() {
+    const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "none" ||
+        std::string(raw) == "off" ||
+        std::string(raw) == "0");
+}
+
+static bool verathos_vk_manifest_decode_only() {
+    const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "decode" ||
+        std::string(raw) == "decode-only");
+}
+
+static std::string verathos_vk_filename(const std::string & path) {
+    const size_t slash = path.find_last_of("/\\");
+    return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+static bool verathos_vk_ends_with(const std::string & value, const std::string & suffix) {
+    return value.size() >= suffix.size() &&
+        value.compare(value.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
+
+static bool verathos_vk_is_decode_candidate(
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * dst) {
+    const std::string tensor_name = src0 != nullptr ? src0->name : "";
+    const std::string src1_name = src1 != nullptr ? src1->name : "";
+    const std::string dst_name = dst != nullptr ? dst->name : "";
+    if (tensor_name == "output.weight" ||
+        tensor_name == "lm_head.weight" ||
+        verathos_vk_ends_with(tensor_name, ".lm_head.weight")) {
+        return true;
+    }
+    if (tensor_name.find("attn_output") != std::string::npos) {
+        return false;
+    }
+    return dst_name == "logits" ||
+        dst_name == "result_output" ||
+        (dst_name.find("result_output") != std::string::npos &&
+         (src1_name.find("result_norm") != std::string::npos ||
+          src1_name.find("final") != std::string::npos));
+}
+
+static std::string verathos_vk_manifest_suffix() {
+    std::string suffix;
+    for (char ch : verathos_vk_trace_capture_token) {
+        if (ch < '0' || ch > '9') {
+            break;
+        }
+        if (suffix.size() >= 64) {
+            break;
+        }
+        suffix.push_back(ch);
+    }
+    return suffix.empty() ? "" : "-" + suffix;
+}
+
+static bool verathos_vk_write_f32(const std::string & path, const std::vector<float> & values) {
+    std::ofstream out(path, std::ios::binary);
+    if (!out) {
+        return false;
+    }
+    out.write(reinterpret_cast<const char *>(values.data()), values.size() * sizeof(float));
+    return bool(out);
+}
+
+static bool verathos_vk_write_raw(const std::string & path, const std::vector<uint8_t> & values) {
+    std::ofstream out(path, std::ios::binary);
+    if (!out) {
+        return false;
+    }
+    out.write(reinterpret_cast<const char *>(values.data()), values.size());
+    return bool(out);
+}
+
+static std::ostream * verathos_vk_manifest_for_capture(const char * dir) {
+    if (verathos_vk_manifest_disabled()) {
+        return nullptr;
+    }
+    const std::string path = std::string(dir) + "/manifest" + verathos_vk_manifest_suffix() +
+        (verathos_vk_manifest_compact() ? ".vmanifest" : ".jsonl");
+    if (verathos_vk_manifest_path != path || !verathos_vk_manifest_stream.is_open()) {
+        if (verathos_vk_manifest_stream.is_open()) {
+            verathos_vk_manifest_stream.flush();
+            verathos_vk_manifest_stream.close();
+        }
+        verathos_vk_manifest_path = path;
+        verathos_vk_manifest_stream.open(path, std::ios::app);
+    }
+    if (!verathos_vk_manifest_stream) {
+        return nullptr;
+    }
+    return &verathos_vk_manifest_stream;
+}
+
+static void verathos_vk_write_manifest_entry(
+        const char * dir,
+        int64_t now_ns,
+        int64_t manifest_index,
+        const char * device_name,
+        bool proof_eligible,
+        int64_t graph_sequence,
+        int64_t intra_graph_index,
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * dst) {
+    if (verathos_vk_manifest_decode_only() && !verathos_vk_is_decode_candidate(src0, src1, dst)) {
+        return;
+    }
+    std::ostream * manifest_stream = verathos_vk_manifest_for_capture(dir);
+    if (manifest_stream == nullptr) {
+        return;
+    }
+    std::ostream & manifest = *manifest_stream;
+    if (verathos_vk_manifest_compact()) {
+        const bool raw_compact = verathos_vk_manifest_compact_raw();
+        const char * manifest_format = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+        const bool raw_compact_v3 = verathos_vk_manifest_v3();
+        const bool raw_compact_v2 = raw_compact_v3 ||
+            (manifest_format != nullptr && std::string(manifest_format) == "compact-raw-v2");
+        const std::string graph_id = std::string("vulkan-mul-mat-") + std::to_string(manifest_index);
+        if (raw_compact_v2) {
+            manifest << (raw_compact_v3
+                ? "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V3"
+                : "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V2");
+            manifest << "\t" << now_ns;
+            manifest << "\t" << manifest_index;
+            manifest << "\t" << verathos_vk_compact_field(src0->name);
+            manifest << "\t" << verathos_vk_compact_field(src1->name);
+            manifest << "\t" << verathos_vk_compact_field(dst->name);
+            manifest << "\t" << src0->ne[0] << "," << src0->ne[1] << "," << src0->ne[2] << "," << src0->ne[3];
+            manifest << "\t" << src1->ne[0] << "," << src1->ne[1] << "," << src1->ne[2] << "," << src1->ne[3];
+            manifest << "\t" << dst->ne[0] << "," << dst->ne[1] << "," << dst->ne[2] << "," << dst->ne[3];
+            manifest << "\t" << ggml_type_name((ggml_type) src0->type);
+            manifest << "\t" << ggml_type_name((ggml_type) src1->type);
+            manifest << "\t" << ggml_type_name((ggml_type) dst->type);
+            manifest << "\t" << "llama_cpp_vulkan";
+            manifest << "\t" << verathos_vk_compact_field(device_name);
+            manifest << "\t" << (proof_eligible ? "1" : "0");
+            if (raw_compact_v3) {
+                manifest << "\t" << graph_sequence << "\t" << intra_graph_index;
+            }
+            manifest << "\n";
+            manifest.flush();
+            return;
+        }
+        manifest << (raw_compact ? "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V1" : "VERATHOS_GGML_OP_MANIFEST_COMPACT_V1");
+        manifest << "\t" << now_ns;
+        manifest << "\t" << manifest_index;
+        manifest << "\t" << (raw_compact ? verathos_vk_compact_field(graph_id.c_str()) : verathos_vk_hex_escape(graph_id.c_str()));
+        manifest << "\t" << manifest_index;
+        manifest << "\t" << (raw_compact ? verathos_vk_compact_field(src0->name) : verathos_vk_hex_escape(src0->name));
+        manifest << "\t" << (raw_compact ? verathos_vk_compact_field(src0->name) : verathos_vk_hex_escape(src0->name));
+        manifest << "\t" << (raw_compact ? verathos_vk_compact_field(src1->name) : verathos_vk_hex_escape(src1->name));
+        manifest << "\t" << (raw_compact ? verathos_vk_compact_field(dst->name) : verathos_vk_hex_escape(dst->name));
+        manifest << "\t" << src0->ne[0] << "," << src0->ne[1] << "," << src0->ne[2] << "," << src0->ne[3];
+        manifest << "\t" << src1->ne[0] << "," << src1->ne[1] << "," << src1->ne[2] << "," << src1->ne[3];
+        manifest << "\t" << dst->ne[0] << "," << dst->ne[1] << "," << dst->ne[2] << "," << dst->ne[3];
+        manifest << "\t" << ggml_type_name((ggml_type) src0->type);
+        manifest << "\t" << ggml_type_name((ggml_type) src1->type);
+        manifest << "\t" << ggml_type_name((ggml_type) dst->type);
+        manifest << "\t" << (raw_compact ? verathos_vk_compact_field("llama_cpp_vulkan") : verathos_vk_hex_escape("llama_cpp_vulkan"));
+        manifest << "\t" << (raw_compact ? verathos_vk_compact_field(device_name) : verathos_vk_hex_escape(device_name));
+        manifest << "\t" << (proof_eligible ? "1" : "0") << "\n";
+        manifest.flush();
+        return;
+    }
+    manifest << "{\"version\":1";
+    manifest << ",\"created_unix_ns\":" << now_ns;
+    manifest << ",\"manifest_index\":" << manifest_index;
+    manifest << ",\"graph_id\":\"vulkan-mul-mat-" << manifest_index << "\"";
+    manifest << ",\"op_index\":" << manifest_index;
+    manifest << ",\"op_type\":\"GGML_OP_MUL_MAT\"";
+    manifest << ",\"tensor_name\":\"" << verathos_vk_json_escape(src0->name) << "\"";
+    manifest << ",\"src0_name\":\"" << verathos_vk_json_escape(src0->name) << "\"";
+    manifest << ",\"src1_name\":\"" << verathos_vk_json_escape(src1->name) << "\"";
+    manifest << ",\"dst_name\":\"" << verathos_vk_json_escape(dst->name) << "\"";
+    manifest << ",\"src0_shape\":[" << src0->ne[0] << "," << src0->ne[1] << "," << src0->ne[2] << "," << src0->ne[3] << "]";
+    manifest << ",\"src1_shape\":[" << src1->ne[0] << "," << src1->ne[1] << "," << src1->ne[2] << "," << src1->ne[3] << "]";
+    manifest << ",\"dst_shape\":[" << dst->ne[0] << "," << dst->ne[1] << "," << dst->ne[2] << "," << dst->ne[3] << "]";
+    manifest << ",\"source_types\":{\"src0\":\"" << ggml_type_name((ggml_type) src0->type)
+             << "\",\"src1\":\"" << ggml_type_name((ggml_type) src1->type)
+             << "\",\"dst\":\"" << ggml_type_name((ggml_type) dst->type) << "\"}";
+    manifest << ",\"backend\":\"llama_cpp_vulkan\"";
+    manifest << ",\"device\":\"" << verathos_vk_json_escape(device_name) << "\"";
+    manifest << ",\"proof_eligible\":" << (proof_eligible ? "true" : "false") << "}\n";
+    manifest.flush();
+}
+
+static bool verathos_vk_tensor_raw_to_host(const ggml_tensor * tensor, std::vector<uint8_t> & raw) {
+    if (tensor == nullptr || tensor->data == nullptr || tensor->buffer == nullptr) {
+        return false;
+    }
+    if (!ggml_is_contiguous(tensor)) {
+        return false;
+    }
+    const size_t nbytes = ggml_nbytes(tensor);
+    if (nbytes == 0) {
+        return false;
+    }
+    raw.resize(nbytes);
+    if (ggml_backend_buffer_is_vk(tensor->buffer)) {
+        ggml_backend_vk_buffer_context * buf_ctx = (ggml_backend_vk_buffer_context *)tensor->buffer->context;
+        vk_buffer & buffer_gpu = buf_ctx->dev_buffer;
+        ggml_vk_buffer_read(buffer_gpu, vk_tensor_offset(tensor) + tensor->view_offs, raw.data(), nbytes);
+        return true;
+    }
+    if (ggml_backend_buffer_is_host(tensor->buffer)) {
+        memcpy(raw.data(), tensor->data, nbytes);
+        return true;
+    }
+    return false;
+}
+
+static bool verathos_vk_raw_to_f32(
+        const ggml_tensor * tensor,
+        const std::vector<uint8_t> & raw,
+        std::vector<float> & out) {
+    const int64_t n = ggml_nelements(tensor);
+    if (n <= 0) {
+        return false;
+    }
+    out.resize(n);
+    if (tensor->type == GGML_TYPE_F32) {
+        if (raw.size() != sizeof(float) * (size_t) n) {
+            return false;
+        }
+        memcpy(out.data(), raw.data(), raw.size());
+        return true;
+    }
+    const ggml_type_traits * traits = ggml_get_type_traits((ggml_type) tensor->type);
+    if (traits == nullptr || traits->to_float == nullptr) {
+        return false;
+    }
+    traits->to_float(raw.data(), out.data(), n);
+    return true;
+}
