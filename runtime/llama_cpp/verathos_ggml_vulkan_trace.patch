+static void verathos_vk_try_dump_mul_mat_trace(ggml_backend_vk_context * ctx, const ggml_tensor * dst) {
+    if (!verathos_vk_trace_enabled()) {
+        return;
+    }
+    const char * dir = verathos_vk_trace_dir();
+    if (dir == nullptr || dir[0] == '\0' || ctx == nullptr || dst == nullptr || dst->op != GGML_OP_MUL_MAT) {
+        return;
+    }
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    if (src0 == nullptr || src1 == nullptr) {
+        return;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 ||
+        src1->ne[2] != 1 || src1->ne[3] != 1 ||
+        dst->ne[2]  != 1 || dst->ne[3]  != 1) {
+        return;
+    }
+    if (src0->ne[0] != src1->ne[0] ||
+        dst->ne[0]  != src0->ne[1] ||
+        dst->ne[1]  != src1->ne[1]) {
+        return;
+    }
+
+    // Intra-graph index counts every dim-valid MUL_MAT regardless of size
+    // eligibility, so it stays stable across batch row counts.
+    const int64_t intra_graph_index = verathos_vk_intra_graph_index++;
+    verathos_vk_graph_dim_valid_ops++;
+    if (src1->ne[1] > verathos_vk_graph_max_src1_rows) {
+        verathos_vk_graph_max_src1_rows = src1->ne[1];
+    }
+
+    verathos_vk_trace_mkdir(dir);
+    const int64_t now_ns = verathos_vk_unix_ns();
+    const int64_t manifest_index = ++verathos_vk_manifest_sequence;
+    const int64_t total_elems = ggml_nelements(src0) + ggml_nelements(src1) + ggml_nelements(dst);
+    const int64_t max_elems = verathos_vk_env_i64("VERATHOS_GGML_TRACE_MAX_ELEMS", 262144);
+    const bool proof_eligible =
+        verathos_vk_is_decode_candidate(src0, src1, dst) ||
+        !(max_elems > 0 && total_elems > max_elems);
+    if (!proof_eligible) {
+        return;
+    }
+    verathos_vk_write_manifest_entry(
+        dir, now_ns, manifest_index, ctx->name.c_str(), proof_eligible,
+        verathos_vk_graph_sequence, intra_graph_index, src0, src1, dst);
+    verathos_vk_graph_written_rows++;
+    const bool selected_op_dump = !verathos_vk_selected_ops.empty() &&
+        verathos_vk_should_dump_selected_op(verathos_vk_graph_sequence, intra_graph_index);
+    if (!selected_op_dump && !verathos_vk_selected_ops.empty()) {
+        return;
+    }
+    if (!selected_op_dump && !verathos_vk_should_dump_manifest_index(manifest_index)) {
+        return;
+    }
+    const int64_t sequence = ++verathos_vk_trace_sequence;
+
+    const bool skip_src0_dump = verathos_vk_env_bool("VERATHOS_GGML_TRACE_SKIP_SRC0_DUMP", false);
+    std::vector<uint8_t> src0_raw;
+    std::vector<uint8_t> src1_raw;
+    std::vector<uint8_t> dst_raw;
+    if ((!skip_src0_dump && !verathos_vk_tensor_raw_to_host(src0, src0_raw)) ||
+        !verathos_vk_tensor_raw_to_host(src1, src1_raw) ||
+        !verathos_vk_tensor_raw_to_host(dst, dst_raw)) {
+        return;
+    }
+
+    std::vector<float> src0_f32;
+    std::vector<float> src1_f32;
+    std::vector<float> dst_f32;
+    if ((!skip_src0_dump && !verathos_vk_raw_to_f32(src0, src0_raw, src0_f32)) ||
+        !verathos_vk_raw_to_f32(src1, src1_raw, src1_f32) ||
+        !verathos_vk_raw_to_f32(dst, dst_raw, dst_f32)) {
+        return;
+    }
+
+    std::ostringstream prefix;
+    prefix << dir << "/trace-" << now_ns << "-vulkan-op" << manifest_index;
+    const std::string src0_path = prefix.str() + "-src0.f32";
+    const std::string src0_raw_path = prefix.str() + "-src0.raw";
+    const std::string src1_path = prefix.str() + "-src1.f32";
+    const std::string dst_path  = prefix.str() + "-dst.f32";
+    const std::string json_path = prefix.str() + ".json";
+    if ((!skip_src0_dump && !verathos_vk_write_f32(src0_path, src0_f32)) ||
+        (!skip_src0_dump && !verathos_vk_write_raw(src0_raw_path, src0_raw)) ||
+        !verathos_vk_write_f32(src1_path, src1_f32) ||
+        !verathos_vk_write_f32(dst_path, dst_f32)) {
+        return;
+    }
+
+    std::ofstream meta(json_path);
+    if (!meta) {
+        return;
+    }
+    meta << "{\n";
+    meta << "  \"version\": 1,\n";
+    meta << "  \"created_unix_ns\": " << now_ns << ",\n";
+    meta << "  \"manifest_index\": " << manifest_index << ",\n";
+    meta << "  \"graph_seq\": " << verathos_vk_graph_sequence << ",\n";
+    meta << "  \"intra_graph_index\": " << intra_graph_index << ",\n";
+    meta << "  \"graph_id\": \"vulkan-mul-mat-" << manifest_index << "\",\n";
+    meta << "  \"op_index\": " << manifest_index << ",\n";
+    meta << "  \"op_type\": \"GGML_OP_MUL_MAT\",\n";
+    meta << "  \"tensor_name\": \"" << verathos_vk_json_escape(src0->name) << "\",\n";
+    meta << "  \"src0_name\": \"" << verathos_vk_json_escape(src0->name) << "\",\n";
+    meta << "  \"src1_name\": \"" << verathos_vk_json_escape(src1->name) << "\",\n";
+    meta << "  \"dst_name\": \"" << verathos_vk_json_escape(dst->name) << "\",\n";
+    meta << "  \"src0_shape\": [" << src0->ne[0] << "," << src0->ne[1] << "," << src0->ne[2] << "," << src0->ne[3] << "],\n";
+    meta << "  \"src1_shape\": [" << src1->ne[0] << "," << src1->ne[1] << "," << src1->ne[2] << "," << src1->ne[3] << "],\n";
+    meta << "  \"dst_shape\": [" << dst->ne[0] << "," << dst->ne[1] << "," << dst->ne[2] << "," << dst->ne[3] << "],\n";
+    if (!skip_src0_dump) {
+        meta << "  \"src0_f32\": \"" << verathos_vk_filename(src0_path) << "\",\n";
+        meta << "  \"src0_raw\": \"" << verathos_vk_filename(src0_raw_path) << "\",\n";
+    }
+    meta << "  \"src0_raw_type\": \"" << ggml_type_name((ggml_type) src0->type) << "\",\n";
+    meta << "  \"src1_f32\": \"" << verathos_vk_filename(src1_path) << "\",\n";
+    meta << "  \"dst_f32\": \"" << verathos_vk_filename(dst_path) << "\",\n";
+    meta << "  \"source_types\": {\"src0\": \"" << ggml_type_name((ggml_type) src0->type)
+         << "\", \"src1\": \"" << ggml_type_name((ggml_type) src1->type)
+         << "\", \"dst\": \"" << ggml_type_name((ggml_type) dst->type) << "\"},\n";
+    meta << "  \"backend\": \"llama_cpp_vulkan\",\n";
+    meta << "  \"device\": \"" << verathos_vk_json_escape(ctx->name.c_str()) << "\"\n";
+    meta << "}\n";
+}
