+static void verathos_vk_trace_begin_graph() {
+    if (!verathos_vk_trace_enabled()) {
+        return;
+    }
+    verathos_vk_graph_sequence++;
+    verathos_vk_intra_graph_index = 0;
+    verathos_vk_graph_dim_valid_ops = 0;
+    verathos_vk_graph_written_rows = 0;
+    verathos_vk_graph_max_src1_rows = 0;
+}
+
+static void verathos_vk_trace_end_graph(const char * device_name) {
+    if (!verathos_vk_manifest_v3() || verathos_vk_graph_dim_valid_ops <= 0) {
+        return;
+    }
+    const char * dir = verathos_vk_trace_dir();
+    if (dir == nullptr || dir[0] == '\0') {
+        return;
+    }
+    std::ostream * manifest_stream = verathos_vk_manifest_for_capture(dir);
+    if (manifest_stream == nullptr) {
+        return;
+    }
+    std::ostream & manifest = *manifest_stream;
+    manifest << "VERATHOS_GGML_GRAPH_V1";
+    manifest << "\t" << verathos_vk_unix_ns();
+    manifest << "\t" << verathos_vk_graph_sequence;
+    manifest << "\t" << verathos_vk_graph_dim_valid_ops;
+    manifest << "\t" << verathos_vk_graph_written_rows;
+    manifest << "\t" << verathos_vk_graph_max_src1_rows;
+    manifest << "\tllama_cpp_vulkan\t" << verathos_vk_compact_field(device_name);
+    manifest << "\n";
+    manifest.flush();
+}
