 };
 
 ggml_metal_encoder_t ggml_metal_encoder_init(ggml_metal_cmd_buf_t cmd_buf_raw, bool concurrent) {
     ggml_metal_encoder_t res = calloc(1, sizeof(struct ggml_metal_encoder));
 
     id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>) cmd_buf_raw;
+    res->concurrent = concurrent;
 
     if (concurrent) {
         res->obj = [cmd_buf computeCommandEncoderWithDispatchType: MTLDispatchTypeConcurrent];
@@ -517,6 +519,63 @@ void ggml_metal_encoder_end_encoding(ggml_metal_encoder_t encoder) {
     [encoder->obj endEncoding];
 }
 
+ggml_metal_trace_snapshot_t ggml_metal_encoder_snapshot_buffer(
+        ggml_metal_encoder_t encoder,
+        ggml_metal_cmd_buf_t cmd_buf_raw,
+        struct ggml_metal_buffer_id src,
+        size_t size) {
+    if (encoder == NULL || encoder->obj == nil || cmd_buf_raw == NULL || src.metal == NULL || size == 0) {
+        return NULL;
+    }
+
+    id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>) cmd_buf_raw;
+    id<MTLBuffer> buf_src = (id<MTLBuffer>) src.metal;
+    id<MTLDevice> device = [buf_src device];
+    id<MTLBuffer> buf_dst = [device newBufferWithLength:size options:MTLResourceStorageModeShared];
+    if (buf_dst == nil) {
+        return NULL;
+    }
+
+    [encoder->obj memoryBarrierWithScope:MTLBarrierScopeBuffers];
+    [encoder->obj endEncoding];
+    [encoder->obj release];
+
+    id<MTLBlitCommandEncoder> blit = [cmd_buf blitCommandEncoder];
+    [blit copyFromBuffer:buf_src
+            sourceOffset:src.offs
+                toBuffer:buf_dst
+       destinationOffset:0
+                    size:size];
+    [blit endEncoding];
+
+    if (encoder->concurrent) {
+        encoder->obj = [cmd_buf computeCommandEncoderWithDispatchType:MTLDispatchTypeConcurrent];
+    } else {
+        encoder->obj = [cmd_buf computeCommandEncoder];
+    }
+    [encoder->obj retain];
+
+    return (ggml_metal_trace_snapshot_t) buf_dst;
+}
+
+bool ggml_metal_trace_snapshot_read(ggml_metal_trace_snapshot_t snapshot, void * data, size_t size) {
+    if (snapshot == NULL || data == NULL || size == 0) {
+        return false;
+    }
+    id<MTLBuffer> buffer = (id<MTLBuffer>) snapshot;
+    if ([buffer length] < size || [buffer contents] == NULL) {
+        return false;
+    }
+    memcpy(data, [buffer contents], size);
+    return true;
+}
+
+void ggml_metal_trace_snapshot_free(ggml_metal_trace_snapshot_t snapshot) {
+    if (snapshot != NULL) {
+        [(id<MTLBuffer>) snapshot release];
+    }
+}
