+static bool verathos_metal_mul_mat_candidate(const ggml_tensor * dst) {
+    if (dst == nullptr || dst->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    if (src0 == nullptr || src1 == nullptr) {
+        return false;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 ||
+        src1->ne[2] != 1 || src1->ne[3] != 1 ||
+        dst->ne[2]  != 1 || dst->ne[3]  != 1) {
+        return false;
+    }
+    return src0->ne[0] == src1->ne[0] &&
+        dst->ne[0] == src0->ne[1] &&
+        dst->ne[1] == src1->ne[1];
+}
+
+static bool verathos_metal_manifest_index_selected(int64_t manifest_index) {
+    for (int64_t selected : verathos_metal_selected_manifest_indexes) {
+        if (selected == manifest_index) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void verathos_metal_release_tensor_snapshot(verathos_metal_tensor_snapshot & snapshot) {
+    if (snapshot.metal != nullptr) {
+        ggml_metal_trace_snapshot_free(snapshot.metal);
+        snapshot.metal = nullptr;
+    }
+    snapshot.host_raw.clear();
+    snapshot.nbytes = 0;
+    snapshot.tensor = nullptr;
+}
+
+static void verathos_metal_release_snapshot_record(verathos_metal_snapshot_record & record) {
+    verathos_metal_release_tensor_snapshot(record.src0_snapshot);
+    verathos_metal_release_tensor_snapshot(record.src1_snapshot);
+    verathos_metal_release_tensor_snapshot(record.dst_snapshot);
+}
+
+static void verathos_metal_clear_snapshot_state() {
+    std::lock_guard<std::mutex> lock(verathos_metal_snapshot_mutex);
+    for (verathos_metal_snapshot_record & record : verathos_metal_snapshot_records) {
+        verathos_metal_release_snapshot_record(record);
+    }
+    verathos_metal_snapshot_records.clear();
+    verathos_metal_planned_snapshots.clear();
+}
+
+static bool verathos_metal_capture_tensor_snapshot(
+        ggml_metal_encoder_t encoder,
+        ggml_metal_cmd_buf_t cmd_buf,
+        const ggml_tensor * tensor,
+        verathos_metal_tensor_snapshot & snapshot) {
+    if (tensor == nullptr || tensor->data == nullptr || tensor->buffer == nullptr || !ggml_is_contiguous(tensor)) {
+        return false;
+    }
+    const size_t nbytes = ggml_nbytes(tensor);
+    if (nbytes == 0) {
+        return false;
+    }
+    snapshot.tensor = tensor;
+    snapshot.nbytes = nbytes;
+
+    ggml_backend_buffer_t buffer = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    if (buffer == nullptr) {
+        return false;
+    }
+    if (ggml_backend_buffer_is_metal(buffer)) {
+        struct ggml_metal_buffer_id bid = ggml_metal_buffer_get_id(
+            (ggml_metal_buffer_t) buffer->context, tensor);
+        snapshot.metal = ggml_metal_encoder_snapshot_buffer(encoder, cmd_buf, bid, nbytes);
+        return snapshot.metal != nullptr;
+    }
+    if (ggml_backend_buffer_is_host(buffer)) {
+        snapshot.host_raw.resize(nbytes);
+        memcpy(snapshot.host_raw.data(), tensor->data, nbytes);
+        return true;
+    }
+    return false;
+}
+
+static bool verathos_metal_snapshot_raw(
+        verathos_metal_tensor_snapshot & snapshot,
+        std::vector<uint8_t> & raw) {
+    raw.clear();
+    if (snapshot.tensor == nullptr || snapshot.nbytes == 0) {
+        return false;
+    }
+    raw.resize(snapshot.nbytes);
+    if (snapshot.metal != nullptr) {
+        const bool ok = ggml_metal_trace_snapshot_read(snapshot.metal, raw.data(), snapshot.nbytes);
+        ggml_metal_trace_snapshot_free(snapshot.metal);
+        snapshot.metal = nullptr;
+        return ok;
+    }
+    if (snapshot.host_raw.size() == snapshot.nbytes) {
+        memcpy(raw.data(), snapshot.host_raw.data(), snapshot.nbytes);
+        return true;
+    }
+    return false;
+}
+
+static void verathos_metal_trace_after_encode(
+        void * user_data,
+        ggml_metal_encoder_t encoder,
+        ggml_metal_cmd_buf_t cmd_buf,
+        int graph_node_index,
+        const ggml_tensor * dst) {
+    GGML_UNUSED(user_data);
+    if (!verathos_metal_mul_mat_candidate(dst)) {
+        return;
+    }
+
+    verathos_metal_planned_snapshot planned;
+    bool should_capture = false;
+    {
+        std::lock_guard<std::mutex> lock(verathos_metal_snapshot_mutex);
+        for (auto it = verathos_metal_planned_snapshots.begin(); it != verathos_metal_planned_snapshots.end(); ++it) {
+            if (it->graph_node_index == graph_node_index) {
+                planned = *it;
+                verathos_metal_planned_snapshots.erase(it);
+                should_capture = true;
+                break;
+            }
+        }
+    }
+    if (!should_capture) {
+        return;
+    }
+
+    verathos_metal_snapshot_record record;
+    record.created_unix_ns = planned.created_unix_ns;
+    record.manifest_index = planned.manifest_index;
+    record.graph_seq = planned.graph_seq;
+    record.intra_graph_index = planned.intra_graph_index;
+    record.src0 = dst->src[0];
+    record.src1 = dst->src[1];
+    record.dst = dst;
+    record.skip_src0_dump = verathos_metal_env_bool("VERATHOS_GGML_TRACE_SKIP_SRC0_DUMP", false);
+
+    const bool ok =
+        (record.skip_src0_dump ||
+         verathos_metal_capture_tensor_snapshot(encoder, cmd_buf, record.src0, record.src0_snapshot)) &&
+        verathos_metal_capture_tensor_snapshot(encoder, cmd_buf, record.src1, record.src1_snapshot) &&
+        verathos_metal_capture_tensor_snapshot(encoder, cmd_buf, record.dst, record.dst_snapshot);
+    if (!ok) {
+        verathos_metal_release_snapshot_record(record);
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(verathos_metal_snapshot_mutex);
+    verathos_metal_snapshot_records.push_back(std::move(record));
+}
+
+static bool verathos_metal_plan_graph_trace(ggml_metal_t ctx, const ggml_cgraph * cgraph) {
+    verathos_metal_clear_snapshot_state();
+    if (ctx == nullptr || cgraph == nullptr || !verathos_metal_trace_enabled()) {
+        if (ctx != nullptr) {
+            ggml_metal_set_trace_callback(ctx, nullptr, nullptr);
+        }
+        return false;
+    }
+    const char * dir = verathos_metal_trace_dir();
+    if (dir == nullptr || dir[0] == '\0') {
+        ggml_metal_set_trace_callback(ctx, nullptr, nullptr);
+        return false;
+    }
+    verathos_metal_trace_mkdir(dir);
+
+    verathos_metal_graph_sequence++;
+    verathos_metal_intra_graph_index = 0;
+    verathos_metal_graph_dim_valid_ops = 0;
+    verathos_metal_graph_written_rows = 0;
+    verathos_metal_graph_max_src1_rows = 0;
+
+    std::vector<verathos_metal_planned_snapshot> planned;
+    const int64_t max_elems = verathos_metal_env_i64("VERATHOS_GGML_TRACE_MAX_ELEMS", 262144);
+    const int64_t max_snapshots = verathos_metal_trace_max_ops();
+    int64_t planned_snapshot_count = 0;
+
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * dst = cgraph->nodes[i];
+        if (!verathos_metal_mul_mat_candidate(dst)) {
+            continue;
+        }
+        const ggml_tensor * src0 = dst->src[0];
+        const ggml_tensor * src1 = dst->src[1];
+        // Intra-graph index counts every dim-valid MUL_MAT regardless of
+        // size eligibility, so it stays stable across batch row counts.
+        const int64_t intra_graph_index = verathos_metal_intra_graph_index++;
+        verathos_metal_graph_dim_valid_ops++;
+        if (src1->ne[1] > verathos_metal_graph_max_src1_rows) {
+            verathos_metal_graph_max_src1_rows = src1->ne[1];
+        }
+        const int64_t total_elems = ggml_nelements(src0) + ggml_nelements(src1) + ggml_nelements(dst);
+        const bool proof_eligible =
+            verathos_metal_is_decode_candidate(src0, src1, dst) ||
+            !(max_elems > 0 && total_elems > max_elems);
+        if (!proof_eligible) {
+            continue;
+        }
+
+        const int64_t now_ns = verathos_metal_unix_ns();
+        const int64_t manifest_index = ++verathos_metal_manifest_sequence;
+        verathos_metal_write_manifest_entry(
+            dir, now_ns, manifest_index, ggml_metal_get_name(ctx), true,
+            verathos_metal_graph_sequence, intra_graph_index, src0, src1, dst);
+        verathos_metal_graph_written_rows++;
+
+        bool capture = false;
+        if (!verathos_metal_selected_ops.empty()) {
+            capture = verathos_metal_should_dump_selected_op(
+                verathos_metal_graph_sequence, intra_graph_index);
+        } else if (!verathos_metal_selected_manifest_indexes.empty()) {
+            capture = verathos_metal_manifest_index_selected(manifest_index);
+        } else if (max_snapshots < 0 || planned_snapshot_count < max_snapshots) {
+            capture = true;
+        }
+        if (!capture) {
+            continue;
+        }
+        ++planned_snapshot_count;
+        planned.push_back({
+            /* .graph_node_index  = */ i,
+            /* .created_unix_ns   = */ now_ns,
+            /* .manifest_index    = */ manifest_index,
+            /* .graph_seq         = */ verathos_metal_graph_sequence,
+            /* .intra_graph_index = */ intra_graph_index,
+        });
+    }
+    verathos_metal_write_graph_marker(ggml_metal_get_name(ctx));
+    if (verathos_metal_manifest_stream.is_open()) {
+        verathos_metal_flush_manifest_buffer();
+        verathos_metal_manifest_stream.flush();
+    } else {
+        verathos_metal_flush_manifest_buffer();
+    }
+
+    const bool enabled = !planned.empty();
+    {
