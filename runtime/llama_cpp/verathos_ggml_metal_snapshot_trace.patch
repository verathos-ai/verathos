+static void verathos_metal_flush_snapshots(ggml_metal_t ctx) {
+    std::vector<verathos_metal_snapshot_record> records;
+    {
+        std::lock_guard<std::mutex> lock(verathos_metal_snapshot_mutex);
+        if (verathos_metal_snapshot_records.empty()) {
+            return;
+        }
+    }
+    ggml_metal_synchronize(ctx);
+    {
+        std::lock_guard<std::mutex> lock(verathos_metal_snapshot_mutex);
+        records.swap(verathos_metal_snapshot_records);
+    }
+
+    const char * dir = verathos_metal_trace_dir();
+    if (dir == nullptr || dir[0] == '\0') {
+        for (verathos_metal_snapshot_record & record : records) {
+            verathos_metal_release_snapshot_record(record);
+        }
+        return;
+    }
+
+    for (verathos_metal_snapshot_record & record : records) {
+        std::vector<uint8_t> src0_raw;
+        std::vector<uint8_t> src1_raw;
+        std::vector<uint8_t> dst_raw;
+        if ((!record.skip_src0_dump &&
+             !verathos_metal_snapshot_raw(record.src0_snapshot, src0_raw)) ||
+            !verathos_metal_snapshot_raw(record.src1_snapshot, src1_raw) ||
+            !verathos_metal_snapshot_raw(record.dst_snapshot, dst_raw)) {
+            verathos_metal_release_snapshot_record(record);
+            continue;
+        }
+
+        std::vector<float> src0_f32;
+        std::vector<float> src1_f32;
+        std::vector<float> dst_f32;
+        if ((!record.skip_src0_dump &&
+             !verathos_metal_raw_to_f32(record.src0, src0_raw, src0_f32)) ||
+            !verathos_metal_raw_to_f32(record.src1, src1_raw, src1_f32) ||
+            !verathos_metal_raw_to_f32(record.dst, dst_raw, dst_f32)) {
+            verathos_metal_release_snapshot_record(record);
+            continue;
+        }
+
+        ++verathos_metal_trace_sequence;
+        std::ostringstream prefix;
+        prefix << dir << "/trace-" << record.created_unix_ns << "-metal-op" << record.manifest_index;
+        const std::string src0_path = prefix.str() + "-src0.f32";
+        const std::string src0_raw_path = prefix.str() + "-src0.raw";
+        const std::string src1_path = prefix.str() + "-src1.f32";
+        const std::string dst_path  = prefix.str() + "-dst.f32";
+        const std::string json_path = prefix.str() + ".json";
+        if ((!record.skip_src0_dump && !verathos_metal_write_f32(src0_path, src0_f32)) ||
+            (!record.skip_src0_dump && !verathos_metal_write_raw(src0_raw_path, src0_raw)) ||
+            !verathos_metal_write_f32(src1_path, src1_f32) ||
+            !verathos_metal_write_f32(dst_path, dst_f32)) {
+            verathos_metal_release_snapshot_record(record);
+            continue;
+        }
+
+        std::ofstream meta(json_path);
+        if (!meta) {
+            verathos_metal_release_snapshot_record(record);
+            continue;
+        }
+        meta << "{\n";
+        meta << "  \"version\": 1,\n";
+        meta << "  \"created_unix_ns\": " << record.created_unix_ns << ",\n";
+        meta << "  \"manifest_index\": " << record.manifest_index << ",\n";
+        meta << "  \"graph_seq\": " << record.graph_seq << ",\n";
+        meta << "  \"intra_graph_index\": " << record.intra_graph_index << ",\n";
+        meta << "  \"graph_id\": \"metal-mul-mat-" << record.manifest_index << "\",\n";
+        meta << "  \"op_index\": " << record.manifest_index << ",\n";
+        meta << "  \"op_type\": \"GGML_OP_MUL_MAT\",\n";
+        meta << "  \"tensor_name\": \"" << verathos_metal_json_escape(record.src0->name) << "\",\n";
+        meta << "  \"src0_name\": \"" << verathos_metal_json_escape(record.src0->name) << "\",\n";
+        meta << "  \"src1_name\": \"" << verathos_metal_json_escape(record.src1->name) << "\",\n";
+        meta << "  \"dst_name\": \"" << verathos_metal_json_escape(record.dst->name) << "\",\n";
+        meta << "  \"src0_shape\": [" << record.src0->ne[0] << "," << record.src0->ne[1] << "," << record.src0->ne[2] << "," << record.src0->ne[3] << "],\n";
+        meta << "  \"src1_shape\": [" << record.src1->ne[0] << "," << record.src1->ne[1] << "," << record.src1->ne[2] << "," << record.src1->ne[3] << "],\n";
+        meta << "  \"dst_shape\": [" << record.dst->ne[0] << "," << record.dst->ne[1] << "," << record.dst->ne[2] << "," << record.dst->ne[3] << "],\n";
+        if (!record.skip_src0_dump) {
+            meta << "  \"src0_f32\": \"" << verathos_metal_filename(src0_path) << "\",\n";
+            meta << "  \"src0_raw\": \"" << verathos_metal_filename(src0_raw_path) << "\",\n";
+        }
+        meta << "  \"src0_raw_type\": \"" << ggml_type_name((ggml_type) record.src0->type) << "\",\n";
+        meta << "  \"src1_f32\": \"" << verathos_metal_filename(src1_path) << "\",\n";
+        meta << "  \"dst_f32\": \"" << verathos_metal_filename(dst_path) << "\",\n";
+        meta << "  \"source_types\": {\"src0\": \"" << ggml_type_name((ggml_type) record.src0->type)
+             << "\", \"src1\": \"" << ggml_type_name((ggml_type) record.src1->type)
+             << "\", \"dst\": \"" << ggml_type_name((ggml_type) record.dst->type) << "\"},\n";
+        meta << "  \"backend\": \"llama_cpp_metal\",\n";
+        meta << "  \"device\": \"" << verathos_metal_json_escape(ggml_metal_get_name(ctx)) << "\"\n";
+        meta << "}\n";
+        verathos_metal_release_snapshot_record(record);
+    }
+}
