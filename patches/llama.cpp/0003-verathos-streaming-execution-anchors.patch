diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 1286cd847..87bb2b2c8 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -126,6 +126,312 @@ static thread_local bool verathos_cuda_in_graph_capture = false;
 static int64_t verathos_cuda_graph_max_src1_rows = 0;
 static std::vector<std::pair<int64_t, int64_t>> verathos_cuda_selected_ops;
 
+// ---------------------------------------------------------------------------
+// Streaming prefill execution anchors (verathos-anchor.h primitives).
+//
+// For ops whose weight name matches VERATHOS_GGML_ANCHOR_TENSORS (comma-
+// separated substrings; unset = disabled), every eager-hook execution
+// appends one 32-byte leaf per activation row (src1 side = input rows,
+// dst side = output rows) to a per-stage leaf-stream file and an O(log n)
+// Merkle frontier. Decode under CUDA-graph replay runs no hooks, so the
+// anchor covers the eager (prefill) rows; the Python side binds row counts
+// to the batch records and fails closed on any disagreement between the
+// leaf stream and the summary root.
+// ---------------------------------------------------------------------------
+#include "../verathos-anchor.h"
+#include <map>
+
+// Defined later in this translation unit; the anchor helpers below need
+// them and the anchor state must sit next to the other capture statics.
+static std::string verathos_cuda_json_escape(const char * raw);
+static std::string verathos_cuda_manifest_suffix();
+static int64_t verathos_cuda_unix_ns();
+
+struct verathos_cuda_anchor_stage {
+    verathos_anchor_frontier frontier;
+    std::ofstream            stream;
+    std::ofstream            rows_stream;
+    int64_t                  row_width  = 0;
+    int64_t                  rows       = 0;
+};
+static std::map<std::string, verathos_cuda_anchor_stage> verathos_cuda_anchor_stages;
+// Set on row append, cleared on a successful summary write. Decode runs one
+// graph per token and appends no anchor rows (the eager hook is bypassed
+// under graph capture), so without this gate every generated token pays a
+// summary rewrite (flush + temp file + rename): a fixed per-token cost that
+// dominated the measured anchor overhead.
+static bool verathos_cuda_anchor_dirty = false;
+// Bounded selected-row dump: the audit re-serve arms one op, so a single
+// global row list applies to every anchored stage (src1 and dst append the
+// same ne1 rows per execution). Row indexes are global per-stage stream
+// positions; the raw bytes written are the exact bytes hashed into the
+// matching leaf, so openings verify against the committed stream.
+static std::vector<int64_t> verathos_cuda_anchor_selected_rows;
+
+static void verathos_cuda_parse_anchor_rows(const std::string & token) {
+    verathos_cuda_anchor_selected_rows.clear();
+    const std::string marker = "anchor_rows=";
+    size_t pos = token.find(marker);
+    if (pos == std::string::npos) {
+        return;
+    }
+    pos += marker.size();
+    while (pos < token.size() && verathos_cuda_anchor_selected_rows.size() < 64) {
+        while (pos < token.size() && (token[pos] == ' ' || token[pos] == '\t' || token[pos] == ',')) {
+            ++pos;
+        }
+        if (pos >= token.size() || token[pos] < '0' || token[pos] > '9') {
+            break;
+        }
+        size_t end = pos;
+        while (end < token.size() && token[end] >= '0' && token[end] <= '9') {
+            ++end;
+        }
+        try {
+            verathos_cuda_anchor_selected_rows.push_back(std::stoll(token.substr(pos, end - pos)));
+        } catch (...) {
+            break;
+        }
+        pos = end;
+    }
+}
+
+static bool verathos_cuda_anchor_row_selected(int64_t index) {
+    for (const int64_t item : verathos_cuda_anchor_selected_rows) {
+        if (item == index) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Which tensors anchor, armed PER REQUEST through the capture token. The
+// env var below is read into a function-local static and can therefore
+// never change after the first call, so it cannot express "anchor this
+// op for this audit"; only the token can. With neither set, anchoring is
+// off and organic serves pay exactly nothing.
+static std::vector<std::string> verathos_cuda_anchor_token_filters;
+
+static void verathos_cuda_parse_anchor_tensors(const std::string & token) {
+    verathos_cuda_anchor_token_filters.clear();
+    const std::string marker = "anchor_tensors=";
+    size_t pos = token.find(marker);
+    if (pos == std::string::npos) {
+        return;
+    }
+    pos += marker.size();
+    while (pos < token.size() && verathos_cuda_anchor_token_filters.size() < 64) {
+        size_t end = pos;
+        while (end < token.size() && token[end] != ',' && token[end] != '|') {
+            ++end;
+        }
+        const std::string item = token.substr(pos, end - pos);
+        if (!item.empty()) {
+            verathos_cuda_anchor_token_filters.push_back(item);
+        }
+        if (end >= token.size() || token[end] == '|') {
+            break;
+        }
+        pos = end + 1;
+    }
+}
+
+static const std::vector<std::string> & verathos_cuda_anchor_filters() {
+    static const std::vector<std::string> filters = [] {
+        std::vector<std::string> out;
+        const char * raw = std::getenv("VERATHOS_GGML_ANCHOR_TENSORS");
+        if (raw == nullptr || raw[0] == '\0') {
+            return out;
+        }
+        std::string value(raw);
+        size_t start = 0;
+        while (start <= value.size()) {
+            size_t end = value.find(',', start);
+            if (end == std::string::npos) {
+                end = value.size();
+            }
+            const std::string item = value.substr(start, end - start);
+            if (!item.empty()) {
+                out.push_back(item);
+            }
+            if (end == value.size()) {
+                break;
+            }
+            start = end + 1;
+        }
+        return out;
+    }();
+    return filters;
+}
+
+// Token-armed filters win; the env var stays as a bench-only override so
+// microbenchmarks can anchor without driving a full audit.
+static const std::vector<std::string> & verathos_cuda_anchor_active_filters() {
+    return verathos_cuda_anchor_token_filters.empty()
+        ? verathos_cuda_anchor_filters()
+        : verathos_cuda_anchor_token_filters;
+}
+
+static bool verathos_cuda_anchor_matches(const char * name) {
+    if (name == nullptr || name[0] == '\0') {
+        return false;
+    }
+    for (const auto & filter : verathos_cuda_anchor_active_filters()) {
+        if (strstr(name, filter.c_str()) != nullptr) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static std::string verathos_cuda_anchor_file_component(const std::string & stage) {
+    std::string out;
+    out.reserve(stage.size());
+    for (const char c : stage) {
+        const bool safe = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                          (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
+        out += safe ? c : '_';
+    }
+    return out;
+}
+
+static void verathos_cuda_anchor_reset() {
+    for (auto & item : verathos_cuda_anchor_stages) {
+        if (item.second.stream.is_open()) {
+            item.second.stream.close();
+        }
+        if (item.second.rows_stream.is_open()) {
+            item.second.rows_stream.close();
+        }
+    }
+    verathos_cuda_anchor_stages.clear();
+    verathos_cuda_anchor_dirty = false;
+}
+
+// Overwrites the per-capture anchor summary atomically (temp + rename) so a
+// reader never observes a partial JSON row. Called at graph end, which keeps
+// the summary current without per-row cost.
+static void verathos_cuda_anchor_write_summary(const char * dir) {
+    if (verathos_cuda_anchor_stages.empty() || !verathos_cuda_anchor_dirty) {
+        return;
+    }
+    std::ostringstream body;
+    body << "{\"row\":\"VERATHOS_GGML_ANCHOR_V1\"";
+    body << ",\"created_unix_ns\":" << verathos_cuda_unix_ns();
+    body << ",\"capture_token\":\"" << verathos_cuda_json_escape(verathos_cuda_trace_capture_token.c_str()) << "\"";
+    body << ",\"stages\":[";
+    bool first = true;
+    for (auto & item : verathos_cuda_anchor_stages) {
+        if (item.second.stream.is_open()) {
+            item.second.stream.flush();
+        }
+        if (item.second.rows_stream.is_open()) {
+            item.second.rows_stream.flush();
+        }
+        uint8_t root[32];
+        if (!verathos_anchor_frontier_root(&item.second.frontier, root)) {
+            continue;
+        }
+        if (!first) {
+            body << ",";
+        }
+        first = false;
+        body << "{\"stage\":\"" << verathos_cuda_json_escape(item.first.c_str()) << "\"";
+        body << ",\"rows\":" << item.second.rows;
+        body << ",\"row_width\":" << item.second.row_width;
+        static const char * hex = "0123456789abcdef";
+        body << ",\"root\":\"";
+        for (int i = 0; i < 32; i++) {
+            body << hex[root[i] >> 4] << hex[root[i] & 0xF];
+        }
+        body << "\"}";
+    }
+    body << "]}\n";
+    const std::string final_path =
+        std::string(dir) + "/anchor" + verathos_cuda_manifest_suffix() + ".json";
+    const std::string temp_path = final_path + ".tmp";
+    {
+        std::ofstream out(temp_path, std::ios::binary | std::ios::trunc);
+        if (!out.good()) {
+            return;
+        }
+        const std::string text = body.str();
+        out.write(text.data(), (std::streamsize) text.size());
+        if (!out.good()) {
+            return;  // stay dirty so the next graph end retries
+        }
+    }
+    if (std::rename(temp_path.c_str(), final_path.c_str()) == 0) {
+        verathos_cuda_anchor_dirty = false;
+    }
+}
+
+// Hashes every activation row of one anchored side and appends the leaves
+// to the stage frontier + leaf-stream file. data is the dequantized f32
+// host copy; rows are contiguous ne0-fast spans.
+static void verathos_cuda_anchor_append_rows(
+        const char * dir,
+        const char * tensor_name,
+        const char * side,
+        const float * data,
+        int64_t rows,
+        int64_t row_elems) {
+    if (data == nullptr || rows <= 0 || row_elems <= 0) {
+        return;
+    }
+    const int64_t row_width = row_elems * (int64_t) sizeof(float);
+    if (row_width > (int64_t) VERATHOS_ANCHOR_LANE_BYTES * 1024) {
+        return;  // wider than the bounded lane scratch; never expected
+    }
+    char stage_buf[512];
+    verathos_anchor_stage_id(tensor_name, side, stage_buf, sizeof(stage_buf));
+    const std::string stage(stage_buf);
+    if (stage.empty()) {
+        return;
+    }
+    verathos_cuda_anchor_stage & state = verathos_cuda_anchor_stages[stage];
+    if (state.row_width == 0) {
+        state.row_width = row_width;
+        const std::string base = std::string(dir) + "/anchor" +
+            verathos_cuda_manifest_suffix() + "-" +
+            verathos_cuda_anchor_file_component(stage);
+        state.stream.open(base + ".vleafs", std::ios::binary | std::ios::trunc);
+        if (!verathos_cuda_anchor_selected_rows.empty()) {
+            state.rows_stream.open(base + ".vrows", std::ios::binary | std::ios::trunc);
+        }
+    }
+    if (state.row_width != row_width || !state.stream.is_open()) {
+        return;  // shape drift within a capture: fail closed by starving rows
+    }
+    for (int64_t row = 0; row < rows; row++) {
+        const uint8_t * row_bytes = (const uint8_t *) (data + row * row_elems);
+        const int64_t global_index = state.rows;
+        uint8_t leaf[32];
+        verathos_anchor_row_leaf(row_bytes, (uint32_t) row_width, leaf);
+        if (!verathos_anchor_frontier_append(&state.frontier, leaf)) {
+            return;
+        }
+        state.stream.write((const char *) leaf, 32);
+        state.rows++;
+        verathos_cuda_anchor_dirty = true;
+        if (state.rows_stream.is_open() &&
+            verathos_cuda_anchor_row_selected(global_index)) {
+            // Record: u64 LE row index, u32 LE row width, raw row bytes.
+            // These are the exact bytes hashed into the leaf above, so the
+            // Merkle opening of this row verifies against the stream.
+            uint8_t header[12];
+            for (int b = 0; b < 8; b++) {
+                header[b] = (uint8_t) ((uint64_t) global_index >> (8 * b));
+            }
+            for (int b = 0; b < 4; b++) {
+                header[8 + b] = (uint8_t) ((uint32_t) row_width >> (8 * b));
+            }
+            state.rows_stream.write((const char *) header, sizeof(header));
+            state.rows_stream.write((const char *) row_bytes, (std::streamsize) row_width);
+        }
+    }
+}
