index d054fe126..12bbee10f 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1371,6 +1371,296 @@ static bool verathos_cpu_should_dump_manifest_index(int64_t manifest_index) {
     return max_total < 0 || verathos_cpu_trace_sequence < max_total;
 }
 
+// ---------------------------------------------------------------------------
+// Streaming prefill execution anchors (portable host hashing).
+//
+// The CPU backend is the hardware-invariant path: the same leaf streams and
+// roots are produced here, on CUDA, and on Metal, because all three use the
+// identical verathos-anchor.h primitives. A validator therefore verifies an
+// anchor without knowing which backend served it.
+// ---------------------------------------------------------------------------
+#include "../verathos-anchor.h"
+
+// Defined later in this translation unit.
+static void verathos_cpu_json_escape(FILE * out, const char * raw);
+static void verathos_cpu_manifest_suffix(char * out, size_t out_size);
+static int64_t verathos_cpu_unix_ns(void);
+static const char * verathos_cpu_trace_dir(void);
+
+#define VERATHOS_CPU_ANCHOR_MAX_STAGES 64
+
+typedef struct {
+    char                      stage[256];
+    verathos_anchor_frontier  frontier;
+    FILE *                    stream;
+    FILE *                    rows_stream;
+    int64_t                   row_width;
+    int64_t                   rows;
+} verathos_cpu_anchor_stage;
+
+static verathos_cpu_anchor_stage verathos_cpu_anchor_stages[VERATHOS_CPU_ANCHOR_MAX_STAGES];
+static int verathos_cpu_anchor_stage_count = 0;
+// Set on row append, cleared on a successful summary write. Decode graphs
+// append no anchor rows, so without this gate every generated token pays a
+// summary rewrite (flush + temp file + rename), a fixed per-token cost.
+static bool verathos_cpu_anchor_dirty = false;
+// Bounded selected-row dump: one global row list applies to every anchored
+// stage (the audit arms one op; src1 and dst append the same rows per
+// execution). The dumped bytes are the exact bytes hashed into the leaves.
+static int64_t verathos_cpu_anchor_selected_rows[64];
+static int     verathos_cpu_anchor_selected_row_count = 0;
+
+static void verathos_cpu_parse_anchor_rows(const char * token) {
+    verathos_cpu_anchor_selected_row_count = 0;
+    const char * pos = strstr(token, "anchor_rows=");
+    if (pos == NULL) {
+        return;
+    }
+    pos += strlen("anchor_rows=");
+    while (*pos != '\0' && verathos_cpu_anchor_selected_row_count < 64) {
+        while (*pos == ' ' || *pos == '\t' || *pos == ',') {
+            pos++;
+        }
+        if (*pos < '0' || *pos > '9') {
+            break;
+        }
+        int64_t value = 0;
+        while (*pos >= '0' && *pos <= '9') {
+            value = value * 10 + (*pos - '0');
+            pos++;
+        }
+        verathos_cpu_anchor_selected_rows[verathos_cpu_anchor_selected_row_count++] = value;
+    }
+}
+
+static bool verathos_cpu_anchor_row_selected(int64_t index) {
+    for (int i = 0; i < verathos_cpu_anchor_selected_row_count; i++) {
+        if (verathos_cpu_anchor_selected_rows[i] == index) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Which tensors anchor, armed PER REQUEST through the capture token. The
+// env var is cached on first use and can therefore never express "anchor
+// this op for this audit"; only the token can. Neither set means anchoring
+// is off, so organic serves pay exactly nothing.
+static char verathos_cpu_anchor_token_filters[1024] = {0};
+
+static void verathos_cpu_parse_anchor_tensors(const char * token) {
+    verathos_cpu_anchor_token_filters[0] = '\0';
+    const char * pos = strstr(token, "anchor_tensors=");
+    if (pos == NULL) {
+        return;
+    }
+    pos += strlen("anchor_tensors=");
+    const char * end = strchr(pos, '|');
+    size_t len = end ? (size_t) (end - pos) : strlen(pos);
+    if (len >= sizeof(verathos_cpu_anchor_token_filters)) {
+        len = sizeof(verathos_cpu_anchor_token_filters) - 1;
+    }
+    memcpy(verathos_cpu_anchor_token_filters, pos, len);
+    verathos_cpu_anchor_token_filters[len] = '\0';
+}
+
+static bool verathos_cpu_anchor_matches(const char * name) {
+    static int cached = -1;
+    static char env_filters[1024];
+    if (cached < 0) {
+        const char * raw = getenv("VERATHOS_GGML_ANCHOR_TENSORS");
+        if (raw == NULL || raw[0] == '\0') {
+            cached = 0;
+        } else {
+            snprintf(env_filters, sizeof(env_filters), "%s", raw);
+            cached = 1;
+        }
+    }
+    if (name == NULL || name[0] == '\0') {
+        return false;
+    }
+    // Token-armed filters win; the env var stays a bench-only override.
+    const char * filters = verathos_cpu_anchor_token_filters[0] != '\0'
+        ? verathos_cpu_anchor_token_filters
+        : (cached == 1 ? env_filters : NULL);
+    if (filters == NULL) {
+        return false;
+    }
+    const char * start = filters;
+    while (*start) {
+        const char * comma = strchr(start, ',');
+        const size_t len = comma ? (size_t) (comma - start) : strlen(start);
+        if (len > 0 && len < 256) {
+            char item[256];
+            memcpy(item, start, len);
+            item[len] = '\0';
+            if (strstr(name, item) != NULL) {
+                return true;
+            }
+        }
+        if (!comma) {
+            break;
+        }
+        start = comma + 1;
+    }
+    return false;
+}
+
+static void verathos_cpu_anchor_reset(void) {
+    for (int i = 0; i < verathos_cpu_anchor_stage_count; i++) {
+        if (verathos_cpu_anchor_stages[i].stream != NULL) {
+            fclose(verathos_cpu_anchor_stages[i].stream);
+        }
+        if (verathos_cpu_anchor_stages[i].rows_stream != NULL) {
+            fclose(verathos_cpu_anchor_stages[i].rows_stream);
+        }
+    }
+    memset(verathos_cpu_anchor_stages, 0, sizeof(verathos_cpu_anchor_stages));
+    verathos_cpu_anchor_stage_count = 0;
+    verathos_cpu_anchor_dirty = false;
+}
+
+static void verathos_cpu_anchor_write_summary(const char * dir) {
+    if (verathos_cpu_anchor_stage_count <= 0 || !verathos_cpu_anchor_dirty) {
+        return;
+    }
+    char suffix[64];
+    verathos_cpu_manifest_suffix(suffix, sizeof(suffix));
+    char final_path[8192];
+    char temp_path[8192];
+    snprintf(final_path, sizeof(final_path), "%s/anchor%s.json", dir, suffix);
+    snprintf(temp_path, sizeof(temp_path), "%s.tmp", final_path);
+    FILE * out = fopen(temp_path, "wb");
+    if (out == NULL) {
+        return;
+    }
+    fprintf(out, "{\"row\":\"VERATHOS_GGML_ANCHOR_V1\"");
+    fprintf(out, ",\"created_unix_ns\":%lld", (long long) verathos_cpu_unix_ns());
+    fprintf(out, ",\"capture_token\":\"");
+    verathos_cpu_json_escape(out, verathos_cpu_trace_capture_token);
+    fprintf(out, "\",\"stages\":[");
+    bool first = true;
+    for (int i = 0; i < verathos_cpu_anchor_stage_count; i++) {
+        verathos_cpu_anchor_stage * state = &verathos_cpu_anchor_stages[i];
+        if (state->stream != NULL) {
+            fflush(state->stream);
+        }
+        if (state->rows_stream != NULL) {
+            fflush(state->rows_stream);
+        }
+        uint8_t root[32];
+        if (!verathos_anchor_frontier_root(&state->frontier, root)) {
+            continue;
+        }
+        if (!first) {
+            fprintf(out, ",");
+        }
+        first = false;
+        fprintf(out, "{\"stage\":\"");
+        verathos_cpu_json_escape(out, state->stage);
+        fprintf(out, "\",\"rows\":%lld,\"row_width\":%lld,\"root\":\"",
+                (long long) state->rows, (long long) state->row_width);
+        for (int b = 0; b < 32; b++) {
+            fprintf(out, "%02x", root[b]);
+        }
+        fprintf(out, "\"}");
+    }
+    fprintf(out, "]}\n");
+    if (fclose(out) != 0) {
+        return;  // stay dirty so the next graph end retries
+    }
+    if (rename(temp_path, final_path) == 0) {
+        verathos_cpu_anchor_dirty = false;
+    }
+}
+
+static verathos_cpu_anchor_stage * verathos_cpu_anchor_lookup(
+        const char * dir, const char * stage, int64_t row_width) {
+    for (int i = 0; i < verathos_cpu_anchor_stage_count; i++) {
+        if (strcmp(verathos_cpu_anchor_stages[i].stage, stage) == 0) {
+            return &verathos_cpu_anchor_stages[i];
+        }
+    }
+    if (verathos_cpu_anchor_stage_count >= VERATHOS_CPU_ANCHOR_MAX_STAGES) {
+        return NULL;
+    }
+    verathos_cpu_anchor_stage * state =
+        &verathos_cpu_anchor_stages[verathos_cpu_anchor_stage_count];
+    memset(state, 0, sizeof(*state));
+    snprintf(state->stage, sizeof(state->stage), "%s", stage);
+    state->row_width = row_width;
+    char suffix[64];
+    verathos_cpu_manifest_suffix(suffix, sizeof(suffix));
+    char safe[256];
+    size_t si = 0;
+    for (const char * p = stage; *p && si + 1 < sizeof(safe); p++, si++) {
+        const char c = *p;
+        const bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                        (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
+        safe[si] = ok ? c : '_';
+    }
+    safe[si] = '\0';
+    char path[8192];
+    snprintf(path, sizeof(path), "%s/anchor%s-%s.vleafs", dir, suffix, safe);
+    state->stream = fopen(path, "wb");
+    if (state->stream == NULL) {
+        return NULL;
+    }
+    if (verathos_cpu_anchor_selected_row_count > 0) {
+        snprintf(path, sizeof(path), "%s/anchor%s-%s.vrows", dir, suffix, safe);
+        state->rows_stream = fopen(path, "wb");
+    }
+    verathos_cpu_anchor_stage_count++;
+    return state;
+}
+
+static void verathos_cpu_anchor_append_rows(
+        const char * dir, const char * tensor_name, const char * side,
+        const float * data, int64_t rows, int64_t row_elems) {
+    if (data == NULL || rows <= 0 || row_elems <= 0) {
+        return;
+    }
+    const int64_t row_width = row_elems * (int64_t) sizeof(float);
+    if (row_width > (int64_t) VERATHOS_ANCHOR_LANE_BYTES * 1024) {
+        return;
+    }
+    char stage[512];
+    verathos_anchor_stage_id(tensor_name, side, stage, sizeof(stage));
+    if (stage[0] == '\0') {
+        return;
+    }
+    verathos_cpu_anchor_stage * state =
+        verathos_cpu_anchor_lookup(dir, stage, row_width);
+    if (state == NULL || state->row_width != row_width || state->stream == NULL) {
+        return;
+    }
+    for (int64_t row = 0; row < rows; row++) {
+        const uint8_t * row_bytes = (const uint8_t *) (data + row * row_elems);
+        const int64_t global_index = state->rows;
+        uint8_t leaf[32];
+        verathos_anchor_row_leaf(row_bytes, (uint32_t) row_width, leaf);
+        if (!verathos_anchor_frontier_append(&state->frontier, leaf)) {
+            return;
+        }
+        fwrite(leaf, 1, 32, state->stream);
+        state->rows++;
+        verathos_cpu_anchor_dirty = true;
+        if (state->rows_stream != NULL &&
+            verathos_cpu_anchor_row_selected(global_index)) {
+            // Record: u64 LE row index, u32 LE row width, raw row bytes.
+            uint8_t header[12];
+            for (int b = 0; b < 8; b++) {
+                header[b] = (uint8_t) ((uint64_t) global_index >> (8 * b));
+            }
+            for (int b = 0; b < 4; b++) {
+                header[8 + b] = (uint8_t) ((uint32_t) row_width >> (8 * b));
+            }
+            fwrite(header, 1, sizeof(header), state->rows_stream);
+            fwrite(row_bytes, 1, (size_t) row_width, state->rows_stream);
+        }
+    }
+}
+
 static void verathos_cpu_refresh_capture_token(const char * enable_file) {
     char token[sizeof(verathos_cpu_trace_capture_token)];
     if (!verathos_cpu_read_capture_token(enable_file, token, sizeof(token))) {
@@ -1387,6 +1677,9 @@ static void verathos_cpu_refresh_capture_token(const char * enable_file) {
         verathos_cpu_graph_max_src1_rows = 0;
         verathos_cpu_parse_selected_manifest_indexes(token);
         verathos_cpu_parse_selected_ops(token);
+        verathos_cpu_parse_anchor_rows(token);
+        verathos_cpu_parse_anchor_tensors(token);
+        verathos_cpu_anchor_reset();
         if (verathos_cpu_manifest_file != NULL) {
             fflush(verathos_cpu_manifest_file);
             fclose(verathos_cpu_manifest_file);
@@ -1794,6 +2087,30 @@ static void verathos_cpu_try_dump_mul_mat_trace(const struct ggml_tensor * dst)
 
     const bool selected_op_dump = verathos_cpu_selected_ops_count > 0 &&
         verathos_cpu_should_dump_selected_op(verathos_cpu_graph_sequence, intra_graph_index);
