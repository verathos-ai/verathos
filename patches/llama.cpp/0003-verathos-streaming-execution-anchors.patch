+        if (anchor_src1 != NULL && anchor_dst != NULL &&
+            verathos_cpu_tensor_to_f32(src1, anchor_src1) &&
+            verathos_cpu_tensor_to_f32(dst, anchor_dst)) {
+            verathos_cpu_anchor_append_rows(
+                dir, src0->name, "src1", anchor_src1, src1->ne[1], src1->ne[0]);
+            verathos_cpu_anchor_append_rows(
+                dir, src0->name, "dst", anchor_dst, dst->ne[1], dst->ne[0]);
+        }
+        free(anchor_src1);
+        free(anchor_dst);
+    }
     if (!selected_op_dump && verathos_cpu_selected_ops_count > 0) {
         return;
     }
@@ -1920,6 +2237,12 @@ static void verathos_cpu_trace_begin_graph(void) {
 }
 
