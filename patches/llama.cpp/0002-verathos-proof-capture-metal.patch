+static std::string verathos_metal_json_escape(const char * raw) {
+    std::ostringstream out;
+    for (const char * p = raw ? raw : ""; *p; ++p) {
+        switch (*p) {
+            case '\\': out << "\\\\"; break;
+            case '"': out << "\\\""; break;
+            case '\n': out << "\\n"; break;
+            case '\r': out << "\\r"; break;
+            case '\t': out << "\\t"; break;
+            default: out << *p; break;
+        }
+    }
+    return out.str();
+}
+
+static std::string verathos_metal_hex_escape(const char * raw) {
+    static const char * hex = "0123456789abcdef";
+    std::string out;
+    for (const unsigned char * p = reinterpret_cast<const unsigned char *>(raw ? raw : ""); *p; ++p) {
+        out.push_back(hex[*p >> 4]);
+        out.push_back(hex[*p & 0x0f]);
+    }
+    return out;
+}
+
+static std::string verathos_metal_compact_field(const char * raw) {
+    std::string out(raw ? raw : "");
+    for (char & ch : out) {
+        if (ch == '\t' || ch == '\n' || ch == '\r') {
+            ch = ' ';
+        }
+    }
+    return out;
+}
+
+static bool verathos_metal_manifest_v3() {
+    const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && std::string(raw) == "compact-raw-v3";
+}
+
+static bool verathos_metal_manifest_compact() {
+    const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "compact" ||
+        std::string(raw) == "compact-raw" ||
+        std::string(raw) == "compact-raw-v2" ||
+        std::string(raw) == "compact-raw-v3" ||
+        std::string(raw) == "raw" ||
+        std::string(raw) == "decode" ||
+        std::string(raw) == "decode-only");
+}
+
+static bool verathos_metal_manifest_any() {
+    const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && raw[0] != '\0' && std::string(raw) != "none";
+}
+
+// Candidate-profile fast path (same contract as the CUDA hook's
+// capture_work_pending gate): once the per-window witness budget is spent,
+// no replay ops are selected, and no manifest rows are being written, the
+// post-compute hook has nothing left to do — skip the full-pipeline
+// ggml_metal_synchronize and node scan, which otherwise cost per-token
+// time for the whole generation.
+static bool verathos_metal_capture_work_pending() {
+    if (!verathos_metal_selected_manifest_indexes.empty()) {
+        return true;
+    }
+    if (!verathos_metal_selected_ops.empty()) {
+        return true;
+    }
+    if (verathos_metal_manifest_any()) {
+        return true;
+    }
+    const int64_t max_total = verathos_metal_trace_max_ops();
+    return max_total < 0 || verathos_metal_trace_sequence < max_total;
+}
+
+static bool verathos_metal_manifest_compact_raw() {
+    const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "compact-raw" ||
+        std::string(raw) == "compact-raw-v2" ||
+        std::string(raw) == "compact-raw-v3" ||
+        std::string(raw) == "raw");
+}
+
+static bool verathos_metal_manifest_disabled() {
+    const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "none" ||
+        std::string(raw) == "off" ||
+        std::string(raw) == "0");
+}
+
+static bool verathos_metal_manifest_decode_only() {
+    const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "decode" ||
+        std::string(raw) == "decode-only");
+}
+
+static std::string verathos_metal_filename(const std::string & path) {
+    const size_t slash = path.find_last_of("/\\");
+    return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+static bool verathos_metal_ends_with(const std::string & value, const std::string & suffix) {
+    return value.size() >= suffix.size() &&
+        value.compare(value.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
+
+static bool verathos_metal_is_decode_candidate(
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * dst) {
+    const std::string tensor_name = src0 != nullptr ? src0->name : "";
+    const std::string src1_name = src1 != nullptr ? src1->name : "";
+    const std::string dst_name = dst != nullptr ? dst->name : "";
+    if (tensor_name == "output.weight" ||
+        tensor_name == "lm_head.weight" ||
+        verathos_metal_ends_with(tensor_name, ".lm_head.weight")) {
+        return true;
+    }
+    if (tensor_name.find("attn_output") != std::string::npos) {
+        return false;
+    }
+    return dst_name == "logits" ||
+        dst_name == "result_output" ||
+        (dst_name.find("result_output") != std::string::npos &&
+         (src1_name.find("result_norm") != std::string::npos ||
+          src1_name.find("final") != std::string::npos));
+}
+
+static std::string verathos_metal_manifest_suffix() {
+    std::string suffix;
+    for (char ch : verathos_metal_trace_capture_token) {
+        if (ch < '0' || ch > '9') {
+            break;
+        }
+        if (suffix.size() >= 64) {
+            break;
+        }
+        suffix.push_back(ch);
+    }
+    return suffix.empty() ? "" : "-" + suffix;
+}
+
+static bool verathos_metal_write_f32(const std::string & path, const std::vector<float> & values) {
+    std::ofstream out(path, std::ios::binary);
+    if (!out) {
+        return false;
+    }
+    out.write(reinterpret_cast<const char *>(values.data()), values.size() * sizeof(float));
+    return bool(out);
+}
+
+static bool verathos_metal_write_raw(const std::string & path, const std::vector<uint8_t> & values) {
+    std::ofstream out(path, std::ios::binary);
+    if (!out) {
+        return false;
+    }
+    out.write(reinterpret_cast<const char *>(values.data()), values.size());
+    return bool(out);
+}
+
+static std::ostream * verathos_metal_manifest_for_capture(const char * dir) {
+    if (verathos_metal_manifest_disabled()) {
+        return nullptr;
+    }
+    const std::string path = std::string(dir) + "/manifest" + verathos_metal_manifest_suffix() +
+        (verathos_metal_manifest_compact() ? ".vmanifest" : ".jsonl");
+    if (verathos_metal_manifest_path != path || !verathos_metal_manifest_stream.is_open()) {
+        if (verathos_metal_manifest_stream.is_open()) {
+            verathos_metal_flush_manifest_buffer();
+            verathos_metal_manifest_stream.flush();
+            verathos_metal_manifest_stream.close();
+        }
+        verathos_metal_manifest_buffer.clear();
+        verathos_metal_manifest_path = path;
+        verathos_metal_manifest_stream.open(path, std::ios::app);
+    }
+    if (!verathos_metal_manifest_stream) {
+        return nullptr;
+    }
+    return &verathos_metal_manifest_stream;
+}
+
+static void verathos_metal_write_manifest_entry(
+        const char * dir,
+        int64_t now_ns,
+        int64_t manifest_index,
+        const char * device_name,
+        bool proof_eligible,
+        int64_t graph_sequence,
+        int64_t intra_graph_index,
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * dst) {
+    if (verathos_metal_manifest_decode_only() && !verathos_metal_is_decode_candidate(src0, src1, dst)) {
+        return;
+    }
+    std::ostream * manifest_stream = verathos_metal_manifest_for_capture(dir);
+    if (manifest_stream == nullptr) {
+        return;
+    }
+    std::ostream & manifest = *manifest_stream;
+    if (verathos_metal_manifest_compact()) {
+        const bool raw_compact = verathos_metal_manifest_compact_raw();
+        const char * manifest_format = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+        const bool raw_compact_v3 = verathos_metal_manifest_v3();
+        const bool raw_compact_v2 = raw_compact_v3 ||
+            (manifest_format != nullptr && std::string(manifest_format) == "compact-raw-v2");
+        const std::string graph_id = std::string("metal-mul-mat-") + std::to_string(manifest_index);
+        std::string line;
+        line.reserve(384);
+        auto append_field = [&](const std::string & value) {
+            line.push_back('\t');
+            line += value;
+        };
+        auto append_shape = [&](const ggml_tensor * tensor) {
+            line.push_back('\t');
+            line += std::to_string(tensor->ne[0]);
+            line.push_back(',');
+            line += std::to_string(tensor->ne[1]);
+            line.push_back(',');
+            line += std::to_string(tensor->ne[2]);
+            line.push_back(',');
+            line += std::to_string(tensor->ne[3]);
+        };
+        if (raw_compact_v2) {
+            line += raw_compact_v3
+                ? "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V3"
+                : "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V2";
+            append_field(std::to_string(now_ns));
+            append_field(std::to_string(manifest_index));
+            append_field(verathos_metal_compact_field(src0->name));
+            append_field(verathos_metal_compact_field(src1->name));
+            append_field(verathos_metal_compact_field(dst->name));
+            append_shape(src0);
+            append_shape(src1);
+            append_shape(dst);
+            append_field(ggml_type_name((ggml_type) src0->type));
+            append_field(ggml_type_name((ggml_type) src1->type));
+            append_field(ggml_type_name((ggml_type) dst->type));
+            append_field("llama_cpp_metal");
+            append_field(verathos_metal_compact_field(device_name));
+            append_field(proof_eligible ? "1" : "0");
+            if (raw_compact_v3) {
+                append_field(std::to_string(graph_sequence));
+                append_field(std::to_string(intra_graph_index));
+            }
+            line.push_back('\n');
+            verathos_metal_manifest_buffer += line;
+            return;
+        }
+        line += (raw_compact ? "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V1" : "VERATHOS_GGML_OP_MANIFEST_COMPACT_V1");
+        append_field(std::to_string(now_ns));
+        append_field(std::to_string(manifest_index));
+        append_field(raw_compact ? verathos_metal_compact_field(graph_id.c_str()) : verathos_metal_hex_escape(graph_id.c_str()));
+        append_field(std::to_string(manifest_index));
+        append_field(raw_compact ? verathos_metal_compact_field(src0->name) : verathos_metal_hex_escape(src0->name));
+        append_field(raw_compact ? verathos_metal_compact_field(src0->name) : verathos_metal_hex_escape(src0->name));
+        append_field(raw_compact ? verathos_metal_compact_field(src1->name) : verathos_metal_hex_escape(src1->name));
+        append_field(raw_compact ? verathos_metal_compact_field(dst->name) : verathos_metal_hex_escape(dst->name));
+        append_shape(src0);
+        append_shape(src1);
+        append_shape(dst);
+        append_field(ggml_type_name((ggml_type) src0->type));
+        append_field(ggml_type_name((ggml_type) src1->type));
+        append_field(ggml_type_name((ggml_type) dst->type));
+        append_field(raw_compact ? verathos_metal_compact_field("llama_cpp_metal") : verathos_metal_hex_escape("llama_cpp_metal"));
+        append_field(raw_compact ? verathos_metal_compact_field(device_name) : verathos_metal_hex_escape(device_name));
+        append_field(proof_eligible ? "1" : "0");
+        line.push_back('\n');
+        verathos_metal_manifest_buffer += line;
+        return;
+    }
+    manifest << "{\"version\":1";
+    manifest << ",\"created_unix_ns\":" << now_ns;
+    manifest << ",\"manifest_index\":" << manifest_index;
+    manifest << ",\"graph_id\":\"metal-mul-mat-" << manifest_index << "\"";
+    manifest << ",\"op_index\":" << manifest_index;
+    manifest << ",\"op_type\":\"GGML_OP_MUL_MAT\"";
+    manifest << ",\"tensor_name\":\"" << verathos_metal_json_escape(src0->name) << "\"";
+    manifest << ",\"src0_name\":\"" << verathos_metal_json_escape(src0->name) << "\"";
+    manifest << ",\"src1_name\":\"" << verathos_metal_json_escape(src1->name) << "\"";
+    manifest << ",\"dst_name\":\"" << verathos_metal_json_escape(dst->name) << "\"";
+    manifest << ",\"src0_shape\":[" << src0->ne[0] << "," << src0->ne[1] << "," << src0->ne[2] << "," << src0->ne[3] << "]";
+    manifest << ",\"src1_shape\":[" << src1->ne[0] << "," << src1->ne[1] << "," << src1->ne[2] << "," << src1->ne[3] << "]";
+    manifest << ",\"dst_shape\":[" << dst->ne[0] << "," << dst->ne[1] << "," << dst->ne[2] << "," << dst->ne[3] << "]";
+    manifest << ",\"source_types\":{\"src0\":\"" << ggml_type_name((ggml_type) src0->type)
+             << "\",\"src1\":\"" << ggml_type_name((ggml_type) src1->type)
+             << "\",\"dst\":\"" << ggml_type_name((ggml_type) dst->type) << "\"}";
+    manifest << ",\"backend\":\"llama_cpp_metal\"";
+    manifest << ",\"device\":\"" << verathos_metal_json_escape(device_name) << "\"";
+    manifest << ",\"proof_eligible\":" << (proof_eligible ? "true" : "false") << "}\n";
+}
+
+static bool verathos_metal_tensor_raw_to_host(
+        ggml_metal_t ctx,
+        const ggml_tensor * tensor,
+        std::vector<uint8_t> & raw) {
+    if (ctx == nullptr || tensor == nullptr || tensor->data == nullptr || tensor->buffer == nullptr) {
+        return false;
+    }
+    if (!ggml_is_contiguous(tensor)) {
+        return false;
+    }
+    const size_t nbytes = ggml_nbytes(tensor);
+    if (nbytes == 0) {
+        return false;
+    }
+    raw.resize(nbytes);
+    if (ggml_backend_buffer_is_metal(tensor->buffer)) {
+        ggml_metal_get_tensor_async(ctx, tensor, raw.data(), 0, nbytes);
+        ggml_metal_synchronize(ctx);
+        return true;
+    }
+    if (ggml_backend_buffer_is_host(tensor->buffer)) {
+        memcpy(raw.data(), tensor->data, nbytes);
+        return true;
+    }
+    return false;
+}
+
+static bool verathos_metal_raw_to_f32(
+        const ggml_tensor * tensor,
+        const std::vector<uint8_t> & raw,
+        std::vector<float> & out) {
+    const int64_t n = ggml_nelements(tensor);
+    if (n <= 0) {
+        return false;
+    }
+    out.resize(n);
+    if (tensor->type == GGML_TYPE_F32) {
+        if (raw.size() != sizeof(float) * (size_t) n) {
+            return false;
+        }
+        memcpy(out.data(), raw.data(), raw.size());
+        return true;
+    }
+    const ggml_type_traits * traits = ggml_get_type_traits((ggml_type) tensor->type);
+    if (traits == nullptr || traits->to_float == nullptr) {
+        return false;
+    }
+    traits->to_float(raw.data(), out.data(), n);
+    return true;
+}
+
+static bool verathos_metal_is_stable_after_graph(
+        const ggml_cgraph * cgraph,
+        int node_idx,
+        const ggml_tensor * dst) {
+    if (dst == nullptr) {
+        return false;
+    }
+    if ((dst->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return true;
+    }
+    if (cgraph == nullptr || node_idx < 0 || node_idx >= cgraph->n_nodes) {
+        return false;
+    }
+    return ggml_node_get_use_count(cgraph, node_idx) == 0;
+}
+
+// Verathos tail ring (probe-free light tier), Metal form of the CUDA ring.
+// Keeps the last K final-logit decode instances of the current generation in
+// host memory (unified-memory reads, copied after the per-graph synchronize
+// the capture loop already does) and writes them out as ordinary trace files
+// once the generation goes idle, so the light proof assembles from
+// serve-time material with no replay and no exclusive window. Selected-op
+// witness dumps (hard tier, probe fallback) are untouched.
+
+struct verathos_metal_tail_pending {
+    const ggml_tensor * src0;
+    const ggml_tensor * src1;
+    const ggml_tensor * dst;
+    int64_t graph_seq;
+    int64_t intra_graph_index;
+    int64_t manifest_index;
+};
+
+struct verathos_metal_tail_slot {
+    std::vector<uint8_t> src1_bytes;
+    std::vector<uint8_t> dst_bytes;
+    int64_t ns = 0;
+    int64_t graph_seq = -1;
+    int64_t intra_graph_index = -1;
+    int64_t manifest_index = -1;
+    std::string device_name;
+    int64_t src0_ne[2] = {0, 0};
+    int64_t src1_ne[2] = {0, 0};
+    int64_t dst_ne[2] = {0, 0};
+    ggml_type src0_type = GGML_TYPE_F32;
+    std::string src0_name;
+    std::string src1_name;
+    std::string dst_name;
+    bool valid = false;
+};
+
+struct verathos_metal_tail_pool {
+    std::vector<verathos_metal_tail_slot> slots;
+    size_t head = 0;
+    size_t count = 0;
+};
+
+static std::mutex verathos_metal_tail_mutex;
+static verathos_metal_tail_pool verathos_metal_tail_pools[2];
+static int verathos_metal_tail_active_pool = 0;
+static std::atomic<int64_t> verathos_metal_tail_last_insert_ns{0};
+static std::atomic<bool> verathos_metal_tail_flush_asap{false};
+static long long verathos_metal_tail_signal_seen = 0;
+static std::vector<verathos_metal_tail_pending> verathos_metal_tail_staging;
+
+static bool verathos_metal_tail_ring_on() {
+    static const bool value = verathos_metal_env_bool("VERATHOS_GGML_TAIL_RING", true);
+    return value;
+}
+
+static int64_t verathos_metal_tail_ring_slots() {
+    static const int64_t value = [] {
+        int64_t raw = verathos_metal_env_i64("VERATHOS_GGML_TAIL_RING_SLOTS", 48);
+        if (raw < 4) {
+            raw = 4;
+        }
+        if (raw > 512) {
+            raw = 512;
+        }
+        return raw;
+    }();
+    return value;
+}
+
+static int64_t verathos_metal_tail_ring_flush_ms() {
+    static const int64_t value = [] {
+        int64_t raw = verathos_metal_env_i64("VERATHOS_GGML_TAIL_RING_FLUSH_MS", 60);
+        if (raw < 10) {
+            raw = 10;
+        }
+        if (raw > 5000) {
+            raw = 5000;
+        }
+        return raw;
+    }();
+    return value;
+}
+
+static void verathos_metal_tail_stage(
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * dst,
+        bool graph_output,
+        int64_t graph_seq,
+        int64_t intra_graph_index,
+        int64_t manifest_index) {
+    if (!verathos_metal_tail_ring_on()) {
+        return;
+    }
+    if (!verathos_metal_selected_ops.empty() ||
+        !verathos_metal_selected_manifest_indexes.empty()) {
+        return;
+    }
+    if (!graph_output || src1->ne[1] != 1 ||
+        !verathos_metal_is_decode_candidate(src0, src1, dst)) {
+        return;
+    }
+    if (dst->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32) {
+        return;
+    }
+    if (!ggml_is_contiguous(dst) || !ggml_is_contiguous(src1)) {
+        return;
+    }
+    verathos_metal_tail_staging.push_back(verathos_metal_tail_pending{
+        src0, src1, dst, graph_seq, intra_graph_index, manifest_index,
+    });
+}
+
+static bool verathos_metal_tail_write_blob(const std::string & path, const void * data, size_t nbytes) {
+    std::ofstream out(path, std::ios::binary);
+    if (!out) {
+        return false;
+    }
+    out.write(reinterpret_cast<const char *>(data), (std::streamsize) nbytes);
+    return bool(out);
+}
+
+static void verathos_metal_tail_flush_pool(verathos_metal_tail_pool & pool, const std::string & dir) {
+    if (pool.count == 0) {
+        return;
+    }
+    const size_t slots = pool.slots.size();
+    const size_t first = (pool.head + slots - pool.count) % slots;
+    const int64_t flush_ns = verathos_metal_unix_ns();
+    int64_t seq = 0;
+    const int64_t total = (int64_t) pool.count;
+    for (size_t i = 0; i < pool.count; ++i) {
+        verathos_metal_tail_slot & slot = pool.slots[(first + i) % slots];
+        if (!slot.valid) {
+            continue;
+        }
+        slot.valid = false;
+        std::ostringstream prefix;
+        prefix << dir << "/trace-" << slot.ns << "-metal-op" << slot.manifest_index;
+        const std::string src1_path = prefix.str() + "-src1.f32";
+        const std::string dst_path = prefix.str() + "-dst.f32";
+        const std::string json_path = prefix.str() + ".json";
+        if (!verathos_metal_tail_write_blob(src1_path, slot.src1_bytes.data(), slot.src1_bytes.size()) ||
+            !verathos_metal_tail_write_blob(dst_path, slot.dst_bytes.data(), slot.dst_bytes.size())) {
+            continue;
+        }
+        std::ofstream meta(json_path);
+        if (!meta) {
+            continue;
+        }
+        meta << "{\n";
+        meta << "  \"version\": 1,\n";
+        meta << "  \"created_unix_ns\": " << slot.ns << ",\n";
+        meta << "  \"manifest_index\": " << slot.manifest_index << ",\n";
+        meta << "  \"graph_seq\": " << slot.graph_seq << ",\n";
+        meta << "  \"intra_graph_index\": " << slot.intra_graph_index << ",\n";
+        meta << "  \"tail_ring\": 1,\n";
+        meta << "  \"tail_flush_ns\": " << flush_ns << ",\n";
+        meta << "  \"tail_seq\": " << seq << ",\n";
+        meta << "  \"tail_total\": " << total << ",\n";
+        meta << "  \"graph_id\": \"metal-mul-mat-" << slot.manifest_index << "\",\n";
+        meta << "  \"op_index\": " << slot.manifest_index << ",\n";
+        meta << "  \"op_type\": \"GGML_OP_MUL_MAT\",\n";
+        meta << "  \"tensor_name\": \"" << verathos_metal_json_escape(slot.src0_name.c_str()) << "\",\n";
+        meta << "  \"src0_name\": \"" << verathos_metal_json_escape(slot.src0_name.c_str()) << "\",\n";
+        meta << "  \"src1_name\": \"" << verathos_metal_json_escape(slot.src1_name.c_str()) << "\",\n";
+        meta << "  \"dst_name\": \"" << verathos_metal_json_escape(slot.dst_name.c_str()) << "\",\n";
+        meta << "  \"src0_shape\": [" << slot.src0_ne[0] << "," << slot.src0_ne[1] << ",1,1],\n";
+        meta << "  \"src1_shape\": [" << slot.src1_ne[0] << "," << slot.src1_ne[1] << ",1,1],\n";
+        meta << "  \"dst_shape\": [" << slot.dst_ne[0] << "," << slot.dst_ne[1] << ",1,1],\n";
+        meta << "  \"src0_raw_type\": \"" << ggml_type_name(slot.src0_type) << "\",\n";
+        meta << "  \"src1_f32\": \"" << verathos_metal_filename(src1_path) << "\",\n";
+        meta << "  \"dst_f32\": \"" << verathos_metal_filename(dst_path) << "\",\n";
+        meta << "  \"source_types\": {\"src0\": \"" << ggml_type_name(slot.src0_type)
+             << "\", \"src1\": \"f32\", \"dst\": \"f32\"},\n";
+        meta << "  \"backend\": \"llama_cpp_metal\",\n";
+        meta << "  \"device\": \"" << verathos_metal_json_escape(slot.device_name.c_str()) << "\"\n";
+        meta << "}\n";
+        seq++;
+    }
+    pool.head = 0;
+    pool.count = 0;
+}
+
+static void verathos_metal_tail_thread_main() {
+    // Every drain (here and the rotation path in commit) runs UNDER the ring
+    // mutex, which is what makes pool rotation race-free.
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(15));
+        const char * dir = verathos_metal_trace_dir();
+        if (dir == nullptr || dir[0] == '\0') {
+            continue;
+        }
+        {
+            // Reply-end signal from the server: flush without waiting
+            // out the idle timer. A stale stamp from a previous run
+            // triggers at most one harmless early flush.
+            std::ifstream signal_in(std::string(dir) + "/.tail-flush");
+            long long stamp = 0;
+            if (signal_in && (signal_in >> stamp) && stamp != 0 &&
+                stamp != verathos_metal_tail_signal_seen) {
+                verathos_metal_tail_signal_seen = stamp;
+                verathos_metal_tail_flush_asap.store(true);
+            }
+        }
+        std::lock_guard<std::mutex> lock(verathos_metal_tail_mutex);
+        verathos_metal_tail_pool & inactive = verathos_metal_tail_pools[verathos_metal_tail_active_pool ^ 1];
+        if (inactive.count > 0) {
+            verathos_metal_tail_flush_pool(inactive, dir);
+            verathos_metal_tail_flush_asap.store(false);
+            continue;
+        }
+        const int64_t last = verathos_metal_tail_last_insert_ns.load();
+        const bool asap = verathos_metal_tail_flush_asap.load();
+        if (last == 0 && !asap) {
+            continue;
+        }
+        const int64_t idle_ns = verathos_metal_unix_ns() - last;
+        if (!asap && idle_ns < verathos_metal_tail_ring_flush_ms() * 1000000) {
+            continue;
+        }
+        verathos_metal_tail_pool & active = verathos_metal_tail_pools[verathos_metal_tail_active_pool];
+        verathos_metal_tail_flush_asap.store(false);
+        verathos_metal_tail_last_insert_ns.store(0);
+        if (active.count > 0) {
+            verathos_metal_tail_flush_pool(active, dir);
+        }
+    }
+}
+
+static void verathos_metal_tail_commit(ggml_metal_t ctx) {
+    const bool prefill_shaped = verathos_metal_graph_max_src1_rows > 1;
+    if (verathos_metal_tail_staging.empty() && !prefill_shaped) {
+        return;
+    }
+    static std::once_flag thread_once;
+    std::call_once(thread_once, [] {
+        std::thread(verathos_metal_tail_thread_main).detach();
+    });
+    std::lock_guard<std::mutex> lock(verathos_metal_tail_mutex);
+    if (prefill_shaped &&
+        verathos_metal_tail_pools[verathos_metal_tail_active_pool].count > 0) {
+        // A prefill-shaped graph while the ring holds entries means a new
+        // request started: rotate so the finished generation flushes as one
+        // group and this request's own instances start a fresh one.
+        verathos_metal_tail_pool & other = verathos_metal_tail_pools[verathos_metal_tail_active_pool ^ 1];
+        if (other.count > 0) {
+            const char * dir = verathos_metal_trace_dir();
+            if (dir != nullptr && dir[0] != '\0') {
+                verathos_metal_tail_flush_pool(other, dir);
+            } else {
+                other.head = 0;
+                other.count = 0;
+            }
+        }
+        verathos_metal_tail_active_pool ^= 1;
+        verathos_metal_tail_flush_asap.store(true);
+        verathos_metal_tail_last_insert_ns.store(0);
+    }
+    if (verathos_metal_tail_staging.empty()) {
+        return;
+    }
+    ggml_metal_synchronize(ctx);
+    verathos_metal_tail_pool & pool = verathos_metal_tail_pools[verathos_metal_tail_active_pool];
+    if (pool.slots.empty()) {
+        pool.slots.resize((size_t) verathos_metal_tail_ring_slots());
+    }
+    for (const verathos_metal_tail_pending & pending : verathos_metal_tail_staging) {
+        verathos_metal_tail_slot & slot = pool.slots[pool.head];
+        if (!verathos_metal_tensor_raw_to_host(ctx, pending.src1, slot.src1_bytes) ||
+            !verathos_metal_tensor_raw_to_host(ctx, pending.dst, slot.dst_bytes)) {
+            slot.src1_bytes.clear();
+            slot.dst_bytes.clear();
+            slot.valid = false;
+            continue;
+        }
+        slot.ns = verathos_metal_unix_ns();
+        slot.graph_seq = pending.graph_seq;
+        slot.intra_graph_index = pending.intra_graph_index;
+        slot.manifest_index = pending.manifest_index;
+        slot.device_name = ggml_metal_get_name(ctx) == nullptr ? "Metal" : ggml_metal_get_name(ctx);
+        slot.src0_ne[0] = pending.src0->ne[0];
+        slot.src0_ne[1] = pending.src0->ne[1];
+        slot.src1_ne[0] = pending.src1->ne[0];
+        slot.src1_ne[1] = pending.src1->ne[1];
+        slot.dst_ne[0] = pending.dst->ne[0];
+        slot.dst_ne[1] = pending.dst->ne[1];
+        slot.src0_type = (ggml_type) pending.src0->type;
+        slot.src0_name = pending.src0->name;
+        slot.src1_name = pending.src1->name;
+        slot.dst_name = pending.dst->name;
+        slot.valid = true;
+        pool.head = (pool.head + 1) % pool.slots.size();
+        if (pool.count < pool.slots.size()) {
+            pool.count++;
+        }
+        verathos_metal_tail_last_insert_ns.store(slot.ns);
+    }
+    verathos_metal_tail_staging.clear();
+}
+
+static void verathos_metal_try_dump_mul_mat_trace(
+        ggml_metal_t ctx,
+        const ggml_cgraph * cgraph,
+        int node_idx,
+        const ggml_tensor * dst) {
+    if (!verathos_metal_trace_enabled()) {
+        return;
+    }
+    const char * dir = verathos_metal_trace_dir();
+    if (dir == nullptr || dir[0] == '\0' || ctx == nullptr || dst == nullptr || dst->op != GGML_OP_MUL_MAT) {
+        return;
+    }
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    if (src0 == nullptr || src1 == nullptr) {
+        return;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 ||
+        src1->ne[2] != 1 || src1->ne[3] != 1 ||
+        dst->ne[2]  != 1 || dst->ne[3]  != 1) {
+        return;
+    }
+    if (src0->ne[0] != src1->ne[0] ||
+        dst->ne[0]  != src0->ne[1] ||
+        dst->ne[1]  != src1->ne[1]) {
+        return;
+    }
+
+    // Intra-graph index counts every dim-valid MUL_MAT regardless of size or
+    // stability eligibility, so it stays stable across batch row counts.
+    const int64_t intra_graph_index = verathos_metal_intra_graph_index++;
+    verathos_metal_graph_dim_valid_ops++;
+    if (src1->ne[1] > verathos_metal_graph_max_src1_rows) {
+        verathos_metal_graph_max_src1_rows = src1->ne[1];
+    }
+
+    verathos_metal_trace_mkdir(dir);
+    const int64_t now_ns = verathos_metal_unix_ns();
+    const int64_t manifest_index = ++verathos_metal_manifest_sequence;
+    const int64_t total_elems = ggml_nelements(src0) + ggml_nelements(src1) + ggml_nelements(dst);
+    const int64_t max_elems = verathos_metal_env_i64("VERATHOS_GGML_TRACE_MAX_ELEMS", 262144);
+    const bool graph_output = verathos_metal_is_stable_after_graph(cgraph, node_idx, dst);
+    const bool proof_eligible = graph_output && (
+        verathos_metal_is_decode_candidate(src0, src1, dst) ||
+        !(max_elems > 0 && total_elems > max_elems));
+    if (!proof_eligible) {
+        return;
+    }
+    verathos_metal_write_manifest_entry(
+        dir, now_ns, manifest_index, ggml_metal_get_name(ctx), proof_eligible,
+        verathos_metal_graph_sequence, intra_graph_index, src0, src1, dst);
+    verathos_metal_graph_written_rows++;
+    verathos_metal_tail_stage(
+        src0, src1, dst, graph_output,
+        verathos_metal_graph_sequence, intra_graph_index, manifest_index);
+    const bool selected_op_dump = !verathos_metal_selected_ops.empty() &&
+        verathos_metal_should_dump_selected_op_rows(
+            verathos_metal_graph_sequence, intra_graph_index, src1->ne[1]);
+    if (!selected_op_dump && !verathos_metal_selected_ops.empty()) {
+        return;
+    }
+    if (!selected_op_dump && !verathos_metal_should_dump_manifest_index(manifest_index)) {
+        return;
+    }
+    if (!selected_op_dump) {
+        // Broad-capture budget gate mirrors the CUDA hook: without it a
+        // bare-armed organic window (no selected ops yet) dumps EVERY
+        // eligible op of EVERY graph - sync + copy + f32 + disk per op -
+        // for the whole generation. Selected audit witnesses are never
+        // starved by the budget.
+        const int64_t max_total = verathos_metal_trace_max_ops();
+        if (max_total >= 0 && verathos_metal_trace_sequence >= max_total) {
+            return;
+        }
+    }
+    const int64_t sequence = ++verathos_metal_trace_sequence;
+
+    const bool skip_src0_dump = verathos_metal_env_bool("VERATHOS_GGML_TRACE_SKIP_SRC0_DUMP", false);
+    std::vector<uint8_t> src0_raw;
+    std::vector<uint8_t> src1_raw;
+    std::vector<uint8_t> dst_raw;
+    if ((!skip_src0_dump && !verathos_metal_tensor_raw_to_host(ctx, src0, src0_raw)) ||
+        !verathos_metal_tensor_raw_to_host(ctx, src1, src1_raw) ||
+        !verathos_metal_tensor_raw_to_host(ctx, dst, dst_raw)) {
+        return;
+    }
+
+    std::vector<float> src0_f32;
+    std::vector<float> src1_f32;
+    std::vector<float> dst_f32;
+    if ((!skip_src0_dump && !verathos_metal_raw_to_f32(src0, src0_raw, src0_f32)) ||
+        !verathos_metal_raw_to_f32(src1, src1_raw, src1_f32) ||
+        !verathos_metal_raw_to_f32(dst, dst_raw, dst_f32)) {
+        return;
+    }
+
+    std::ostringstream prefix;
+    prefix << dir << "/trace-" << now_ns << "-metal-op" << manifest_index;
+    const std::string src0_path = prefix.str() + "-src0.f32";
+    const std::string src0_raw_path = prefix.str() + "-src0.raw";
+    const std::string src1_path = prefix.str() + "-src1.f32";
+    const std::string dst_path  = prefix.str() + "-dst.f32";
+    const std::string json_path = prefix.str() + ".json";
+    if ((!skip_src0_dump && !verathos_metal_write_f32(src0_path, src0_f32)) ||
+        (!skip_src0_dump && !verathos_metal_write_raw(src0_raw_path, src0_raw)) ||
+        !verathos_metal_write_f32(src1_path, src1_f32) ||
+        !verathos_metal_write_f32(dst_path, dst_f32)) {
+        return;
+    }
+
+    std::ofstream meta(json_path);
+    if (!meta) {
+        return;
+    }
+    meta << "{\n";
+    meta << "  \"version\": 1,\n";
+    meta << "  \"created_unix_ns\": " << now_ns << ",\n";
+    meta << "  \"manifest_index\": " << manifest_index << ",\n";
+    meta << "  \"graph_seq\": " << verathos_metal_graph_sequence << ",\n";
+    meta << "  \"intra_graph_index\": " << intra_graph_index << ",\n";
+    meta << "  \"graph_id\": \"metal-mul-mat-" << manifest_index << "\",\n";
+    meta << "  \"op_index\": " << manifest_index << ",\n";
+    meta << "  \"op_type\": \"GGML_OP_MUL_MAT\",\n";
+    meta << "  \"tensor_name\": \"" << verathos_metal_json_escape(src0->name) << "\",\n";
+    meta << "  \"src0_name\": \"" << verathos_metal_json_escape(src0->name) << "\",\n";
+    meta << "  \"src1_name\": \"" << verathos_metal_json_escape(src1->name) << "\",\n";
+    meta << "  \"dst_name\": \"" << verathos_metal_json_escape(dst->name) << "\",\n";
+    meta << "  \"src0_shape\": [" << src0->ne[0] << "," << src0->ne[1] << "," << src0->ne[2] << "," << src0->ne[3] << "],\n";
+    meta << "  \"src1_shape\": [" << src1->ne[0] << "," << src1->ne[1] << "," << src1->ne[2] << "," << src1->ne[3] << "],\n";
+    meta << "  \"dst_shape\": [" << dst->ne[0] << "," << dst->ne[1] << "," << dst->ne[2] << "," << dst->ne[3] << "],\n";
+    if (!skip_src0_dump) {
+        meta << "  \"src0_f32\": \"" << verathos_metal_filename(src0_path) << "\",\n";
+        meta << "  \"src0_raw\": \"" << verathos_metal_filename(src0_raw_path) << "\",\n";
+    }
+    meta << "  \"src0_raw_type\": \"" << ggml_type_name((ggml_type) src0->type) << "\",\n";
+    meta << "  \"src1_f32\": \"" << verathos_metal_filename(src1_path) << "\",\n";
+    meta << "  \"dst_f32\": \"" << verathos_metal_filename(dst_path) << "\",\n";
+    meta << "  \"source_types\": {\"src0\": \"" << ggml_type_name((ggml_type) src0->type)
+         << "\", \"src1\": \"" << ggml_type_name((ggml_type) src1->type)
+         << "\", \"dst\": \"" << ggml_type_name((ggml_type) dst->type) << "\"},\n";
+    meta << "  \"backend\": \"llama_cpp_metal\",\n";
+    meta << "  \"device\": \"" << verathos_metal_json_escape(ggml_metal_get_name(ctx)) << "\"\n";
+    meta << "}\n";
+}
+
+static void verathos_metal_write_graph_marker(const char * device_name) {
+    if (!verathos_metal_manifest_v3() || verathos_metal_graph_dim_valid_ops <= 0) {
+        return;
+    }
+    const char * dir = verathos_metal_trace_dir();
+    if (dir == nullptr || dir[0] == '\0') {
+        return;
+    }
+    if (verathos_metal_manifest_for_capture(dir) == nullptr) {
+        return;
+    }
+    std::string line = "VERATHOS_GGML_GRAPH_V1";
+    line += "\t" + std::to_string(verathos_metal_unix_ns());
+    line += "\t" + std::to_string(verathos_metal_graph_sequence);
+    line += "\t" + std::to_string(verathos_metal_graph_dim_valid_ops);
+    line += "\t" + std::to_string(verathos_metal_graph_written_rows);
+    line += "\t" + std::to_string(verathos_metal_graph_max_src1_rows);
+    line += "\tllama_cpp_metal\t";
+    line += device_name == nullptr ? "Metal" : device_name;
+    line.push_back('\n');
+    verathos_metal_manifest_buffer += line;
+}
+
+static void verathos_metal_try_dump_graph_trace(ggml_metal_t ctx, const ggml_cgraph * cgraph) {
+    if (!verathos_metal_trace_enabled() || ctx == nullptr || cgraph == nullptr) {
+        return;
+    }
+    if (!verathos_metal_capture_work_pending()) {
+        return;
+    }
+    verathos_metal_graph_sequence++;
+    verathos_metal_intra_graph_index = 0;
+    verathos_metal_graph_dim_valid_ops = 0;
+    verathos_metal_graph_written_rows = 0;
+    verathos_metal_graph_max_src1_rows = 0;
+    ggml_metal_synchronize(ctx);
+    for (int i = 0; i < cgraph->n_nodes && verathos_metal_trace_enabled(); ++i) {
+        verathos_metal_try_dump_mul_mat_trace(ctx, cgraph, i, cgraph->nodes[i]);
+    }
+    verathos_metal_tail_commit(ctx);
+    verathos_metal_write_graph_marker(ggml_metal_get_name(ctx));
+    verathos_metal_flush_manifest_buffer();
+    if (verathos_metal_manifest_stream.is_open()) {
+        verathos_metal_manifest_stream.flush();
+    }
+}
+
+static bool verathos_metal_mul_mat_candidate(const ggml_tensor * dst) {
+    if (dst == nullptr || dst->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    if (src0 == nullptr || src1 == nullptr) {
+        return false;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 ||
+        src1->ne[2] != 1 || src1->ne[3] != 1 ||
+        dst->ne[2]  != 1 || dst->ne[3]  != 1) {
+        return false;
+    }
+    return src0->ne[0] == src1->ne[0] &&
+        dst->ne[0] == src0->ne[1] &&
+        dst->ne[1] == src1->ne[1];
+}
+
+static bool verathos_metal_manifest_index_selected(int64_t manifest_index) {
+    for (int64_t selected : verathos_metal_selected_manifest_indexes) {
+        if (selected == manifest_index) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void verathos_metal_release_tensor_snapshot(verathos_metal_tensor_snapshot & snapshot) {
+    if (snapshot.metal != nullptr) {
+        ggml_metal_trace_snapshot_free(snapshot.metal);
+        snapshot.metal = nullptr;
+    }
+    snapshot.host_raw.clear();
+    snapshot.nbytes = 0;
+    snapshot.tensor = nullptr;
+}
+
+static void verathos_metal_release_snapshot_record(verathos_metal_snapshot_record & record) {
+    verathos_metal_release_tensor_snapshot(record.src0_snapshot);
+    verathos_metal_release_tensor_snapshot(record.src1_snapshot);
+    verathos_metal_release_tensor_snapshot(record.dst_snapshot);
+}
+
+static void verathos_metal_clear_snapshot_state() {
+    std::lock_guard<std::mutex> lock(verathos_metal_snapshot_mutex);
+    for (verathos_metal_snapshot_record & record : verathos_metal_snapshot_records) {
+        verathos_metal_release_snapshot_record(record);
+    }
+    verathos_metal_snapshot_records.clear();
+    verathos_metal_planned_snapshots.clear();
+}
+
+static bool verathos_metal_capture_tensor_snapshot(
+        ggml_metal_encoder_t encoder,
+        ggml_metal_cmd_buf_t cmd_buf,
+        const ggml_tensor * tensor,
+        verathos_metal_tensor_snapshot & snapshot) {
+    if (tensor == nullptr || tensor->data == nullptr || tensor->buffer == nullptr || !ggml_is_contiguous(tensor)) {
+        return false;
+    }
+    const size_t nbytes = ggml_nbytes(tensor);
+    if (nbytes == 0) {
+        return false;
+    }
+    snapshot.tensor = tensor;
+    snapshot.nbytes = nbytes;
+
+    ggml_backend_buffer_t buffer = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    if (buffer == nullptr) {
+        return false;
+    }
+    if (ggml_backend_buffer_is_metal(buffer)) {
+        struct ggml_metal_buffer_id bid = ggml_metal_buffer_get_id(
+            (ggml_metal_buffer_t) buffer->context, tensor);
+        snapshot.metal = ggml_metal_encoder_snapshot_buffer(encoder, cmd_buf, bid, nbytes);
+        return snapshot.metal != nullptr;
+    }
+    if (ggml_backend_buffer_is_host(buffer)) {
+        snapshot.host_raw.resize(nbytes);
+        memcpy(snapshot.host_raw.data(), tensor->data, nbytes);
+        return true;
+    }
+    return false;
+}
+
+static bool verathos_metal_snapshot_raw(
+        verathos_metal_tensor_snapshot & snapshot,
+        std::vector<uint8_t> & raw) {
+    raw.clear();
+    if (snapshot.tensor == nullptr || snapshot.nbytes == 0) {
+        return false;
+    }
+    raw.resize(snapshot.nbytes);
+    if (snapshot.metal != nullptr) {
+        const bool ok = ggml_metal_trace_snapshot_read(snapshot.metal, raw.data(), snapshot.nbytes);
+        ggml_metal_trace_snapshot_free(snapshot.metal);
+        snapshot.metal = nullptr;
+        return ok;
+    }
+    if (snapshot.host_raw.size() == snapshot.nbytes) {
+        memcpy(raw.data(), snapshot.host_raw.data(), snapshot.nbytes);
+        return true;
+    }
+    return false;
+}
+
+static void verathos_metal_trace_after_encode(
+        void * user_data,
+        ggml_metal_encoder_t encoder,
+        ggml_metal_cmd_buf_t cmd_buf,
+        int graph_node_index,
+        const ggml_tensor * dst) {
+    GGML_UNUSED(user_data);
+    if (!verathos_metal_mul_mat_candidate(dst)) {
+        return;
+    }
+
+    verathos_metal_planned_snapshot planned;
+    bool should_capture = false;
+    {
+        std::lock_guard<std::mutex> lock(verathos_metal_snapshot_mutex);
+        for (auto it = verathos_metal_planned_snapshots.begin(); it != verathos_metal_planned_snapshots.end(); ++it) {
+            if (it->graph_node_index == graph_node_index) {
+                planned = *it;
+                verathos_metal_planned_snapshots.erase(it);
+                should_capture = true;
+                break;
+            }
+        }
+    }
+    if (!should_capture) {
+        return;
+    }
+
+    verathos_metal_snapshot_record record;
+    record.created_unix_ns = planned.created_unix_ns;
+    record.manifest_index = planned.manifest_index;
+    record.graph_seq = planned.graph_seq;
+    record.intra_graph_index = planned.intra_graph_index;
+    record.src0 = dst->src[0];
+    record.src1 = dst->src[1];
+    record.dst = dst;
+    record.skip_src0_dump = verathos_metal_env_bool("VERATHOS_GGML_TRACE_SKIP_SRC0_DUMP", false);
+
+    const bool ok =
+        (record.skip_src0_dump ||
+         verathos_metal_capture_tensor_snapshot(encoder, cmd_buf, record.src0, record.src0_snapshot)) &&
+        verathos_metal_capture_tensor_snapshot(encoder, cmd_buf, record.src1, record.src1_snapshot) &&
+        verathos_metal_capture_tensor_snapshot(encoder, cmd_buf, record.dst, record.dst_snapshot);
+    if (!ok) {
+        verathos_metal_release_snapshot_record(record);
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(verathos_metal_snapshot_mutex);
+    verathos_metal_snapshot_records.push_back(std::move(record));
+}
+
+static bool verathos_metal_plan_graph_trace(ggml_metal_t ctx, const ggml_cgraph * cgraph) {
+    verathos_metal_clear_snapshot_state();
+    if (ctx == nullptr || cgraph == nullptr || !verathos_metal_trace_enabled()) {
+        if (ctx != nullptr) {
+            ggml_metal_set_trace_callback(ctx, nullptr, nullptr);
+        }
+        return false;
+    }
+    const char * dir = verathos_metal_trace_dir();
+    if (dir == nullptr || dir[0] == '\0') {
+        ggml_metal_set_trace_callback(ctx, nullptr, nullptr);
+        return false;
+    }
+    verathos_metal_trace_mkdir(dir);
+
+    verathos_metal_graph_sequence++;
+    verathos_metal_intra_graph_index = 0;
+    verathos_metal_graph_dim_valid_ops = 0;
+    verathos_metal_graph_written_rows = 0;
+    verathos_metal_graph_max_src1_rows = 0;
+    // tail staging is per graph_compute call: entries hold node
+    // pointers that die with the previous graph, so a failed compute
+    // must never leak them into this one.
+    verathos_metal_tail_staging.clear();
+
+    std::vector<verathos_metal_planned_snapshot> planned;
+    const int64_t max_elems = verathos_metal_env_i64("VERATHOS_GGML_TRACE_MAX_ELEMS", 262144);
+    const int64_t max_snapshots = verathos_metal_trace_max_ops();
+    int64_t planned_snapshot_count = 0;
+
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * dst = cgraph->nodes[i];
+        if (!verathos_metal_mul_mat_candidate(dst)) {
+            continue;
+        }
+        const ggml_tensor * src0 = dst->src[0];
+        const ggml_tensor * src1 = dst->src[1];
+        // Intra-graph index counts every dim-valid MUL_MAT regardless of
+        // size eligibility, so it stays stable across batch row counts.
+        const int64_t intra_graph_index = verathos_metal_intra_graph_index++;
+        verathos_metal_graph_dim_valid_ops++;
+        if (src1->ne[1] > verathos_metal_graph_max_src1_rows) {
+            verathos_metal_graph_max_src1_rows = src1->ne[1];
+        }
+        const int64_t total_elems = ggml_nelements(src0) + ggml_nelements(src1) + ggml_nelements(dst);
+        const bool proof_eligible =
+            verathos_metal_is_decode_candidate(src0, src1, dst) ||
+            !(max_elems > 0 && total_elems > max_elems);
+        if (!proof_eligible) {
+            continue;
+        }
+
+        const int64_t now_ns = verathos_metal_unix_ns();
+        const int64_t manifest_index = ++verathos_metal_manifest_sequence;
+        verathos_metal_write_manifest_entry(
+            dir, now_ns, manifest_index, ggml_metal_get_name(ctx), true,
+            verathos_metal_graph_sequence, intra_graph_index, src0, src1, dst);
+        verathos_metal_graph_written_rows++;
+        verathos_metal_tail_stage(
+            src0, src1, dst,
+            (dst->flags & GGML_TENSOR_FLAG_OUTPUT) != 0,
+            verathos_metal_graph_sequence, intra_graph_index, manifest_index);
+
+        bool capture = false;
+        if (!verathos_metal_selected_ops.empty()) {
+            capture = verathos_metal_should_dump_selected_op_rows(
+                verathos_metal_graph_sequence, intra_graph_index,
+                src1 != nullptr ? src1->ne[1] : 0);
+        } else if (!verathos_metal_selected_manifest_indexes.empty()) {
+            capture = verathos_metal_manifest_index_selected(manifest_index);
+        } else if (max_snapshots < 0
+                   || verathos_metal_trace_sequence + planned_snapshot_count
+                          < max_snapshots) {
+            // Broad-capture budget is cumulative across the window (the CUDA
+            // hook's dumped_total contract). The per-graph counter alone let
+            // EVERY decode graph plan its full ~280 eligible ops forever:
+            // ~840 witness files per token for the whole generation, 6 tok/s
+            // serving on a machine that decodes this model at 48.
+            capture = true;
+        }
+        if (!capture) {
+            continue;
+        }
+        ++planned_snapshot_count;
+        planned.push_back({
+            /* .graph_node_index  = */ i,
+            /* .created_unix_ns   = */ now_ns,
+            /* .manifest_index    = */ manifest_index,
+            /* .graph_seq         = */ verathos_metal_graph_sequence,
+            /* .intra_graph_index = */ intra_graph_index,
+        });
+    }
+    verathos_metal_write_graph_marker(ggml_metal_get_name(ctx));
+    if (verathos_metal_manifest_stream.is_open()) {
+        verathos_metal_flush_manifest_buffer();
+        verathos_metal_manifest_stream.flush();
+    } else {
+        verathos_metal_flush_manifest_buffer();
+    }
+
+    const bool enabled = !planned.empty();
+    {
+        std::lock_guard<std::mutex> lock(verathos_metal_snapshot_mutex);
+        verathos_metal_planned_snapshots = std::move(planned);
+    }
+    ggml_metal_set_trace_callback(ctx, enabled ? verathos_metal_trace_after_encode : nullptr, nullptr);
+    return enabled;
+}
+
+static void verathos_metal_flush_snapshots(ggml_metal_t ctx) {
+    std::vector<verathos_metal_snapshot_record> records;
+    {
+        std::lock_guard<std::mutex> lock(verathos_metal_snapshot_mutex);
+        if (verathos_metal_snapshot_records.empty()) {
+            return;
+        }
+    }
+    ggml_metal_synchronize(ctx);
+    {
+        std::lock_guard<std::mutex> lock(verathos_metal_snapshot_mutex);
+        records.swap(verathos_metal_snapshot_records);
+    }
+
+    const char * dir = verathos_metal_trace_dir();
+    if (dir == nullptr || dir[0] == '\0') {
+        for (verathos_metal_snapshot_record & record : records) {
+            verathos_metal_release_snapshot_record(record);
+        }
+        return;
+    }
+
+    for (verathos_metal_snapshot_record & record : records) {
+        std::vector<uint8_t> src0_raw;
+        std::vector<uint8_t> src1_raw;
+        std::vector<uint8_t> dst_raw;
+        if ((!record.skip_src0_dump &&
+             !verathos_metal_snapshot_raw(record.src0_snapshot, src0_raw)) ||
+            !verathos_metal_snapshot_raw(record.src1_snapshot, src1_raw) ||
+            !verathos_metal_snapshot_raw(record.dst_snapshot, dst_raw)) {
+            verathos_metal_release_snapshot_record(record);
+            continue;
+        }
+
+        std::vector<float> src0_f32;
+        std::vector<float> src1_f32;
+        std::vector<float> dst_f32;
+        if ((!record.skip_src0_dump &&
+             !verathos_metal_raw_to_f32(record.src0, src0_raw, src0_f32)) ||
+            !verathos_metal_raw_to_f32(record.src1, src1_raw, src1_f32) ||
+            !verathos_metal_raw_to_f32(record.dst, dst_raw, dst_f32)) {
+            verathos_metal_release_snapshot_record(record);
+            continue;
+        }
+
+        ++verathos_metal_trace_sequence;
+        std::ostringstream prefix;
+        prefix << dir << "/trace-" << record.created_unix_ns << "-metal-op" << record.manifest_index;
+        const std::string src0_path = prefix.str() + "-src0.f32";
+        const std::string src0_raw_path = prefix.str() + "-src0.raw";
+        const std::string src1_path = prefix.str() + "-src1.f32";
+        const std::string dst_path  = prefix.str() + "-dst.f32";
+        const std::string json_path = prefix.str() + ".json";
+        if ((!record.skip_src0_dump && !verathos_metal_write_f32(src0_path, src0_f32)) ||
+            (!record.skip_src0_dump && !verathos_metal_write_raw(src0_raw_path, src0_raw)) ||
+            !verathos_metal_write_f32(src1_path, src1_f32) ||
+            !verathos_metal_write_f32(dst_path, dst_f32)) {
+            verathos_metal_release_snapshot_record(record);
+            continue;
+        }
+
+        std::ofstream meta(json_path);
+        if (!meta) {
+            verathos_metal_release_snapshot_record(record);
+            continue;
+        }
+        meta << "{\n";
+        meta << "  \"version\": 1,\n";
+        meta << "  \"created_unix_ns\": " << record.created_unix_ns << ",\n";
+        meta << "  \"manifest_index\": " << record.manifest_index << ",\n";
+        meta << "  \"graph_seq\": " << record.graph_seq << ",\n";
+        meta << "  \"intra_graph_index\": " << record.intra_graph_index << ",\n";
+        meta << "  \"graph_id\": \"metal-mul-mat-" << record.manifest_index << "\",\n";
+        meta << "  \"op_index\": " << record.manifest_index << ",\n";
+        meta << "  \"op_type\": \"GGML_OP_MUL_MAT\",\n";
+        meta << "  \"tensor_name\": \"" << verathos_metal_json_escape(record.src0->name) << "\",\n";
+        meta << "  \"src0_name\": \"" << verathos_metal_json_escape(record.src0->name) << "\",\n";
+        meta << "  \"src1_name\": \"" << verathos_metal_json_escape(record.src1->name) << "\",\n";
+        meta << "  \"dst_name\": \"" << verathos_metal_json_escape(record.dst->name) << "\",\n";
+        meta << "  \"src0_shape\": [" << record.src0->ne[0] << "," << record.src0->ne[1] << "," << record.src0->ne[2] << "," << record.src0->ne[3] << "],\n";
+        meta << "  \"src1_shape\": [" << record.src1->ne[0] << "," << record.src1->ne[1] << "," << record.src1->ne[2] << "," << record.src1->ne[3] << "],\n";
+        meta << "  \"dst_shape\": [" << record.dst->ne[0] << "," << record.dst->ne[1] << "," << record.dst->ne[2] << "," << record.dst->ne[3] << "],\n";
+        if (!record.skip_src0_dump) {
+            meta << "  \"src0_f32\": \"" << verathos_metal_filename(src0_path) << "\",\n";
+            meta << "  \"src0_raw\": \"" << verathos_metal_filename(src0_raw_path) << "\",\n";
+        }
+        meta << "  \"src0_raw_type\": \"" << ggml_type_name((ggml_type) record.src0->type) << "\",\n";
+        meta << "  \"src1_f32\": \"" << verathos_metal_filename(src1_path) << "\",\n";
+        meta << "  \"dst_f32\": \"" << verathos_metal_filename(dst_path) << "\",\n";
+        meta << "  \"source_types\": {\"src0\": \"" << ggml_type_name((ggml_type) record.src0->type)
+             << "\", \"src1\": \"" << ggml_type_name((ggml_type) record.src1->type)
+             << "\", \"dst\": \"" << ggml_type_name((ggml_type) record.dst->type) << "\"},\n";
+        meta << "  \"backend\": \"llama_cpp_metal\",\n";
+        meta << "  \"device\": \"" << verathos_metal_json_escape(ggml_metal_get_name(ctx)) << "\"\n";
+        meta << "}\n";
+        verathos_metal_release_snapshot_record(record);
+    }
+}
