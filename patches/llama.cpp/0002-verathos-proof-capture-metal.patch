+static bool verathos_metal_read_capture_token(const char * path, std::string & token) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        return false;
+    }
+    std::ostringstream out;
+    out << in.rdbuf();
+    token = out.str();
+    while (!token.empty() &&
+           (token.back() == '\n' || token.back() == '\r' || token.back() == ' ' || token.back() == '\t')) {
+        token.pop_back();
+    }
+    if (token.empty()) {
+        token = "present";
+    } else if (token.size() > 4095) {
+        token.resize(4095);
+    }
+    return true;
+}
+
+static void verathos_metal_parse_selected_manifest_indexes(const std::string & token) {
+    verathos_metal_selected_manifest_indexes.clear();
+    const std::string marker = "selected=";
+    size_t pos = token.find(marker);
+    if (pos == std::string::npos) {
+        return;
+    }
+    pos += marker.size();
+    while (pos < token.size() && verathos_metal_selected_manifest_indexes.size() < 64) {
+        while (pos < token.size() && (token[pos] == ' ' || token[pos] == '\t' || token[pos] == ',')) {
+            ++pos;
+        }
+        if (pos >= token.size() || token[pos] < '0' || token[pos] > '9') {
+            break;
+        }
+        size_t end = pos;
+        while (end < token.size() && token[end] >= '0' && token[end] <= '9') {
+            ++end;
+        }
+        try {
+            verathos_metal_selected_manifest_indexes.push_back(std::stoll(token.substr(pos, end - pos)));
+        } catch (...) {
+            break;
+        }
+        pos = end;
+    }
+}
+
+static void verathos_metal_parse_selected_ops(const std::string & token) {
+    verathos_metal_selected_ops.clear();
+    const std::string marker = "selected_v3=";
+    size_t pos = token.find(marker);
+    if (pos == std::string::npos) {
+        return;
+    }
+    pos += marker.size();
+    while (pos < token.size() && verathos_metal_selected_ops.size() < 64) {
+        while (pos < token.size() && (token[pos] == ' ' || token[pos] == '\t' || token[pos] == ',')) {
+            ++pos;
+        }
+        // '*' as the graph ordinal arms the intra for EVERY graph in the
+        // window (ord-agnostic), mirroring the CUDA hook: replay graph
+        // ordinals drift from the committed layout whenever the scheduler
+        // splits a pass, so exact ord:intra pairs miss the instances the
+        // audit needs. Dropping the '*' here instead emptied the whole
+        // selection and fell back to dump-everything - 6 tok/s serving.
+        bool wildcard_graph = false;
+        if (pos < token.size() && token[pos] == '*') {
+            wildcard_graph = true;
+        } else if (pos >= token.size() || token[pos] < '0' || token[pos] > '9') {
+            break;
+        }
+        size_t end = wildcard_graph ? pos + 1 : pos;
+        while (end < token.size() && token[end] >= '0' && token[end] <= '9') {
+            ++end;
+        }
+        if (end >= token.size() || token[end] != ':') {
+            break;
+        }
+        int64_t graph_value = 0;
+        int64_t intra_value = 0;
+        if (wildcard_graph) {
+            graph_value = -1;
+        } else {
+            try {
+                graph_value = std::stoll(token.substr(pos, end - pos));
+            } catch (...) {
+                break;
+            }
+        }
+        pos = end + 1;
+        end = pos;
+        while (end < token.size() && token[end] >= '0' && token[end] <= '9') {
+            ++end;
+        }
+        if (end == pos) {
+            break;
+        }
+        try {
+            intra_value = std::stoll(token.substr(pos, end - pos));
+        } catch (...) {
+            break;
+        }
+        verathos_metal_selected_ops.emplace_back(graph_value, intra_value);
+        pos = end;
+    }
+}
+
+static bool verathos_metal_should_dump_selected_op(int64_t graph_sequence, int64_t intra_index) {
+    for (const auto & item : verathos_metal_selected_ops) {
+        if (item.first == graph_sequence && item.second == intra_index) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Wildcard-armed dump decision, mirroring the CUDA hook: exact ord:intra
+// pairs dump any shape; '*'-armed intras dump only small-row instances
+// (decode steps), so a broad wildcard arming can never re-open the
+// dump-everything firehose on prefill graphs.
+static bool verathos_metal_should_dump_selected_op_rows(
+        int64_t graph_sequence, int64_t intra_index, int64_t src1_rows) {
+    for (const auto & item : verathos_metal_selected_ops) {
+        if (item.second != intra_index) {
+            continue;
+        }
+        if (item.first == graph_sequence) {
+            return true;
+        }
+        if (item.first < 0 && src1_rows <= 8) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool verathos_metal_should_dump_manifest_index(int64_t manifest_index) {
+    if (!verathos_metal_selected_manifest_indexes.empty()) {
+        for (int64_t selected : verathos_metal_selected_manifest_indexes) {
+            if (selected == manifest_index) {
+                return true;
+            }
+        }
+        return false;
+    }
+    const int64_t max_total = verathos_metal_trace_max_ops();
+    return max_total < 0 || verathos_metal_trace_sequence < max_total;
+}
