+static bool verathos_metal_trace_enabled() {
+    const char * dir = verathos_metal_trace_dir();
+    if (dir == nullptr || dir[0] == '\0') {
+        return false;
+    }
+    const char * enable_file = std::getenv("VERATHOS_GGML_TRACE_ENABLE_FILE");
+    if (enable_file != nullptr && enable_file[0] != '\0') {
+#if defined(_WIN32)
+        if (_access(enable_file, 0) != 0) {
+#else
+        if (access(enable_file, F_OK) != 0) {
+#endif
+            return false;
+        }
+        verathos_metal_refresh_capture_token(enable_file);
+    }
+    return true;
+}
