+static void verathos_metal_refresh_capture_token(const char * enable_file) {
+    std::string token;
+    if (!verathos_metal_read_capture_token(enable_file, token)) {
+        token = "present";
+    }
+    if (token != verathos_metal_trace_capture_token) {
+        verathos_metal_trace_capture_token = token;
+        verathos_metal_trace_sequence = 0;
+        verathos_metal_manifest_sequence = 0;
+        verathos_metal_graph_sequence = 0;
+        verathos_metal_intra_graph_index = 0;
+        verathos_metal_graph_dim_valid_ops = 0;
+        verathos_metal_graph_written_rows = 0;
+        verathos_metal_graph_max_src1_rows = 0;
+        verathos_metal_parse_selected_manifest_indexes(token);
+        verathos_metal_parse_selected_ops(token);
+        if (verathos_metal_manifest_stream.is_open()) {
+            verathos_metal_flush_manifest_buffer();
+            verathos_metal_manifest_stream.flush();
+            verathos_metal_manifest_stream.close();
+        }
+        verathos_metal_manifest_buffer.clear();
+        verathos_metal_manifest_path.clear();
+    }
+}
