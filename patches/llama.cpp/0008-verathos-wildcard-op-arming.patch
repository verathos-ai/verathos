+// Wildcard-armed dump decision: exact ord:intra pairs dump any shape;
+// '*'-armed intras dump only bounded eager-tail instances (decode steps and
+// teacher-forced proof probes) so an armed window cannot be made to dump whole
+// prefill activations for every graph.
+static bool verathos_cuda_should_dump_selected_op_rows(
+        int64_t graph_sequence, int64_t intra_index, int64_t src1_rows) {
+    for (const auto & item : verathos_cuda_selected_ops) {
+        if (item.second != intra_index) {
+            continue;
+        }
+        if (item.first == graph_sequence) {
+            return true;
+        }
+        if (item.first < 0 && src1_rows <= 32) {
+            return true;
+        }
+    }
+    return false;
+}
