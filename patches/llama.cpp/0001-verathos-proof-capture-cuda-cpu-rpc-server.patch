+static bool verathos_cpu_read_capture_token_uncached(const char * path, char * out, size_t out_size) {
+    if (out == NULL || out_size == 0) {
+        return false;
+    }
+    out[0] = '\0';
+    FILE * file = fopen(path, "rb");
+    if (file == NULL) {
+        return false;
+    }
+    size_t n = fread(out, 1, out_size - 1, file);
+    fclose(file);
+    while (n > 0 && (out[n - 1] == '\n' || out[n - 1] == '\r' || out[n - 1] == ' ' || out[n - 1] == '\t')) {
+        n--;
+    }
+    out[n] = '\0';
+    if (n == 0) {
+        snprintf(out, out_size, "present");
+    }
+    return true;
+}
+
+// Called once per graph_compute; a stat cache avoids the per-graph
+// open+read, which cost measurable decode throughput on a live mesh.
+#if defined(__APPLE__)
+#define verathos_st_mtim st_mtimespec
+#else
+#define verathos_st_mtim st_mtim
+#endif
+static bool verathos_cpu_read_capture_token(const char * path, char * out, size_t out_size) {
+#if !defined(_WIN32)
+    static bool cache_valid = false;
+    static dev_t cache_dev;
+    static ino_t cache_ino;
+    static off_t cache_size;
+    static struct timespec cache_mtim;
+    static char cache_token[4096];
+    struct stat st;
+    if (stat(path, &st) != 0) {
+        cache_valid = false;
+        return false;
+    }
+    if (cache_valid && st.st_dev == cache_dev && st.st_ino == cache_ino &&
+        st.st_size == cache_size &&
+        st.verathos_st_mtim.tv_sec == cache_mtim.tv_sec &&
+        st.verathos_st_mtim.tv_nsec == cache_mtim.tv_nsec) {
+        snprintf(out, out_size, "%s", cache_token);
+        return true;
+    }
+    if (!verathos_cpu_read_capture_token_uncached(path, out, out_size)) {
+        return false;
+    }
+    cache_valid = true;
+    cache_dev = st.st_dev;
+    cache_ino = st.st_ino;
+    cache_size = st.st_size;
+    cache_mtim = st.verathos_st_mtim;
+    snprintf(cache_token, sizeof(cache_token), "%s", out);
+    return true;
+#else
+    return verathos_cpu_read_capture_token_uncached(path, out, out_size);
+#endif
+}
