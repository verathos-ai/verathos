+    out << "\t" << now_ns;
+    out << "\t" << ++verathos_server_decode_seq;
+    out << "\t" << llama_n_ubatch(lctx);
+    out << "\t" << batch_view.n_tokens;
+    out << "\t";
+    for (int32_t j = 0; j < batch_view.n_tokens; ++j) {
+        if (j > 0) {
+            out << ",";
+        }
+        const llama_seq_id seq_id =
+            (batch_view.n_seq_id != nullptr && batch_view.n_seq_id[j] > 0 &&
+             batch_view.seq_id != nullptr && batch_view.seq_id[j] != nullptr)
+            ? batch_view.seq_id[j][0]
+            : 0;
+        out << seq_id << ":" << batch_view.pos[j] << ":"
+            << ((batch_view.logits != nullptr && batch_view.logits[j]) ? 1 : 0);
+    }
+    out << "\n";
+    out.flush();
