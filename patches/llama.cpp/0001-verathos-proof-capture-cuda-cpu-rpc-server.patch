+static bool verathos_cpu_tensor_to_f32(const struct ggml_tensor * tensor, float * out) {
+    if (tensor == NULL || tensor->data == NULL || out == NULL) {
+        return false;
+    }
+    if (!ggml_is_contiguous(tensor)) {
+        return false;
+    }
+    const int64_t n = ggml_nelements(tensor);
+    if (n <= 0) {
+        return false;
+    }
+    if (tensor->type == GGML_TYPE_F32) {
+        memcpy(out, tensor->data, (size_t) n * sizeof(float));
+        return true;
+    }
+    const struct ggml_type_traits * traits = ggml_get_type_traits(tensor->type);
+    if (traits == NULL || traits->to_float == NULL) {
+        return false;
+    }
+    traits->to_float(tensor->data, out, n);
+    return true;
+}
+
+static bool verathos_cpu_write_f32(const char * path, const float * values, int64_t n) {
+    FILE * out = fopen(path, "wb");
+    if (out == NULL) {
+        return false;
+    }
+    const size_t written = fwrite(values, sizeof(float), (size_t) n, out);
+    const int close_rc = fclose(out);
+    return written == (size_t) n && close_rc == 0;
+}
+
+static bool verathos_cpu_write_raw(const char * path, const void * data, size_t nbytes) {
+    FILE * out = fopen(path, "wb");
+    if (out == NULL) {
+        return false;
+    }
+    const size_t written = fwrite(data, 1, nbytes, out);
+    const int close_rc = fclose(out);
+    return written == nbytes && close_rc == 0;
+}
+
+static void verathos_cpu_json_escape(FILE * out, const char * raw) {
+    for (const char * p = raw == NULL ? "" : raw; *p != '\0'; ++p) {
+        switch (*p) {
+            case '\\': fputs("\\\\", out); break;
+            case '"':  fputs("\\\"", out); break;
+            case '\n': fputs("\\n", out); break;
+            case '\r': fputs("\\r", out); break;
+            case '\t': fputs("\\t", out); break;
+            default:   fputc(*p, out); break;
+        }
+    }
+}
+
+static void verathos_cpu_hex_escape(FILE * out, const char * raw) {
+    static const char * hex = "0123456789abcdef";
+    for (const unsigned char * p = (const unsigned char *)(raw == NULL ? "" : raw); *p != '\0'; ++p) {
+        fputc(hex[*p >> 4], out);
+        fputc(hex[*p & 0x0f], out);
+    }
+}
+
+static void verathos_cpu_compact_field(FILE * out, const char * raw) {
+    for (const char * p = raw == NULL ? "" : raw; *p != '\0'; ++p) {
+        if (*p == '\t' || *p == '\n' || *p == '\r') {
+            fputc(' ', out);
+        } else {
+            fputc(*p, out);
+        }
+    }
+}
+
+static bool verathos_cpu_manifest_compact(void) {
+    const char * raw = getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != NULL && (
+        strcmp(raw, "compact") == 0 ||
+        strcmp(raw, "compact-raw") == 0 ||
+        strcmp(raw, "compact-raw-v2") == 0 ||
+        strcmp(raw, "compact-raw-v3") == 0 ||
+        strcmp(raw, "raw") == 0 ||
+        strcmp(raw, "decode") == 0 ||
+        strcmp(raw, "decode-only") == 0);
+}
+
+static bool verathos_cpu_manifest_compact_raw(void) {
+    const char * raw = getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != NULL && (
+        strcmp(raw, "compact-raw") == 0 ||
+        strcmp(raw, "compact-raw-v2") == 0 ||
+        strcmp(raw, "compact-raw-v3") == 0 ||
+        strcmp(raw, "raw") == 0);
+}
+
+static bool verathos_cpu_manifest_v3(void) {
+    const char * raw = getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != NULL && strcmp(raw, "compact-raw-v3") == 0;
+}
+
+static bool verathos_cpu_manifest_disabled(void) {
+    const char * raw = getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != NULL && (
+        strcmp(raw, "none") == 0 ||
+        strcmp(raw, "off") == 0 ||
+        strcmp(raw, "0") == 0);
+}
+
+static bool verathos_cpu_manifest_decode_only(void) {
+    const char * raw = getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != NULL && (
+        strcmp(raw, "decode") == 0 ||
+        strcmp(raw, "decode-only") == 0);
+}
+
+static bool verathos_cpu_str_ends_with(const char * value, const char * suffix) {
+    const size_t value_len = strlen(value == NULL ? "" : value);
+    const size_t suffix_len = strlen(suffix == NULL ? "" : suffix);
+    return value_len >= suffix_len &&
+        strncmp(value + value_len - suffix_len, suffix, suffix_len) == 0;
+}
+
+static bool verathos_cpu_is_decode_candidate(
+        const struct ggml_tensor * src0,
+        const struct ggml_tensor * src1,
+        const struct ggml_tensor * dst) {
+    const char * tensor_name = src0 != NULL ? src0->name : "";
+    const char * src1_name = src1 != NULL ? src1->name : "";
+    const char * dst_name = dst != NULL ? dst->name : "";
+    if (strncmp(tensor_name, "output.weight", 14) == 0 ||
+        strncmp(tensor_name, "lm_head.weight", 15) == 0 ||
+        verathos_cpu_str_ends_with(tensor_name, ".lm_head.weight")) {
+        return true;
+    }
+    if (strstr(tensor_name, "attn_output") != NULL) {
+        return false;
+    }
+    return strncmp(dst_name, "logits", 7) == 0 ||
+        strncmp(dst_name, "result_output", 14) == 0 ||
+        (strstr(dst_name, "result_output") != NULL &&
+         (strstr(src1_name, "result_norm") != NULL ||
+          strstr(src1_name, "final") != NULL));
+}
+
+static void verathos_cpu_manifest_suffix(char * out, size_t out_size) {
+    if (out == NULL || out_size == 0) {
+        return;
+    }
+    out[0] = '\0';
+    size_t in = 0;
+    size_t n = 0;
+    const char * token = verathos_cpu_trace_capture_token;
+    while (token[in] >= '0' && token[in] <= '9' && n + 2 < out_size && in < 64) {
+        if (n == 0) {
+            out[n++] = '-';
+        }
+        out[n++] = token[in++];
+    }
+    out[n] = '\0';
+    if (n == 1) {
+        out[0] = '\0';
+    }
+}
+
+static FILE * verathos_cpu_manifest_for_capture(const char * dir) {
+    if (verathos_cpu_manifest_disabled()) {
+        return NULL;
+    }
+    char suffix[80];
+    char manifest_path[sizeof(verathos_cpu_manifest_path)];
+    verathos_cpu_manifest_suffix(suffix, sizeof(suffix));
+    snprintf(
+            manifest_path,
+            sizeof(manifest_path),
+            "%s/manifest%s.%s",
+            dir,
+            suffix,
+            verathos_cpu_manifest_compact() ? "vmanifest" : "jsonl");
+    if (verathos_cpu_manifest_file == NULL ||
+            strncmp(verathos_cpu_manifest_path, manifest_path, sizeof(verathos_cpu_manifest_path)) != 0) {
+        if (verathos_cpu_manifest_file != NULL) {
+            fflush(verathos_cpu_manifest_file);
+            fclose(verathos_cpu_manifest_file);
+        }
+        snprintf(verathos_cpu_manifest_path, sizeof(verathos_cpu_manifest_path), "%s", manifest_path);
+        verathos_cpu_manifest_file = fopen(verathos_cpu_manifest_path, "ab");
+    }
+    return verathos_cpu_manifest_file;
+}
+
+static void verathos_cpu_write_manifest_entry(
+        const char * dir,
+        int64_t now_ns,
+        int64_t manifest_index,
+        bool proof_eligible,
+        int64_t graph_sequence,
+        int64_t intra_graph_index,
+        const struct ggml_tensor * src0,
+        const struct ggml_tensor * src1,
+        const struct ggml_tensor * dst) {
+    if (verathos_cpu_manifest_decode_only() && !verathos_cpu_is_decode_candidate(src0, src1, dst)) {
+        return;
+    }
+    FILE * manifest = verathos_cpu_manifest_for_capture(dir);
+    if (manifest == NULL) {
+        return;
+    }
+    if (verathos_cpu_manifest_compact()) {
+        const bool raw_compact = verathos_cpu_manifest_compact_raw();
+        const char * manifest_format = getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+        const bool raw_compact_v3 = verathos_cpu_manifest_v3();
+        const bool raw_compact_v2 = raw_compact_v3 ||
+            (manifest_format != NULL && strcmp(manifest_format, "compact-raw-v2") == 0);
+        if (raw_compact_v2) {
+            fprintf(manifest, raw_compact_v3
+                    ? "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V3"
+                    : "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V2");
+            fprintf(manifest, "\t%lld", (long long) now_ns);
+            fprintf(manifest, "\t%lld", (long long) manifest_index);
+            fprintf(manifest, "\t"); verathos_cpu_compact_field(manifest, src0->name);
+            fprintf(manifest, "\t"); verathos_cpu_compact_field(manifest, src1->name);
+            fprintf(manifest, "\t"); verathos_cpu_compact_field(manifest, dst->name);
+            fprintf(manifest, "\t%lld,%lld,%lld,%lld",
+                    (long long) src0->ne[0], (long long) src0->ne[1],
+                    (long long) src0->ne[2], (long long) src0->ne[3]);
+            fprintf(manifest, "\t%lld,%lld,%lld,%lld",
+                    (long long) src1->ne[0], (long long) src1->ne[1],
+                    (long long) src1->ne[2], (long long) src1->ne[3]);
+            fprintf(manifest, "\t%lld,%lld,%lld,%lld",
+                    (long long) dst->ne[0], (long long) dst->ne[1],
+                    (long long) dst->ne[2], (long long) dst->ne[3]);
+            fprintf(manifest, "\t%s\t%s\t%s",
+                    ggml_type_name(src0->type), ggml_type_name(src1->type), ggml_type_name(dst->type));
+            fprintf(manifest, "\tllama_cpp_cpu\tCPU");
+            fprintf(manifest, "\t%s", proof_eligible ? "1" : "0");
+            if (raw_compact_v3) {
+                fprintf(manifest, "\t%lld\t%lld",
+                        (long long) graph_sequence, (long long) intra_graph_index);
+            }
+            fprintf(manifest, "\n");
+            fflush(manifest);
+            return;
+        }
+        fprintf(manifest, "%s", raw_compact ? "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V1" : "VERATHOS_GGML_OP_MANIFEST_COMPACT_V1");
+        fprintf(manifest, "\t%lld", (long long) now_ns);
+        fprintf(manifest, "\t%lld", (long long) manifest_index);
+        fprintf(manifest, "\t");
+        char graph_id[96];
+        snprintf(graph_id, sizeof(graph_id), "cpu-mul-mat-%lld", (long long) manifest_index);
+        if (raw_compact) { verathos_cpu_compact_field(manifest, graph_id); } else { verathos_cpu_hex_escape(manifest, graph_id); }
+        fprintf(manifest, "\t%lld", (long long) manifest_index);
+        fprintf(manifest, "\t"); if (raw_compact) { verathos_cpu_compact_field(manifest, src0->name); } else { verathos_cpu_hex_escape(manifest, src0->name); }
+        fprintf(manifest, "\t"); if (raw_compact) { verathos_cpu_compact_field(manifest, src0->name); } else { verathos_cpu_hex_escape(manifest, src0->name); }
+        fprintf(manifest, "\t"); if (raw_compact) { verathos_cpu_compact_field(manifest, src1->name); } else { verathos_cpu_hex_escape(manifest, src1->name); }
+        fprintf(manifest, "\t"); if (raw_compact) { verathos_cpu_compact_field(manifest, dst->name); } else { verathos_cpu_hex_escape(manifest, dst->name); }
+        fprintf(manifest, "\t%lld,%lld,%lld,%lld",
+                (long long) src0->ne[0], (long long) src0->ne[1],
+                (long long) src0->ne[2], (long long) src0->ne[3]);
+        fprintf(manifest, "\t%lld,%lld,%lld,%lld",
+                (long long) src1->ne[0], (long long) src1->ne[1],
+                (long long) src1->ne[2], (long long) src1->ne[3]);
+        fprintf(manifest, "\t%lld,%lld,%lld,%lld",
+                (long long) dst->ne[0], (long long) dst->ne[1],
+                (long long) dst->ne[2], (long long) dst->ne[3]);
+        fprintf(manifest, "\t%s\t%s\t%s",
+                ggml_type_name(src0->type), ggml_type_name(src1->type), ggml_type_name(dst->type));
+        fprintf(manifest, "\t"); if (raw_compact) { verathos_cpu_compact_field(manifest, "llama_cpp_cpu"); } else { verathos_cpu_hex_escape(manifest, "llama_cpp_cpu"); }
+        fprintf(manifest, "\t"); if (raw_compact) { verathos_cpu_compact_field(manifest, "CPU"); } else { verathos_cpu_hex_escape(manifest, "CPU"); }
+        fprintf(manifest, "\t%s\n", proof_eligible ? "1" : "0");
+        fflush(manifest);
+        return;
+    }
+    fprintf(manifest, "{\"version\":1");
+    fprintf(manifest, ",\"created_unix_ns\":%lld", (long long) now_ns);
+    fprintf(manifest, ",\"manifest_index\":%lld", (long long) manifest_index);
+    fprintf(manifest, ",\"graph_id\":\"cpu-mul-mat-%lld\"", (long long) manifest_index);
+    fprintf(manifest, ",\"op_index\":%lld", (long long) manifest_index);
