+static void verathos_server_write_batch_record(
+        llama_context * lctx,
+        const llama_batch & batch_view) {
+    // Runs once per ubatch, i.e. once per decoded token: the original
+    // getenv + open/read + open/append/close cycle here cost measurable
+    // decode throughput on a live 4090 mesh. Env is fixed at spawn; the
+    // enable token only changes when the arming side rewrites the file
+    // (observed via stat), and the output stream persists per path.
+    static const char * dir = std::getenv("VERATHOS_GGML_TRACE_DIR");
+    if (dir == nullptr || dir[0] == '\0') {
+        return;
+    }
+    static const char * enable_file = std::getenv("VERATHOS_GGML_TRACE_ENABLE_FILE");
+    if (enable_file == nullptr || enable_file[0] == '\0') {
+        return;
