+static void verathos_try_dump_mul_mat_trace(
+        uint32_t device,
+        const ggml_cgraph * graph,
+        int64_t graph_sequence) {
+    if (!verathos_rpc_graph_trace_enabled()) {
+        return;
+    }
+    const char * dir_raw = verathos_trace_dir();
+    if (!dir_raw || dir_raw[0] == '\0') {
+        return;
+    }
+    const int64_t max_ops = verathos_env_i64("VERATHOS_GGML_TRACE_MAX_OPS_PER_GRAPH", 1);
+    if (max_ops <= 0) {
+        return;
+    }
+    if (!verathos_rpc_capture_window_active()) {
+        return;
+    }
+    const int64_t max_total = verathos_env_i64("VERATHOS_GGML_TRACE_MAX_OPS_PER_CAPTURE", 8);
+    if (max_total > 0 && verathos_rpc_dumped_total >= max_total) {
+        return;
