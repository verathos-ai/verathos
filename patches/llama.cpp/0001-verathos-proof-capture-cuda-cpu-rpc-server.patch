+static void verathos_cpu_try_dump_mul_mat_trace(const struct ggml_tensor * dst) {
+    const char * dir = verathos_cpu_trace_dir();
+    if (dir == NULL || dir[0] == '\0' || dst == NULL || dst->op != GGML_OP_MUL_MAT) {
+        return;
+    }
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+    if (src0 == NULL || src1 == NULL) {
+        return;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 ||
+        src1->ne[2] != 1 || src1->ne[3] != 1 ||
+        dst->ne[2]  != 1 || dst->ne[3]  != 1) {
+        return;
+    }
+    if (src0->ne[0] != src1->ne[0] ||
+        dst->ne[0]  != src0->ne[1] ||
+        dst->ne[1]  != src1->ne[1]) {
+        return;
+    }
+
+    // Intra-graph index counts every dim-valid MUL_MAT regardless of size
+    // eligibility, so it stays stable across batch row counts (co-batched
+    // organic graphs vs solo replay graphs address the same structural op).
+    const int64_t intra_graph_index = verathos_cpu_intra_graph_index++;
+    verathos_cpu_graph_dim_valid_ops++;
+    if (src1->ne[1] > verathos_cpu_graph_max_src1_rows) {
+        verathos_cpu_graph_max_src1_rows = src1->ne[1];
+    }
+
+    verathos_cpu_trace_mkdir(dir);
+    const int64_t now_ns = verathos_cpu_unix_ns();
+    const int64_t manifest_index = ++verathos_cpu_manifest_sequence;
+    const int64_t src0_ne = ggml_nelements(src0);
+    const int64_t src1_ne = ggml_nelements(src1);
+    const int64_t dst_ne  = ggml_nelements(dst);
+    const int64_t total_elems = src0_ne + src1_ne + dst_ne;
+    const int64_t max_elems = verathos_cpu_env_i64("VERATHOS_GGML_TRACE_MAX_ELEMS", 262144);
+    const bool proof_eligible =
+        verathos_cpu_is_decode_candidate(src0, src1, dst) ||
+        !(max_elems > 0 && total_elems > max_elems);
+    if (!proof_eligible) {
+        return;
+    }
+    verathos_cpu_write_manifest_entry(
+            dir, now_ns, manifest_index, proof_eligible,
+            verathos_cpu_graph_sequence, intra_graph_index, src0, src1, dst);
+    verathos_cpu_graph_written_rows++;
+
+    const bool selected_op_dump = verathos_cpu_selected_ops_count > 0 &&
+        verathos_cpu_should_dump_selected_op(verathos_cpu_graph_sequence, intra_graph_index);
+    if (!selected_op_dump && verathos_cpu_selected_ops_count > 0) {
+        return;
+    }
+    if (!selected_op_dump && !verathos_cpu_should_dump_manifest_index(manifest_index)) {
+        return;
+    }
+    const bool skip_src0_dump = verathos_cpu_env_bool("VERATHOS_GGML_TRACE_SKIP_SRC0_DUMP", false);
+    float * src0_f32 = skip_src0_dump ? NULL : (float *) malloc((size_t) src0_ne * sizeof(float));
+    float * src1_f32 = (float *) malloc((size_t) src1_ne * sizeof(float));
+    float * dst_f32  = (float *) malloc((size_t) dst_ne  * sizeof(float));
+    if ((!skip_src0_dump && src0_f32 == NULL) || src1_f32 == NULL || dst_f32 == NULL) {
+        free(src0_f32);
+        free(src1_f32);
+        free(dst_f32);
+        return;
+    }
+    if ((!skip_src0_dump && !verathos_cpu_tensor_to_f32(src0, src0_f32)) ||
+        !verathos_cpu_tensor_to_f32(src1, src1_f32) ||
+        !verathos_cpu_tensor_to_f32(dst, dst_f32)) {
+        free(src0_f32);
+        free(src1_f32);
+        free(dst_f32);
+        return;
+    }
+
+    char base[4096];
+    char src0_path[8192];
+    char src0_raw_path[8192];
+    char src1_path[8192];
+    char dst_path[8192];
+    char json_path[8192];
+    snprintf(base, sizeof(base), "%s/trace-%lld-cpu-op%lld",
+             dir, (long long) now_ns, (long long) manifest_index);
+    snprintf(src0_path, sizeof(src0_path), "%s-src0.f32", base);
+    snprintf(src0_raw_path, sizeof(src0_raw_path), "%s-src0.raw", base);
+    snprintf(src1_path, sizeof(src1_path), "%s-src1.f32", base);
+    snprintf(dst_path,  sizeof(dst_path),  "%s-dst.f32",  base);
+    snprintf(json_path, sizeof(json_path), "%s.json",     base);
+    if ((!skip_src0_dump && !verathos_cpu_write_f32(src0_path, src0_f32, src0_ne)) ||
+        (!skip_src0_dump && !verathos_cpu_write_raw(src0_raw_path, src0->data, ggml_nbytes(src0))) ||
+        !verathos_cpu_write_f32(src1_path, src1_f32, src1_ne) ||
+        !verathos_cpu_write_f32(dst_path,  dst_f32,  dst_ne)) {
+        free(src0_f32);
+        free(src1_f32);
+        free(dst_f32);
+        return;
+    }
+    free(src0_f32);
+    free(src1_f32);
+    free(dst_f32);
+
+    FILE * meta = fopen(json_path, "wb");
+    if (meta == NULL) {
+        return;
+    }
+    fprintf(meta, "{\n");
+    fprintf(meta, "  \"version\": 1,\n");
+    fprintf(meta, "  \"created_unix_ns\": %lld,\n", (long long) now_ns);
+    fprintf(meta, "  \"manifest_index\": %lld,\n", (long long) manifest_index);
+    fprintf(meta, "  \"graph_seq\": %lld,\n", (long long) verathos_cpu_graph_sequence);
+    fprintf(meta, "  \"intra_graph_index\": %lld,\n", (long long) intra_graph_index);
+    fprintf(meta, "  \"graph_id\": \"cpu-mul-mat-%lld\",\n", (long long) manifest_index);
+    fprintf(meta, "  \"op_index\": %lld,\n", (long long) manifest_index);
+    fprintf(meta, "  \"op_type\": \"GGML_OP_MUL_MAT\",\n");
+    fprintf(meta, "  \"tensor_name\": \"");
+    verathos_cpu_json_escape(meta, src0->name);
+    fprintf(meta, "\",\n");
+    fprintf(meta, "  \"src0_name\": \"");
+    verathos_cpu_json_escape(meta, src0->name);
+    fprintf(meta, "\",\n");
+    fprintf(meta, "  \"src1_name\": \"");
+    verathos_cpu_json_escape(meta, src1->name);
+    fprintf(meta, "\",\n");
+    fprintf(meta, "  \"dst_name\": \"");
+    verathos_cpu_json_escape(meta, dst->name);
+    fprintf(meta, "\",\n");
+    fprintf(meta, "  \"src0_shape\": [%lld,%lld,%lld,%lld],\n",
+            (long long) src0->ne[0], (long long) src0->ne[1],
+            (long long) src0->ne[2], (long long) src0->ne[3]);
+    fprintf(meta, "  \"src1_shape\": [%lld,%lld,%lld,%lld],\n",
+            (long long) src1->ne[0], (long long) src1->ne[1],
+            (long long) src1->ne[2], (long long) src1->ne[3]);
+    fprintf(meta, "  \"dst_shape\": [%lld,%lld,%lld,%lld],\n",
+            (long long) dst->ne[0], (long long) dst->ne[1],
+            (long long) dst->ne[2], (long long) dst->ne[3]);
+    const char * src0_file = strrchr(src0_path, '/');
+    const char * src0_raw_file = strrchr(src0_raw_path, '/');
+    const char * src1_file = strrchr(src1_path, '/');
+    const char * dst_file  = strrchr(dst_path,  '/');
+#if defined(_WIN32)
+    const char * src0_file_win = strrchr(src0_path, '\\');
+    const char * src0_raw_file_win = strrchr(src0_raw_path, '\\');
+    const char * src1_file_win = strrchr(src1_path, '\\');
+    const char * dst_file_win  = strrchr(dst_path,  '\\');
+    if (src0_file_win != NULL && (src0_file == NULL || src0_file_win > src0_file)) src0_file = src0_file_win;
+    if (src0_raw_file_win != NULL && (src0_raw_file == NULL || src0_raw_file_win > src0_raw_file)) src0_raw_file = src0_raw_file_win;
+    if (src1_file_win != NULL && (src1_file == NULL || src1_file_win > src1_file)) src1_file = src1_file_win;
+    if (dst_file_win  != NULL && (dst_file  == NULL || dst_file_win  > dst_file))  dst_file  = dst_file_win;
+#endif
+    if (!skip_src0_dump) {
+        fprintf(meta, "  \"src0_f32\": \"%s\",\n", src0_file == NULL ? src0_path : src0_file + 1);
+        fprintf(meta, "  \"src0_raw\": \"%s\",\n", src0_raw_file == NULL ? src0_raw_path : src0_raw_file + 1);
+    }
+    fprintf(meta, "  \"src0_raw_type\": \"%s\",\n", ggml_type_name(src0->type));
+    fprintf(meta, "  \"src1_f32\": \"%s\",\n", src1_file == NULL ? src1_path : src1_file + 1);
+    fprintf(meta, "  \"dst_f32\": \"%s\",\n",  dst_file  == NULL ? dst_path  : dst_file  + 1);
+    fprintf(meta, "  \"source_types\": {\"src0\": \"%s\", \"src1\": \"%s\", \"dst\": \"%s\"},\n",
+            ggml_type_name(src0->type), ggml_type_name(src1->type), ggml_type_name(dst->type));
+    fprintf(meta, "  \"backend\": \"llama_cpp_cpu\",\n");
+    fprintf(meta, "  \"device\": \"CPU\"\n");
+    fprintf(meta, "}\n");
+    fclose(meta);
+}
+
+static void verathos_cpu_trace_begin_graph(void) {
+    if (!verathos_cpu_trace_enabled()) {
+        return;
+    }
+    verathos_cpu_graph_sequence++;
+    verathos_cpu_intra_graph_index = 0;
+    verathos_cpu_graph_dim_valid_ops = 0;
+    verathos_cpu_graph_written_rows = 0;
+    verathos_cpu_graph_max_src1_rows = 0;
+}
+
+static void verathos_cpu_trace_end_graph(void) {
+    if (verathos_cpu_graph_dim_valid_ops <= 0) {
+        return;
+    }
+    const char * dir = verathos_cpu_trace_dir();
+    if (dir == NULL || dir[0] == '\0' || !verathos_cpu_manifest_v3()) {
+        return;
+    }
+    FILE * manifest = verathos_cpu_manifest_for_capture(dir);
+    if (manifest == NULL) {
+        return;
+    }
+    fprintf(manifest, "VERATHOS_GGML_GRAPH_V1\t%lld\t%lld\t%lld\t%lld\t%lld\tllama_cpp_cpu\tCPU\n",
+            (long long) verathos_cpu_unix_ns(),
+            (long long) verathos_cpu_graph_sequence,
+            (long long) verathos_cpu_graph_dim_valid_ops,
+            (long long) verathos_cpu_graph_written_rows,
+            (long long) verathos_cpu_graph_max_src1_rows);
+    fflush(manifest);
+}
+
+static void verathos_cpu_trace_after_mul_mat(
+        const struct ggml_compute_params * params,
+        const struct ggml_tensor * dst) {
+    if (!verathos_cpu_trace_enabled()) {
+        return;
+    }
+    if (params->threadpool != NULL && params->nth > 1) {
+        ggml_barrier(params->threadpool);
+    }
+    if (params->ith == 0) {
+        verathos_cpu_try_dump_mul_mat_trace(dst);
+    }
+    if (params->threadpool != NULL && params->nth > 1) {
+        ggml_barrier(params->threadpool);
+    }
+}
