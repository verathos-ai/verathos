+    {
+        namespace fs = std::filesystem;
+        std::error_code ec;
+        const auto status_size = fs::file_size(enable_file, ec);
+        if (ec) {
+            cache.valid = false;
+            return;
+        }
+        const auto mtime = fs::last_write_time(enable_file, ec);
+        if (ec) {
+            cache.valid = false;
+            return;
+        }
+        const long long mtime_ns =
+            (long long) mtime.time_since_epoch().count();
+        if (!cache.valid || cache.size != (long long) status_size ||
+            cache.mtime_ns != mtime_ns) {
+            std::ifstream enable(enable_file, std::ios::binary);
+            if (!enable) {
+                cache.valid = false;
+                return;
+            }
+            std::getline(enable, cache.token);
+            cache.size = (long long) status_size;
+            cache.mtime_ns = mtime_ns;
+            cache.valid = true;
+        }
