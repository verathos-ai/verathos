+static void verathos_cpu_refresh_capture_token(const char * enable_file) {
+    char token[sizeof(verathos_cpu_trace_capture_token)];
+    if (!verathos_cpu_read_capture_token(enable_file, token, sizeof(token))) {
+        snprintf(token, sizeof(token), "present");
+    }
+    if (strncmp(verathos_cpu_trace_capture_token, token, sizeof(verathos_cpu_trace_capture_token)) != 0) {
+        snprintf(verathos_cpu_trace_capture_token, sizeof(verathos_cpu_trace_capture_token), "%s", token);
+        verathos_cpu_trace_sequence = 0;
+        verathos_cpu_manifest_sequence = 0;
+        verathos_cpu_graph_sequence = 0;
+        verathos_cpu_intra_graph_index = 0;
+        verathos_cpu_graph_dim_valid_ops = 0;
+        verathos_cpu_graph_written_rows = 0;
+        verathos_cpu_graph_max_src1_rows = 0;
+        verathos_cpu_parse_selected_manifest_indexes(token);
+        verathos_cpu_parse_selected_ops(token);
+        if (verathos_cpu_manifest_file != NULL) {
+            fflush(verathos_cpu_manifest_file);
+            fclose(verathos_cpu_manifest_file);
+            verathos_cpu_manifest_file = NULL;
+        }
+        verathos_cpu_manifest_path[0] = '\0';
+    }
+}
