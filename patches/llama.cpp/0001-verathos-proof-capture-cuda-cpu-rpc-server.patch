+static bool verathos_cuda_read_capture_token(const char * path, std::string & token) {
+#if !defined(_WIN32)
+    // Called once per graph_compute; on a live 4090 mesh the per-graph
+    // open+read cost measurable decode throughput. stat() is an order of
+    // magnitude cheaper and observes every rewrite via inode/size/mtime.
+    static struct {
+        bool valid;
+        dev_t dev;
+        ino_t ino;
+        off_t size;
+        struct timespec mtim;
+        std::string token;
+    } cache = {};
+    struct stat st;
+    if (::stat(path, &st) != 0) {
+        cache.valid = false;
+        return false;
+    }
+    if (cache.valid && st.st_dev == cache.dev && st.st_ino == cache.ino &&
+        st.st_size == cache.size &&
+        st.verathos_st_mtim.tv_sec == cache.mtim.tv_sec &&
+        st.verathos_st_mtim.tv_nsec == cache.mtim.tv_nsec) {
