+    }
+#if !defined(_WIN32)
+    cache.valid = true;
+    cache.dev = st.st_dev;
+    cache.ino = st.st_ino;
+    cache.size = st.st_size;
+    cache.mtim = st.verathos_st_mtim;
+    cache.token = token;
+#endif
+    return true;
+}
+
+static void verathos_cuda_parse_selected_manifest_indexes(const std::string & token) {
+    verathos_cuda_selected_manifest_indexes.clear();
+    const std::string marker = "selected=";
+    size_t pos = token.find(marker);
+    if (pos == std::string::npos) {
+        return;
+    }
+    pos += marker.size();
+    while (pos < token.size() && verathos_cuda_selected_manifest_indexes.size() < 64) {
+        while (pos < token.size() && (token[pos] == ' ' || token[pos] == '\t' || token[pos] == ',')) {
+            ++pos;
+        }
+        if (pos >= token.size() || token[pos] < '0' || token[pos] > '9') {
+            break;
+        }
+        size_t end = pos;
+        while (end < token.size() && token[end] >= '0' && token[end] <= '9') {
+            ++end;
+        }
+        try {
+            verathos_cuda_selected_manifest_indexes.push_back(std::stoll(token.substr(pos, end - pos)));
+        } catch (...) {
+            break;
+        }
+        pos = end;
+    }
+}
+
+static void verathos_cuda_parse_selected_ops(const std::string & token) {
+    verathos_cuda_selected_ops.clear();
+    const std::string marker = "selected_v3=";
+    size_t pos = token.find(marker);
+    if (pos == std::string::npos) {
+        return;
+    }
+    pos += marker.size();
+    while (pos < token.size() && verathos_cuda_selected_ops.size() < 64) {
+        while (pos < token.size() && (token[pos] == ' ' || token[pos] == '\t' || token[pos] == ',')) {
+            ++pos;
+        }
+        if (pos >= token.size() || token[pos] < '0' || token[pos] > '9') {
+            break;
+        }
+        size_t end = pos;
+        while (end < token.size() && token[end] >= '0' && token[end] <= '9') {
+            ++end;
+        }
+        if (end >= token.size() || token[end] != ':') {
+            break;
+        }
+        int64_t graph_value = 0;
+        int64_t intra_value = 0;
+        try {
+            graph_value = std::stoll(token.substr(pos, end - pos));
+        } catch (...) {
+            break;
+        }
+        pos = end + 1;
+        end = pos;
+        while (end < token.size() && token[end] >= '0' && token[end] <= '9') {
+            ++end;
+        }
+        if (end == pos) {
+            break;
+        }
+        try {
+            intra_value = std::stoll(token.substr(pos, end - pos));
+        } catch (...) {
+            break;
+        }
+        verathos_cuda_selected_ops.emplace_back(graph_value, intra_value);
+        pos = end;
+    }
+}
+
+static bool verathos_cuda_should_dump_selected_op(int64_t graph_sequence, int64_t intra_index) {
+    for (const auto & item : verathos_cuda_selected_ops) {
+        if (item.first == graph_sequence && item.second == intra_index) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool verathos_cuda_should_dump_manifest_index(int64_t manifest_index) {
+    if (!verathos_cuda_selected_manifest_indexes.empty()) {
+        for (int64_t selected : verathos_cuda_selected_manifest_indexes) {
+            if (selected == manifest_index) {
+                return true;
+            }
+        }
+        return false;
+    }
+    const int64_t max_total = verathos_cuda_trace_max_ops();
+    return max_total < 0 || verathos_cuda_trace_sequence < max_total;
+}
+
+static void verathos_cuda_write_graph_marker(int device);
+
+static void verathos_cuda_flush_manifest_buffer() {
+    if (!verathos_cuda_manifest_buffer.empty() && verathos_cuda_manifest_stream.is_open()) {
+        verathos_cuda_manifest_stream << verathos_cuda_manifest_buffer;
+        verathos_cuda_manifest_buffer.clear();
+    }
+}
+
+static void verathos_cuda_refresh_capture_token(const char * enable_file) {
+    std::string token;
+    if (!verathos_cuda_read_capture_token(enable_file, token)) {
+        token = "present";
+    }
+    if (token != verathos_cuda_trace_capture_token) {
+        verathos_cuda_trace_capture_token = token;
+        verathos_cuda_trace_sequence = 0;
+        verathos_cuda_manifest_sequence = 0;
+        verathos_cuda_graph_sequence = 0;
+        verathos_cuda_intra_graph_index = 0;
+        verathos_cuda_graph_dim_valid_ops = 0;
+        verathos_cuda_graph_written_rows = 0;
+        verathos_cuda_mmid_dumped = 0;
+        verathos_cuda_graph_max_src1_rows = 0;
+        verathos_cuda_parse_selected_manifest_indexes(token);
+        verathos_cuda_parse_selected_ops(token);
+        if (verathos_cuda_manifest_stream.is_open()) {
+            verathos_cuda_flush_manifest_buffer();
+            verathos_cuda_manifest_stream.flush();
+            verathos_cuda_manifest_stream.close();
+        }
+        verathos_cuda_manifest_buffer.clear();
+        verathos_cuda_manifest_path.clear();
+    }
+}
+
+static bool verathos_cuda_prepare_trace_for_graph() {
+    const char * dir = verathos_cuda_trace_dir();
+    if (dir == nullptr || dir[0] == '\0') {
+        verathos_cuda_trace_active_for_graph = false;
+        return false;
+    }
+    const char * enable_file = std::getenv("VERATHOS_GGML_TRACE_ENABLE_FILE");
+    if (enable_file != nullptr && enable_file[0] != '\0') {
+#if defined(_WIN32)
+        if (_access(enable_file, 0) != 0) {
+#else
+        if (access(enable_file, F_OK) != 0) {
+#endif
+            verathos_cuda_trace_active_for_graph = false;
+            return false;
+        }
+        verathos_cuda_refresh_capture_token(enable_file);
+    }
+    verathos_cuda_trace_mkdir(dir);
+    verathos_cuda_trace_active_for_graph = true;
+    verathos_cuda_graph_sequence++;
+    verathos_cuda_intra_graph_index = 0;
+    verathos_cuda_graph_dim_valid_ops = 0;
+    verathos_cuda_graph_written_rows = 0;
+    verathos_cuda_mmid_dumped = 0;
+    verathos_cuda_graph_max_src1_rows = 0;
+    return true;
+}
+
+static bool verathos_cuda_trace_enabled() {
+    return verathos_cuda_trace_active_for_graph;
+}
+
+static int64_t verathos_cuda_unix_ns() {
+    using namespace std::chrono;
+    return duration_cast<nanoseconds>(system_clock::now().time_since_epoch()).count();
+}
+
+static void verathos_cuda_trace_mkdir(const char * dir) {
+    if (dir == nullptr || dir[0] == '\0') {
+        return;
+    }
+#if defined(_WIN32)
+    _mkdir(dir);
+#else
+    mkdir(dir, 0755);
+#endif
+}
+
+static std::string verathos_cuda_json_escape(const char * raw) {
+    std::ostringstream out;
+    for (const char * p = raw ? raw : ""; *p; ++p) {
+        switch (*p) {
+            case '\\': out << "\\\\"; break;
+            case '"': out << "\\\""; break;
+            case '\n': out << "\\n"; break;
+            case '\r': out << "\\r"; break;
+            case '\t': out << "\\t"; break;
+            default: out << *p; break;
+        }
+    }
+    return out.str();
+}
+
+static std::string verathos_cuda_hex_escape(const char * raw) {
+    static const char * hex = "0123456789abcdef";
+    std::string out;
+    for (const unsigned char * p = reinterpret_cast<const unsigned char *>(raw ? raw : ""); *p; ++p) {
+        out.push_back(hex[*p >> 4]);
+        out.push_back(hex[*p & 0x0f]);
+    }
+    return out;
+}
+
+static std::string verathos_cuda_compact_field(const char * raw) {
+    std::string out(raw ? raw : "");
+    for (char & ch : out) {
+        if (ch == '\t' || ch == '\n' || ch == '\r') {
+            ch = ' ';
+        }
+    }
+    return out;
+}
+
+static bool verathos_cuda_manifest_v3() {
+    static const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && std::string(raw) == "compact-raw-v3";
+}
+
+static bool verathos_cuda_manifest_compact() {
+    static const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "compact" ||
+        std::string(raw) == "compact-raw" ||
+        std::string(raw) == "compact-raw-v2" ||
+        std::string(raw) == "compact-raw-v3" ||
+        std::string(raw) == "raw" ||
+        std::string(raw) == "decode" ||
+        std::string(raw) == "decode-only");
+}
+
+static bool verathos_cuda_manifest_compact_raw() {
+    static const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "compact-raw" ||
+        std::string(raw) == "compact-raw-v2" ||
+        std::string(raw) == "compact-raw-v3" ||
+        std::string(raw) == "raw");
+}
+
+static bool verathos_cuda_manifest_disabled() {
+    static const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "none" ||
+        std::string(raw) == "off" ||
+        std::string(raw) == "0");
+}
+
+// True while this capture window still has trace work that requires the
+// unfused op stream: pending selected-op/manifest-index dumps (exclusive
+// replay windows), per-op manifest emission, or remaining candidate-dump
+// budget. Once the candidate budget is exhausted (manifest disabled),
+// fused kernels can resume — the rest of the request runs at native speed.
+static bool verathos_cuda_capture_work_pending();
+
+static bool verathos_cuda_manifest_decode_only() {
+    static const char * raw = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+    return raw != nullptr && (
+        std::string(raw) == "decode" ||
+        std::string(raw) == "decode-only");
+}
+
+// True only while an exclusive replay window with SELECTED op/index dumps is
+// armed. Ordinary serve windows (shared capture, manifest rows) must NOT
+// match: rows and graph markers are emitted at graph level and never need the
+// eager op stream, while selected witness dumps do.
+static bool verathos_cuda_selected_dump_pending() {
+    if (!verathos_cuda_trace_enabled()) {
+        return false;
+    }
+    return !verathos_cuda_selected_ops.empty() ||
+        !verathos_cuda_selected_manifest_indexes.empty();
+}
+
+static bool verathos_cuda_capture_work_pending() {
+    if (!verathos_cuda_trace_enabled()) {
+        return false;
+    }
+    if (!verathos_cuda_selected_ops.empty() || !verathos_cuda_selected_manifest_indexes.empty()) {
+        return true;
+    }
+    if (!verathos_cuda_manifest_disabled()) {
+        return true;
+    }
+    const int64_t max_total = verathos_cuda_trace_max_ops();
+    return max_total < 0 || verathos_cuda_trace_sequence < max_total;
+}
+
+static std::string verathos_cuda_filename(const std::string & path) {
+    const size_t slash = path.find_last_of("/\\");
+    return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+static bool verathos_cuda_ends_with(const std::string & value, const std::string & suffix) {
+    return value.size() >= suffix.size() &&
+        value.compare(value.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
+
+static bool verathos_cuda_is_decode_candidate(
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * dst) {
+    // Runs for every MUL_MAT while capture is armed: plain C string checks,
+    // no per-call std::string allocations.
+    const char * tensor_name = src0 != nullptr ? src0->name : "";
+    const char * src1_name = src1 != nullptr ? src1->name : "";
+    const char * dst_name = dst != nullptr ? dst->name : "";
+    if (strcmp(tensor_name, "output.weight") == 0 ||
+        strcmp(tensor_name, "lm_head.weight") == 0) {
+        return true;
+    }
+    const size_t name_len = strlen(tensor_name);
+    static const char suffix[] = ".lm_head.weight";
+    const size_t suffix_len = sizeof(suffix) - 1;
+    if (name_len >= suffix_len &&
+        strcmp(tensor_name + name_len - suffix_len, suffix) == 0) {
+        return true;
+    }
+    if (strstr(tensor_name, "attn_output") != nullptr) {
+        return false;
+    }
+    return strcmp(dst_name, "logits") == 0 ||
+        strcmp(dst_name, "result_output") == 0 ||
+        (strstr(dst_name, "result_output") != nullptr &&
+         (strstr(src1_name, "result_norm") != nullptr ||
+          strstr(src1_name, "final") != nullptr));
+}
+
+static std::string verathos_cuda_manifest_suffix() {
+    std::string suffix;
+    for (char ch : verathos_cuda_trace_capture_token) {
+        if (ch < '0' || ch > '9') {
+            break;
+        }
+        if (suffix.size() >= 64) {
+            break;
+        }
+        suffix.push_back(ch);
+    }
+    return suffix.empty() ? "" : "-" + suffix;
+}
+
+static bool verathos_cuda_write_f32(const std::string & path, const std::vector<float> & values) {
+    std::ofstream out(path, std::ios::binary);
+    if (!out) {
+        return false;
+    }
+    out.write(reinterpret_cast<const char *>(values.data()), values.size() * sizeof(float));
+    return bool(out);
+}
+
+static bool verathos_cuda_write_raw(const std::string & path, const std::vector<uint8_t> & values) {
+    std::ofstream out(path, std::ios::binary);
+    if (!out) {
+        return false;
+    }
+    out.write(reinterpret_cast<const char *>(values.data()), values.size());
+    return bool(out);
+}
+
+static std::ostream * verathos_cuda_manifest_for_capture(const char * dir) {
+    if (verathos_cuda_manifest_disabled()) {
+        return nullptr;
+    }
+    const std::string path = std::string(dir) + "/manifest" + verathos_cuda_manifest_suffix() +
+        (verathos_cuda_manifest_compact() ? ".vmanifest" : ".jsonl");
+    if (verathos_cuda_manifest_path != path || !verathos_cuda_manifest_stream.is_open()) {
+        if (verathos_cuda_manifest_stream.is_open()) {
+            verathos_cuda_flush_manifest_buffer();
+            verathos_cuda_manifest_stream.flush();
+            verathos_cuda_manifest_stream.close();
+        }
+        verathos_cuda_manifest_buffer.clear();
+        verathos_cuda_manifest_path = path;
+        verathos_cuda_manifest_stream.open(path, std::ios::app);
+    }
+    if (!verathos_cuda_manifest_stream) {
+        return nullptr;
+    }
+    return &verathos_cuda_manifest_stream;
+}
+
+static void verathos_cuda_write_graph_marker(int device) {
+    if (!verathos_cuda_trace_active_for_graph ||
+        !verathos_cuda_manifest_v3() ||
+        verathos_cuda_graph_dim_valid_ops <= 0) {
+        return;
+    }
+    const char * dir = verathos_cuda_trace_dir();
+    if (dir == nullptr || dir[0] == '\0') {
+        return;
+    }
+    if (verathos_cuda_manifest_for_capture(dir) == nullptr) {
+        return;
+    }
+    std::string line = "VERATHOS_GGML_GRAPH_V1";
+    line += "\t" + std::to_string(verathos_cuda_unix_ns());
+    line += "\t" + std::to_string(verathos_cuda_graph_sequence);
+    line += "\t" + std::to_string(verathos_cuda_graph_dim_valid_ops);
+    line += "\t" + std::to_string(verathos_cuda_graph_written_rows);
+    line += "\t" + std::to_string(verathos_cuda_graph_max_src1_rows);
+    line += "\tllama_cpp_cuda\tCUDA" + std::to_string(device);
+    line.push_back('\n');
+    verathos_cuda_manifest_buffer += line;
+}
+
+static void verathos_cuda_write_manifest_entry(
+        const char * dir,
+        int64_t now_ns,
+        int64_t manifest_index,
+        int device,
+        bool proof_eligible,
+        int64_t graph_sequence,
+        int64_t intra_graph_index,
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * dst) {
+    if (verathos_cuda_manifest_decode_only() && !verathos_cuda_is_decode_candidate(src0, src1, dst)) {
+        return;
+    }
+    std::ostream * manifest_stream = verathos_cuda_manifest_for_capture(dir);
+    if (manifest_stream == nullptr) {
+        return;
+    }
+    std::ostream & manifest = *manifest_stream;
+    if (verathos_cuda_manifest_compact()) {
+        const bool raw_compact = verathos_cuda_manifest_compact_raw();
+        static const char * manifest_format = std::getenv("VERATHOS_GGML_TRACE_MANIFEST_FORMAT");
+        const bool raw_compact_v3 = verathos_cuda_manifest_v3();
+        const bool raw_compact_v2 = raw_compact_v3 ||
+            (manifest_format != nullptr && std::string(manifest_format) == "compact-raw-v2");
+        const std::string graph_id = std::string("cuda") + std::to_string(device) + "-mul-mat-" + std::to_string(manifest_index);
+        const std::string device_name = std::string("CUDA") + std::to_string(device);
+        if (raw_compact_v2) {
+            std::string line;
+            line.reserve(320);
+            auto append_field = [&](const std::string & value) {
+                line.push_back('\t');
+                line += value;
+            };
+            line += raw_compact_v3
+                ? "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V3"
+                : "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V2";
+            append_field(std::to_string(now_ns));
+            append_field(std::to_string(manifest_index));
+            append_field(verathos_cuda_compact_field(src0->name));
+            append_field(verathos_cuda_compact_field(src1->name));
+            append_field(verathos_cuda_compact_field(dst->name));
+            append_field(
+                std::to_string(src0->ne[0]) + "," + std::to_string(src0->ne[1]) + "," +
+                std::to_string(src0->ne[2]) + "," + std::to_string(src0->ne[3]));
+            append_field(
+                std::to_string(src1->ne[0]) + "," + std::to_string(src1->ne[1]) + "," +
+                std::to_string(src1->ne[2]) + "," + std::to_string(src1->ne[3]));
+            append_field(
+                std::to_string(dst->ne[0]) + "," + std::to_string(dst->ne[1]) + "," +
+                std::to_string(dst->ne[2]) + "," + std::to_string(dst->ne[3]));
+            append_field(ggml_type_name((ggml_type) src0->type));
+            append_field(ggml_type_name((ggml_type) src1->type));
+            append_field(ggml_type_name((ggml_type) dst->type));
+            append_field("llama_cpp_cuda");
+            append_field(verathos_cuda_compact_field(device_name.c_str()));
+            append_field(proof_eligible ? "1" : "0");
+            if (raw_compact_v3) {
+                append_field(std::to_string(graph_sequence));
+                append_field(std::to_string(intra_graph_index));
+            }
+            line.push_back('\n');
+            verathos_cuda_manifest_buffer += line;
+            return;
+        }
+        manifest << (raw_compact ? "VERATHOS_GGML_OP_MANIFEST_COMPACT_RAW_V1" : "VERATHOS_GGML_OP_MANIFEST_COMPACT_V1");
+        manifest << "\t" << now_ns;
+        manifest << "\t" << manifest_index;
+        manifest << "\t" << (raw_compact ? verathos_cuda_compact_field(graph_id.c_str()) : verathos_cuda_hex_escape(graph_id.c_str()));
+        manifest << "\t" << manifest_index;
+        manifest << "\t" << (raw_compact ? verathos_cuda_compact_field(src0->name) : verathos_cuda_hex_escape(src0->name));
+        manifest << "\t" << (raw_compact ? verathos_cuda_compact_field(src0->name) : verathos_cuda_hex_escape(src0->name));
+        manifest << "\t" << (raw_compact ? verathos_cuda_compact_field(src1->name) : verathos_cuda_hex_escape(src1->name));
+        manifest << "\t" << (raw_compact ? verathos_cuda_compact_field(dst->name) : verathos_cuda_hex_escape(dst->name));
+        manifest << "\t" << src0->ne[0] << "," << src0->ne[1] << "," << src0->ne[2] << "," << src0->ne[3];
+        manifest << "\t" << src1->ne[0] << "," << src1->ne[1] << "," << src1->ne[2] << "," << src1->ne[3];
+        manifest << "\t" << dst->ne[0] << "," << dst->ne[1] << "," << dst->ne[2] << "," << dst->ne[3];
+        manifest << "\t" << ggml_type_name((ggml_type) src0->type);
+        manifest << "\t" << ggml_type_name((ggml_type) src1->type);
+        manifest << "\t" << ggml_type_name((ggml_type) dst->type);
+        manifest << "\t" << (raw_compact ? verathos_cuda_compact_field("llama_cpp_cuda") : verathos_cuda_hex_escape("llama_cpp_cuda"));
+        manifest << "\t" << (raw_compact ? verathos_cuda_compact_field(device_name.c_str()) : verathos_cuda_hex_escape(device_name.c_str()));
+        manifest << "\t" << (proof_eligible ? "1" : "0") << "\n";
+        manifest.flush();
+        return;
+    }
+    manifest << "{\"version\":1";
+    manifest << ",\"created_unix_ns\":" << now_ns;
+    manifest << ",\"manifest_index\":" << manifest_index;
+    manifest << ",\"graph_id\":\"cuda" << device << "-mul-mat-" << manifest_index << "\"";
+    manifest << ",\"op_index\":" << manifest_index;
+    manifest << ",\"op_type\":\"GGML_OP_MUL_MAT\"";
+    manifest << ",\"tensor_name\":\"" << verathos_cuda_json_escape(src0->name) << "\"";
+    manifest << ",\"src0_name\":\"" << verathos_cuda_json_escape(src0->name) << "\"";
+    manifest << ",\"src1_name\":\"" << verathos_cuda_json_escape(src1->name) << "\"";
+    manifest << ",\"dst_name\":\"" << verathos_cuda_json_escape(dst->name) << "\"";
+    manifest << ",\"src0_shape\":[" << src0->ne[0] << "," << src0->ne[1] << "," << src0->ne[2] << "," << src0->ne[3] << "]";
+    manifest << ",\"src1_shape\":[" << src1->ne[0] << "," << src1->ne[1] << "," << src1->ne[2] << "," << src1->ne[3] << "]";
+    manifest << ",\"dst_shape\":[" << dst->ne[0] << "," << dst->ne[1] << "," << dst->ne[2] << "," << dst->ne[3] << "]";
+    manifest << ",\"source_types\":{\"src0\":\"" << ggml_type_name((ggml_type) src0->type)
+             << "\",\"src1\":\"" << ggml_type_name((ggml_type) src1->type)
+             << "\",\"dst\":\"" << ggml_type_name((ggml_type) dst->type) << "\"}";
+    manifest << ",\"backend\":\"llama_cpp_cuda\"";
+    manifest << ",\"device\":\"CUDA" << device << "\"";
+    manifest << ",\"proof_eligible\":" << (proof_eligible ? "true" : "false") << "}\n";
+    manifest.flush();
+}
+
+static bool verathos_cuda_tensor_raw_to_host(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor * tensor,
+        std::vector<uint8_t> & raw) {
+    if (tensor == nullptr || tensor->buffer == nullptr || tensor->data == nullptr) {
+        return false;
+    }
+    const char * buft_name_raw = tensor->buffer->buft->iface.get_name(tensor->buffer->buft);
+    const std::string buft_name = buft_name_raw ? buft_name_raw : "";
+    if (buft_name.rfind(GGML_CUDA_NAME, 0) != 0 ||
+        buft_name.find("_Split") != std::string::npos ||
+        buft_name.find("_Host") != std::string::npos) {
+        return false;
+    }
+    if (!ggml_is_contiguous(tensor)) {
+        return false;
+    }
+    const size_t nbytes = ggml_nbytes(tensor);
+    if (nbytes == 0) {
+        return false;
+    }
+    raw.resize(nbytes);
+    ggml_cuda_set_device(ctx.device);
+    CUDA_CHECK(cudaMemcpyAsync(raw.data(), tensor->data, nbytes, cudaMemcpyDeviceToHost, ctx.stream()));
+    return true;
+}
+
+static bool verathos_cuda_raw_to_f32(
+        const ggml_tensor * tensor,
+        const std::vector<uint8_t> & raw,
+        std::vector<float> & out) {
+    const int64_t n = ggml_nelements(tensor);
+    if (n <= 0) {
+        return false;
+    }
+    out.resize(n);
+    if (tensor->type == GGML_TYPE_F32) {
+        if (raw.size() != sizeof(float) * (size_t) n) {
+            return false;
+        }
+        memcpy(out.data(), raw.data(), raw.size());
+        return true;
+    }
+    const ggml_type_traits * traits = ggml_get_type_traits((ggml_type) tensor->type);
+    if (traits == nullptr || traits->to_float == nullptr) {
+        return false;
+    }
+    traits->to_float(raw.data(), out.data(), n);
+    return true;
+}
+
+// Verathos tail ring (probe-free light tier). The light tier's only witness
+// VALUES are the trailing decode-audit window's final-logit rows, but the
+// serve-time candidate budget is spent on the earliest tokens, so the audit
+// had to regenerate those rows with teacher-forced probes inside an
+// exclusive capture window. The ring keeps the last K final-logit decode
+// instances of the current generation in pinned host memory (stream-async
+// D2H after each graph, no sync on the decode path) and writes them out as
+// ordinary trace files once the generation goes idle, so the light proof
+// assembles from serve-time material with no replay and no exclusive
+// window. Selected-op witness dumps (hard tier, probe fallback) are
+// untouched. The final-logit dst carries GGML_TENSOR_FLAG_OUTPUT, so its
+// buffer is stable after the graph; src1 is copied best-effort only (the
+// light payload never opens src1 values).
+
+struct verathos_cuda_tail_pending {
+    const ggml_tensor * src0;
+    const ggml_tensor * src1;
+    const ggml_tensor * dst;
+    int64_t graph_seq;
+    int64_t intra_graph_index;
+    int64_t manifest_index;
+};
+
+struct verathos_cuda_tail_slot {
+    void * src1_host = nullptr;
+    void * dst_host = nullptr;
+    size_t src1_capacity = 0;
+    size_t dst_capacity = 0;
+    size_t src1_nbytes = 0;
+    size_t dst_nbytes = 0;
+    cudaEvent_t ready = nullptr;
+    int64_t ns = 0;
+    int64_t graph_seq = -1;
+    int64_t intra_graph_index = -1;
+    int64_t manifest_index = -1;
+    int device = 0;
+    int64_t src0_ne[2] = {0, 0};
+    int64_t src1_ne[2] = {0, 0};
+    int64_t dst_ne[2] = {0, 0};
+    ggml_type src0_type = GGML_TYPE_F32;
+    std::string src0_name;
+    std::string src1_name;
+    std::string dst_name;
+    bool valid = false;
+};
+
+struct verathos_cuda_tail_pool {
+    std::vector<verathos_cuda_tail_slot> slots;
+    size_t head = 0;
+    size_t count = 0;
+};
+
+static std::mutex verathos_cuda_tail_mutex;
+static verathos_cuda_tail_pool verathos_cuda_tail_pools[2];
+static int verathos_cuda_tail_active_pool = 0;
+static std::atomic<int64_t> verathos_cuda_tail_last_insert_ns{0};
+static std::atomic<bool> verathos_cuda_tail_flush_asap{false};
+static long long verathos_cuda_tail_signal_seen = 0;
+static std::vector<verathos_cuda_tail_pending> verathos_cuda_tail_staging;
+
+static bool verathos_cuda_tail_ring_on() {
+    static const bool value = verathos_cuda_env_bool("VERATHOS_GGML_TAIL_RING", true);
+    return value;
+}
+
+static int64_t verathos_cuda_tail_ring_slots() {
+    static const int64_t value = [] {
+        int64_t raw = verathos_cuda_env_i64("VERATHOS_GGML_TAIL_RING_SLOTS", 48);
+        if (raw < 4) {
+            raw = 4;
+        }
+        if (raw > 512) {
+            raw = 512;
+        }
+        return raw;
+    }();
+    return value;
+}
+
+static int64_t verathos_cuda_tail_ring_flush_ms() {
+    static const int64_t value = [] {
+        int64_t raw = verathos_cuda_env_i64("VERATHOS_GGML_TAIL_RING_FLUSH_MS", 60);
+        if (raw < 10) {
+            raw = 10;
+        }
+        if (raw > 5000) {
+            raw = 5000;
+        }
+        return raw;
+    }();
+    return value;
+}
+
+static void verathos_cuda_tail_stage(
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * dst,
+        int64_t graph_seq,
+        int64_t intra_graph_index,
+        int64_t manifest_index) {
+    if (!verathos_cuda_tail_ring_on() || verathos_cuda_selected_dump_pending()) {
+        return;
+    }
+    if (src1->ne[1] != 1 || !verathos_cuda_is_decode_candidate(src0, src1, dst)) {
+        return;
+    }
+    // The final-logit dst is a declared graph output, so its buffer survives
+    // the rest of the graph; anything else may be reused mid-graph and would
+    // be stale by the post-graph copy.
+    if ((dst->flags & GGML_TENSOR_FLAG_OUTPUT) == 0) {
+        return;
+    }
+    if (dst->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32) {
+        return;
+    }
+    if (!ggml_is_contiguous(dst) || !ggml_is_contiguous(src1)) {
+        return;
+    }
+    verathos_cuda_tail_staging.push_back(verathos_cuda_tail_pending{
+        src0, src1, dst, graph_seq, intra_graph_index, manifest_index,
+    });
+}
+
+static bool verathos_cuda_tail_write_blob(const std::string & path, const void * data, size_t nbytes) {
+    std::ofstream out(path, std::ios::binary);
+    if (!out) {
+        return false;
+    }
+    out.write(reinterpret_cast<const char *>(data), (std::streamsize) nbytes);
+    return bool(out);
+}
+
+static void verathos_cuda_tail_flush_pool(verathos_cuda_tail_pool & pool, const std::string & dir) {
+    if (pool.count == 0) {
+        return;
+    }
+    const size_t slots = pool.slots.size();
+    const size_t first = (pool.head + slots - pool.count) % slots;
+    const int64_t flush_ns = verathos_cuda_unix_ns();
+    int64_t seq = 0;
+    const int64_t total = (int64_t) pool.count;
+    for (size_t i = 0; i < pool.count; ++i) {
+        verathos_cuda_tail_slot & slot = pool.slots[(first + i) % slots];
+        if (!slot.valid) {
+            continue;
+        }
+        slot.valid = false;
+        if (slot.ready != nullptr) {
+            cudaEventSynchronize(slot.ready);
+        }
+        std::ostringstream prefix;
+        prefix << dir << "/trace-" << slot.ns << "-cuda" << slot.device
+               << "-op" << slot.manifest_index;
+        const std::string src1_path = prefix.str() + "-src1.f32";
+        const std::string dst_path = prefix.str() + "-dst.f32";
+        const std::string json_path = prefix.str() + ".json";
+        if (!verathos_cuda_tail_write_blob(src1_path, slot.src1_host, slot.src1_nbytes) ||
+            !verathos_cuda_tail_write_blob(dst_path, slot.dst_host, slot.dst_nbytes)) {
+            continue;
+        }
+        std::ofstream meta(json_path);
+        if (!meta) {
+            continue;
+        }
+        meta << "{\n";
+        meta << "  \"version\": 1,\n";
+        meta << "  \"created_unix_ns\": " << slot.ns << ",\n";
+        meta << "  \"manifest_index\": " << slot.manifest_index << ",\n";
+        meta << "  \"graph_seq\": " << slot.graph_seq << ",\n";
+        meta << "  \"intra_graph_index\": " << slot.intra_graph_index << ",\n";
+        meta << "  \"tail_ring\": 1,\n";
+        meta << "  \"tail_flush_ns\": " << flush_ns << ",\n";
+        meta << "  \"tail_seq\": " << seq << ",\n";
+        meta << "  \"tail_total\": " << total << ",\n";
+        meta << "  \"graph_id\": \"cuda" << slot.device << "-mul-mat-" << slot.manifest_index << "\",\n";
+        meta << "  \"op_index\": " << slot.manifest_index << ",\n";
+        meta << "  \"op_type\": \"GGML_OP_MUL_MAT\",\n";
+        meta << "  \"tensor_name\": \"" << verathos_cuda_json_escape(slot.src0_name.c_str()) << "\",\n";
+        meta << "  \"src0_name\": \"" << verathos_cuda_json_escape(slot.src0_name.c_str()) << "\",\n";
+        meta << "  \"src1_name\": \"" << verathos_cuda_json_escape(slot.src1_name.c_str()) << "\",\n";
+        meta << "  \"dst_name\": \"" << verathos_cuda_json_escape(slot.dst_name.c_str()) << "\",\n";
+        meta << "  \"src0_shape\": [" << slot.src0_ne[0] << "," << slot.src0_ne[1] << ",1,1],\n";
+        meta << "  \"src1_shape\": [" << slot.src1_ne[0] << "," << slot.src1_ne[1] << ",1,1],\n";
+        meta << "  \"dst_shape\": [" << slot.dst_ne[0] << "," << slot.dst_ne[1] << ",1,1],\n";
+        meta << "  \"src0_raw_type\": \"" << ggml_type_name(slot.src0_type) << "\",\n";
+        meta << "  \"src1_f32\": \"" << verathos_cuda_filename(src1_path) << "\",\n";
+        meta << "  \"dst_f32\": \"" << verathos_cuda_filename(dst_path) << "\",\n";
+        meta << "  \"source_types\": {\"src0\": \"" << ggml_type_name(slot.src0_type)
+             << "\", \"src1\": \"f32\", \"dst\": \"f32\"},\n";
+        meta << "  \"backend\": \"llama_cpp_cuda\",\n";
+        meta << "  \"device\": \"CUDA" << slot.device << "\"\n";
+        meta << "}\n";
+        seq++;
+    }
+    pool.head = 0;
+    pool.count = 0;
+}
+
+static void verathos_cuda_tail_thread_main() {
+    // Every drain (here and the rotation path in commit) runs UNDER the ring
+    // mutex: the write is ~20 MB to page cache while generation is idle, and
+    // holding the lock is what makes pool rotation race-free.
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(15));
+        const char * dir = verathos_cuda_trace_dir();
+        if (dir == nullptr || dir[0] == '\0') {
+            continue;
+        }
+        {
+            // Reply-end signal from the server: flush without waiting
+            // out the idle timer. A stale stamp from a previous run
+            // triggers at most one harmless early flush.
+            std::ifstream signal_in(std::string(dir) + "/.tail-flush");
+            long long stamp = 0;
+            if (signal_in && (signal_in >> stamp) && stamp != 0 &&
+                stamp != verathos_cuda_tail_signal_seen) {
+                verathos_cuda_tail_signal_seen = stamp;
+                verathos_cuda_tail_flush_asap.store(true);
+            }
+        }
+        std::lock_guard<std::mutex> lock(verathos_cuda_tail_mutex);
+        // A rotated-out pool holds a COMPLETE generation tail whose audit
+        // may already be polling for the files: drain it first.
+        verathos_cuda_tail_pool & inactive = verathos_cuda_tail_pools[verathos_cuda_tail_active_pool ^ 1];
+        if (inactive.count > 0) {
+            verathos_cuda_tail_flush_pool(inactive, dir);
+            verathos_cuda_tail_flush_asap.store(false);
+            continue;
+        }
+        const int64_t last = verathos_cuda_tail_last_insert_ns.load();
+        const bool asap = verathos_cuda_tail_flush_asap.load();
+        if (last == 0 && !asap) {
+            continue;
+        }
+        const int64_t idle_ns = verathos_cuda_unix_ns() - last;
+        if (!asap && idle_ns < verathos_cuda_tail_ring_flush_ms() * 1000000) {
+            continue;
+        }
+        verathos_cuda_tail_pool & active = verathos_cuda_tail_pools[verathos_cuda_tail_active_pool];
+        verathos_cuda_tail_flush_asap.store(false);
+        verathos_cuda_tail_last_insert_ns.store(0);
+        if (active.count > 0) {
+            verathos_cuda_tail_flush_pool(active, dir);
+        }
+    }
+}
+
+static void verathos_cuda_tail_commit(ggml_backend_cuda_context & ctx) {
+    const bool prefill_shaped = verathos_cuda_graph_max_src1_rows > 1;
+    if (verathos_cuda_tail_staging.empty() && !prefill_shaped) {
+        return;
+    }
+    static std::once_flag thread_once;
+    std::call_once(thread_once, [] {
+        std::thread(verathos_cuda_tail_thread_main).detach();
+    });
+    std::lock_guard<std::mutex> lock(verathos_cuda_tail_mutex);
+    if (prefill_shaped &&
+        verathos_cuda_tail_pools[verathos_cuda_tail_active_pool].count > 0) {
+        // A prefill-shaped graph while the ring holds entries means a new
+        // request started: rotate so the finished generation flushes as one
+        // group and this request's own instances start a fresh one. If the
+        // other pool still holds an undrained group (flush thread lagged),
+        // drain it here — once per request start, off the decode path.
+        verathos_cuda_tail_pool & other = verathos_cuda_tail_pools[verathos_cuda_tail_active_pool ^ 1];
+        if (other.count > 0) {
+            const char * dir = verathos_cuda_trace_dir();
+            if (dir != nullptr && dir[0] != '\0') {
+                verathos_cuda_tail_flush_pool(other, dir);
+            } else {
+                other.head = 0;
+                other.count = 0;
+            }
+        }
+        verathos_cuda_tail_active_pool ^= 1;
+        verathos_cuda_tail_flush_asap.store(true);
+        verathos_cuda_tail_last_insert_ns.store(0);
+    }
+    if (verathos_cuda_tail_staging.empty()) {
+        return;
+    }
+    verathos_cuda_tail_pool & pool = verathos_cuda_tail_pools[verathos_cuda_tail_active_pool];
+    if (pool.slots.empty()) {
+        pool.slots.resize((size_t) verathos_cuda_tail_ring_slots());
+    }
+    for (const verathos_cuda_tail_pending & pending : verathos_cuda_tail_staging) {
+        verathos_cuda_tail_slot & slot = pool.slots[pool.head];
+        const size_t src1_nbytes = ggml_nbytes(pending.src1);
+        const size_t dst_nbytes = ggml_nbytes(pending.dst);
+        if (slot.src1_capacity < src1_nbytes) {
+            if (slot.src1_host != nullptr) {
+                cudaFreeHost(slot.src1_host);
+                slot.src1_host = nullptr;
+                slot.src1_capacity = 0;
+            }
+            if (cudaMallocHost(&slot.src1_host, src1_nbytes) != cudaSuccess) {
+                slot.src1_host = nullptr;
+                continue;
+            }
+            slot.src1_capacity = src1_nbytes;
+        }
+        if (slot.dst_capacity < dst_nbytes) {
+            if (slot.dst_host != nullptr) {
+                cudaFreeHost(slot.dst_host);
+                slot.dst_host = nullptr;
+                slot.dst_capacity = 0;
+            }
+            if (cudaMallocHost(&slot.dst_host, dst_nbytes) != cudaSuccess) {
+                slot.dst_host = nullptr;
+                slot.dst_capacity = 0;
+                continue;
+            }
+            slot.dst_capacity = dst_nbytes;
+        }
+        if (slot.ready == nullptr &&
+            cudaEventCreateWithFlags(&slot.ready, cudaEventDisableTiming) != cudaSuccess) {
+            slot.ready = nullptr;
+            continue;
+        }
+        if (cudaMemcpyAsync(slot.src1_host, pending.src1->data, src1_nbytes,
+                            cudaMemcpyDeviceToHost, ctx.stream()) != cudaSuccess ||
+            cudaMemcpyAsync(slot.dst_host, pending.dst->data, dst_nbytes,
+                            cudaMemcpyDeviceToHost, ctx.stream()) != cudaSuccess) {
+            continue;
+        }
+        cudaEventRecord(slot.ready, ctx.stream());
+        slot.src1_nbytes = src1_nbytes;
+        slot.dst_nbytes = dst_nbytes;
+        slot.ns = verathos_cuda_unix_ns();
+        slot.graph_seq = pending.graph_seq;
+        slot.intra_graph_index = pending.intra_graph_index;
+        slot.manifest_index = pending.manifest_index;
+        slot.device = ctx.device;
+        slot.src0_ne[0] = pending.src0->ne[0];
+        slot.src0_ne[1] = pending.src0->ne[1];
+        slot.src1_ne[0] = pending.src1->ne[0];
+        slot.src1_ne[1] = pending.src1->ne[1];
+        slot.dst_ne[0] = pending.dst->ne[0];
+        slot.dst_ne[1] = pending.dst->ne[1];
+        slot.src0_type = (ggml_type) pending.src0->type;
+        slot.src0_name = pending.src0->name;
+        slot.src1_name = pending.src1->name;
+        slot.dst_name = pending.dst->name;
+        slot.valid = true;
+        pool.head = (pool.head + 1) % pool.slots.size();
+        if (pool.count < pool.slots.size()) {
+            pool.count++;
+        }
+        verathos_cuda_tail_last_insert_ns.store(slot.ns);
+    }
+    verathos_cuda_tail_staging.clear();
+}
+
+static void verathos_cuda_try_dump_mul_mat_trace(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * dst) {
+    if (!verathos_cuda_trace_enabled()) {
+        return;
+    }
+    const char * dir = verathos_cuda_trace_dir();
+    if (dir == nullptr || dir[0] == '\0' || src0 == nullptr || src1 == nullptr || dst == nullptr) {
+        return;
+    }
+    if (dst->op != GGML_OP_MUL_MAT) {
+        return;
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 ||
+        src1->ne[2] != 1 || src1->ne[3] != 1 ||
+        dst->ne[2]  != 1 || dst->ne[3]  != 1) {
+        return;
+    }
+    if (src0->ne[0] != src1->ne[0] ||
+        dst->ne[0]  != src0->ne[1] ||
+        dst->ne[1]  != src1->ne[1]) {
+        return;
+    }
+
+    // Intra-graph index counts every dim-valid MUL_MAT regardless of size
+    // eligibility, so it stays stable across batch row counts.
+    const int64_t intra_graph_index = verathos_cuda_intra_graph_index++;
+    verathos_cuda_graph_dim_valid_ops++;
+    if (src1->ne[1] > verathos_cuda_graph_max_src1_rows) {
+        verathos_cuda_graph_max_src1_rows = src1->ne[1];
+    }
+
+    const int64_t now_ns = verathos_cuda_unix_ns();
+    const int64_t manifest_index = ++verathos_cuda_manifest_sequence;
+    const int64_t total_elems = ggml_nelements(src0) + ggml_nelements(src1) + ggml_nelements(dst);
+    static const int64_t max_elems = verathos_cuda_env_i64("VERATHOS_GGML_TRACE_MAX_ELEMS", 262144);
+    const bool dump_eligible =
+        verathos_cuda_is_decode_candidate(src0, src1, dst) ||
+        !(max_elems > 0 && total_elems > max_elems);
+    // v3 manifests commit a COMPLETE challenge space: every dim-valid op
+    // gets a row (slot-view leaves and beacon selection need the full
+    // universe; witnesses for undumped ops regenerate on demand from the
+    // committed weights). The size cap keeps bounding only the heavy
+    // serve-time candidate DUMPS below, never the rows. Legacy formats
+    // keep the old behavior: no row for oversized ops.
+    if (!dump_eligible && !verathos_cuda_manifest_v3()) {
+        return;
+    }
+    verathos_cuda_write_manifest_entry(
+            dir, now_ns, manifest_index, ctx.device, /*proof_eligible=*/true,
+            verathos_cuda_graph_sequence, intra_graph_index, src0, src1, dst);
+    verathos_cuda_graph_written_rows++;
+    verathos_cuda_tail_stage(
+            src0, src1, dst,
+            verathos_cuda_graph_sequence, intra_graph_index, manifest_index);
+    // Same capture stop as the MUL_MAT_ID hook: the dump below does D2H
+    // copies + a stream sync, illegal while this thread records a CUDA
+    // graph. The selected-op second pass bypasses every budget check, so
+    // without this it can fire mid-capture and abort the process.
+    if (verathos_cuda_in_graph_capture) {
+        return;
+    }
+    const bool selected_op_dump = !verathos_cuda_selected_ops.empty() &&
+        verathos_cuda_should_dump_selected_op(verathos_cuda_graph_sequence, intra_graph_index);
+    if (!selected_op_dump && !verathos_cuda_selected_ops.empty()) {
+        return;
+    }
+    if (!selected_op_dump && !verathos_cuda_should_dump_manifest_index(manifest_index)) {
+        return;
+    }
+    // The size cap bounds only the opportunistic serve-time candidate
+    // dumps. An ARMED window (selected ops or selected manifest indexes)
+    // must witness whatever op the beacon picked, whatever its size; a
+    // single audited instance is a few KB of activations (src0 skipped).
+    const bool armed_dump =
+        selected_op_dump || !verathos_cuda_selected_manifest_indexes.empty();
+    if (!armed_dump && !dump_eligible) {
