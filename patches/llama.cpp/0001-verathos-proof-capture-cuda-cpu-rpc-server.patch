+static int64_t verathos_cpu_trace_max_ops(void) {
+    const char * per_capture = getenv("VERATHOS_GGML_TRACE_MAX_OPS_PER_CAPTURE");
+    if (per_capture != NULL && per_capture[0] != '\0') {
+        return verathos_cpu_env_i64("VERATHOS_GGML_TRACE_MAX_OPS_PER_CAPTURE", 64);
