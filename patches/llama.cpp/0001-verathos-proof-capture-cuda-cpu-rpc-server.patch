+static bool verathos_cpu_trace_enabled(void) {
+    const char * dir = verathos_cpu_trace_dir();
+    if (dir == NULL || dir[0] == '\0') {
+        return false;
+    }
+    const char * enable_file = getenv("VERATHOS_GGML_TRACE_ENABLE_FILE");
+    if (enable_file != NULL && enable_file[0] != '\0') {
+#if defined(_WIN32)
+        if (_access(enable_file, 0) != 0) {
+#else
+        if (access(enable_file, F_OK) != 0) {
+#endif
+            return false;
+        }
+        verathos_cpu_refresh_capture_token(enable_file);
+    }
+    return true;
+}
