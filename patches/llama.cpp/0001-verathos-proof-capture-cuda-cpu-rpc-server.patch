+    verathos_cpu_json_escape(manifest, dst->name);
+    fprintf(manifest, "\"");
+    fprintf(manifest, ",\"src0_shape\":[%lld,%lld,%lld,%lld]",
+            (long long) src0->ne[0], (long long) src0->ne[1],
+            (long long) src0->ne[2], (long long) src0->ne[3]);
+    fprintf(manifest, ",\"src1_shape\":[%lld,%lld,%lld,%lld]",
+            (long long) src1->ne[0], (long long) src1->ne[1],
+            (long long) src1->ne[2], (long long) src1->ne[3]);
+    fprintf(manifest, ",\"dst_shape\":[%lld,%lld,%lld,%lld]",
+            (long long) dst->ne[0], (long long) dst->ne[1],
+            (long long) dst->ne[2], (long long) dst->ne[3]);
+    fprintf(manifest, ",\"source_types\":{\"src0\":\"%s\",\"src1\":\"%s\",\"dst\":\"%s\"}",
+            ggml_type_name(src0->type), ggml_type_name(src1->type), ggml_type_name(dst->type));
+    fprintf(manifest, ",\"backend\":\"llama_cpp_cpu\"");
+    fprintf(manifest, ",\"device\":\"CPU\"");
+    fprintf(manifest, ",\"proof_eligible\":%s}\n", proof_eligible ? "true" : "false");
+    fflush(manifest);
