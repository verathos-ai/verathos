+    0x5b9cca4fu, 0x682e6ff3u, 0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
+    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u,
+};
+
+static inline uint32_t verathos_ror32(uint32_t value, uint32_t bits) {
+    return (value >> bits) | (value << (32 - bits));
+}
+
+static void verathos_sha256_init(verathos_sha256 & ctx) {
+    ctx.state[0] = 0x6a09e667u; ctx.state[1] = 0xbb67ae85u;
+    ctx.state[2] = 0x3c6ef372u; ctx.state[3] = 0xa54ff53au;
+    ctx.state[4] = 0x510e527fu; ctx.state[5] = 0x9b05688cu;
+    ctx.state[6] = 0x1f83d9abu; ctx.state[7] = 0x5be0cd19u;
+    ctx.bitlen = 0;
+    ctx.buflen = 0;
+}
+
+static void verathos_sha256_block(verathos_sha256 & ctx, const uint8_t * block) {
+    uint32_t w[64];
+    for (int i = 0; i < 16; ++i) {
+        w[i] = ((uint32_t) block[i * 4 + 0] << 24) |
+               ((uint32_t) block[i * 4 + 1] << 16) |
+               ((uint32_t) block[i * 4 + 2] <<  8) |
+               ((uint32_t) block[i * 4 + 3]);
+    }
+    for (int i = 16; i < 64; ++i) {
+        const uint32_t s0 = verathos_ror32(w[i - 15], 7) ^ verathos_ror32(w[i - 15], 18) ^ (w[i - 15] >> 3);
+        const uint32_t s1 = verathos_ror32(w[i - 2], 17) ^ verathos_ror32(w[i - 2], 19) ^ (w[i - 2] >> 10);
+        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+    }
+    uint32_t a = ctx.state[0], b = ctx.state[1], c = ctx.state[2], d = ctx.state[3];
+    uint32_t e = ctx.state[4], f = ctx.state[5], g = ctx.state[6], h = ctx.state[7];
+    for (int i = 0; i < 64; ++i) {
+        const uint32_t s1 = verathos_ror32(e, 6) ^ verathos_ror32(e, 11) ^ verathos_ror32(e, 25);
+        const uint32_t ch = (e & f) ^ ((~e) & g);
+        const uint32_t t1 = h + s1 + ch + VERATHOS_SHA256_K[i] + w[i];
+        const uint32_t s0 = verathos_ror32(a, 2) ^ verathos_ror32(a, 13) ^ verathos_ror32(a, 22);
+        const uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+        const uint32_t t2 = s0 + maj;
+        h = g; g = f; f = e; e = d + t1;
+        d = c; c = b; b = a; a = t1 + t2;
+    }
+    ctx.state[0] += a; ctx.state[1] += b; ctx.state[2] += c; ctx.state[3] += d;
+    ctx.state[4] += e; ctx.state[5] += f; ctx.state[6] += g; ctx.state[7] += h;
+}
+
+static void verathos_sha256_update(verathos_sha256 & ctx, const void * data, size_t len) {
+    const uint8_t * bytes = (const uint8_t *) data;
+    ctx.bitlen += (uint64_t) len * 8;
+    while (len > 0) {
+        const size_t take = std::min(len, sizeof(ctx.buf) - ctx.buflen);
+        memcpy(ctx.buf + ctx.buflen, bytes, take);
+        ctx.buflen += take;
+        bytes += take;
+        len -= take;
+        if (ctx.buflen == sizeof(ctx.buf)) {
+            verathos_sha256_block(ctx, ctx.buf);
+            ctx.buflen = 0;
+        }
+    }
+}
+
+// Finalises a copy, so the running context can keep absorbing afterwards.
+static std::string verathos_sha256_hex(const verathos_sha256 & running) {
+    verathos_sha256 ctx = running;
+    const uint64_t bitlen = ctx.bitlen;
+    const uint8_t pad = 0x80;
+    verathos_sha256_update(ctx, &pad, 1);
+    const uint8_t zero = 0x00;
+    while (ctx.buflen != 56) {
+        verathos_sha256_update(ctx, &zero, 1);
+    }
+    uint8_t tail[8];
+    for (int i = 0; i < 8; ++i) {
+        tail[i] = (uint8_t) (bitlen >> (56 - i * 8));
+    }
+    memcpy(ctx.buf + ctx.buflen, tail, 8);
+    verathos_sha256_block(ctx, ctx.buf);
+    static const char * digits = "0123456789abcdef";
+    std::string out;
+    out.reserve(64);
+    for (int i = 0; i < 8; ++i) {
+        for (int shift = 24; shift >= 0; shift -= 8) {
+            const uint8_t byte = (uint8_t) (ctx.state[i] >> shift);
+            out.push_back(digits[byte >> 4]);
+            out.push_back(digits[byte & 0x0f]);
+        }
+    }
+    return out;
+}
+
+static bool verathos_boundary_capture_enabled() {
+    static const bool value = [] {
+        const char * raw = std::getenv("VERATHOS_GGML_BOUNDARY_CAPTURE");
+        return raw != nullptr && raw[0] == '1';
+    }();
+    return value;
+}
+
+static verathos_sha256 verathos_boundary_in;
+static verathos_sha256 verathos_boundary_out;
+static uint64_t verathos_boundary_in_bytes = 0;
+static uint64_t verathos_boundary_out_bytes = 0;
+static std::string verathos_boundary_token;
+static bool verathos_boundary_started = false;
+
+// The enable file's contents identify the request window, exactly as the
+// existing candidate-witness budget uses it.  A new token starts a new chain,
+// so a boundary root always covers one request and never bleeds across.
+#if defined(__APPLE__)
+#define verathos_st_mtim st_mtimespec
+#else
+#define verathos_st_mtim st_mtim
+#endif
+static bool verathos_boundary_window(std::string & token) {
+    const char * enable_file = std::getenv("VERATHOS_GGML_TRACE_ENABLE_FILE");
+    if (enable_file == nullptr || enable_file[0] == '\0') {
+        // No window means no capture, deliberately.  Absorbing whenever the
+        // hook happens to be enabled swallows the model weight upload, which
+        // arrives through the same set_tensor path at load time and is orders
+        // of magnitude larger than any activation handoff.  Measured on a live
+        // two-worker 4090 mesh: 289 MB of weights against 240 KB of
+        // activations, which made the two stages' roots disagree for a reason
+        // that had nothing to do with the pipeline.
+        return false;
+    }
+#if !defined(_WIN32)
+    // This runs on every tensor crossing the RPC edge; re-reading the enable
+    // file each time cost real decode throughput on a live 4090 mesh.  A
+    // stat() is an order of magnitude cheaper than open+read+close, and the
+    // token only changes when the arming side rewrites the file, which stat
+    // observes via inode/size/mtime.
+    static struct {
+        bool valid;
+        dev_t dev;
+        ino_t ino;
+        off_t size;
+        struct timespec mtim;
+        std::string token;
+    } cache = {};
+    struct stat st;
+    if (::stat(enable_file, &st) != 0) {
+        cache.valid = false;
+        return false;
+    }
+    if (cache.valid && st.st_dev == cache.dev && st.st_ino == cache.ino &&
+        st.st_size == cache.size &&
+        st.verathos_st_mtim.tv_sec == cache.mtim.tv_sec &&
+        st.verathos_st_mtim.tv_nsec == cache.mtim.tv_nsec) {
+        token = cache.token;
+        return true;
+    }
+#endif
+    std::ifstream in(enable_file);
+    if (!in) {
+        return false;
+    }
+    std::getline(in, token);
+    if (token.empty()) {
+        token = "present";
+    }
+#if !defined(_WIN32)
+    cache.valid = true;
+    cache.dev = st.st_dev;
+    cache.ino = st.st_ino;
+    cache.size = st.st_size;
+    cache.mtim = st.verathos_st_mtim;
+    cache.token = token;
+#endif
+    return true;
+}
+
+// The inter-stage handoff is one tensor: the last layer output the upstream
+// stage produced, which the scheduler hands to the next stage under the same
+// source name.  Measured on a live two-stage 4090 mesh, stage 0 emitted
+// "l_out-9" and stage 1 received "RPC0[127.0.0.1:50051]#l_out-9#0" at
+// identical sizes.
+//
+// "embd" is the same slot for the head of the pipeline: the first stage has
+// no upstream "l_out-", it receives the embedding rows instead, and unlike
+// "attn_inp_kq_mask" and the "leaf_N" position/rope tensors (which go to
+// every stage alike) "embd" is sent only to the stage that owns layer 0.
+// Absorbing it anchors the chain to the embedding actually fed in, so the
+// chain runs from the model input to the last handoff with no open head.
+// Hashing whole directions instead swept in the broadcast tensors and made
+// the two sides disagree for reasons that had nothing to do with the
+// pipeline.
+static bool verathos_is_stage_boundary_tensor(const char * raw_name) {
+    std::string name(raw_name ? raw_name : "");
+    // Inbound tensors arrive wrapped as RPC<dev>[<addr>]#<source>#<n>.
+    const size_t first = name.find('#');
+    if (first != std::string::npos) {
+        const size_t last = name.rfind('#');
+        if (last > first) {
+            name = name.substr(first + 1, last - first - 1);
+        }
+    }
+    return name.rfind("l_out-", 0) == 0 || name == "embd";
+}
+
+// Returns true when the boundary state advanced, i.e. the caller must
+// refresh the on-disk row.  Most transfers crossing the edge are broadcast
+// graph inputs that never match; rewriting the row for those cost real
+// decode throughput for no information.
+static bool verathos_boundary_absorb(
+        const void * data, size_t size, bool inbound,
+        const char * name = "") {
+    if (!verathos_boundary_capture_enabled() || data == nullptr || size == 0) {
+        return false;
+    }
+    // The NAME filter is what keeps the model weight upload out of the chain
+    // (weights arrive as blk.N.*.weight / output.weight and never match), so
+    // it must run FIRST and unconditionally.  Gating absorption on an open
+    // capture window instead dropped real handoffs: measured on a live
+    // two-stage mesh, 4 of 25 boundary crossings landed while the window was
+    // closed, and because the row file holds only the latest chain state the
+    // verifier then discarded it as stale and failed the request closed
+    // ("float recompute was skipped by a stage that committed no input
+    // activation boundary"), intermittently, on about one request in ten.
+    if (!verathos_is_stage_boundary_tensor(name)) {
+        return false;
+    }
+    // The window token SEGMENTS chains, it does not gate them: a new token
+    // starts a fresh per-request chain, and a closed window keeps extending
+    // the current one rather than dropping the crossing on the floor.
+    std::string token;
+    const bool have_token = verathos_boundary_window(token);
+    if (!verathos_boundary_started || (have_token && token != verathos_boundary_token)) {
+        verathos_sha256_init(verathos_boundary_in);
+        verathos_sha256_init(verathos_boundary_out);
+        verathos_boundary_in_bytes = 0;
+        verathos_boundary_out_bytes = 0;
+        if (have_token) {
+            verathos_boundary_token = token;
+        }
+        verathos_boundary_started = true;
+    }
+    if (inbound) {
+        verathos_sha256_update(verathos_boundary_in, data, size);
+        verathos_boundary_in_bytes += size;
+    } else {
+        verathos_sha256_update(verathos_boundary_out, data, size);
+        verathos_boundary_out_bytes += size;
+    }
+    return true;
+}
+
+// Written next to the op manifest so the coordinator reads both from one
+// place.  Emitted after every absorb that advanced the state (the RPC server
+// has no request boundary of its own), over a persistent descriptor: an
+// open/truncate/write/close cycle per emitted row cost measurable decode
+// throughput on a live 4090 mesh.
+static void verathos_boundary_emit(void) {
+    if (!verathos_boundary_capture_enabled() || !verathos_boundary_started) {
+        return;
+    }
+    const char * dir_raw = verathos_trace_dir();
+    if (dir_raw == nullptr || dir_raw[0] == '\0') {
+        return;
+    }
+    std::string line;
+    line.reserve(320);
+    line += "{\"row\":\"VERATHOS_GGML_BOUNDARY_V1\"";
+    line += ",\"created_unix_ns\":" + std::to_string(verathos_unix_ns());
+    line += ",\"capture_token\":\"" + verathos_json_escape(verathos_boundary_token.c_str()) + "\"";
+    line += ",\"input_boundary_root\":\"" + verathos_sha256_hex(verathos_boundary_in) + "\"";
+    line += ",\"output_boundary_root\":\"" + verathos_sha256_hex(verathos_boundary_out) + "\"";
+    line += ",\"input_bytes\":" + std::to_string(verathos_boundary_in_bytes);
+    line += ",\"output_bytes\":" + std::to_string(verathos_boundary_out_bytes);
+    line += "}\n";
+#if !defined(_WIN32)
+    static int boundary_fd = -1;
+    static std::string boundary_fd_path;
+    const std::string path = (fs::path(dir_raw) / "boundary.jsonl").string();
+    if (boundary_fd < 0 || boundary_fd_path != path) {
+        if (boundary_fd >= 0) {
+            ::close(boundary_fd);
+        }
+        std::error_code ec;
+        fs::create_directories(fs::path(dir_raw), ec);
+        if (ec) {
+            return;
+        }
+        boundary_fd = ::open(path.c_str(), O_CREAT | O_WRONLY | O_CLOEXEC, 0644);
+        if (boundary_fd < 0) {
+            return;
+        }
+        boundary_fd_path = path;
+    }
+    if (::pwrite(boundary_fd, line.data(), line.size(), 0) != (ssize_t) line.size()) {
+        return;
+    }
+    (void) ::ftruncate(boundary_fd, (off_t) line.size());
+#else
+    std::error_code ec;
+    fs::create_directories(fs::path(dir_raw), ec);
+    if (ec) {
+        return;
+    }
+    const fs::path path = fs::path(dir_raw) / "boundary.jsonl";
+    std::ofstream out(path, std::ios::trunc);
+    if (!out) {
+        return;
+    }
+    out << line;
+#endif
+}
