+// A pure view node whose storage lives on ANOTHER server (or on the host)
+// cannot be materialized remotely: its data pointer is meaningless there and
+// the member rejects the graph at create_node ("invalid data ptr"). Such
+// nodes are dead weight in this split anyway - views execute nowhere, and
+// consumers on the owning server receive them through src recursion. The
+// scheduler leaves them in the split range because it skips view ops when
+// choosing split boundaries (deepseek4 CSA state views at layer boundaries
+// are the live case).
+static bool rpc_node_is_foreign_view(const std::shared_ptr<socket_t> & sock, const ggml_tensor * node) {
+    const bool is_view_op = node->op == GGML_OP_VIEW || node->op == GGML_OP_RESHAPE ||
+        node->op == GGML_OP_PERMUTE || node->op == GGML_OP_TRANSPOSE;
+    if (!is_view_op) {
+        return false;
+    }
+    const ggml_tensor * base = node->view_src ? node->view_src : node;
+    ggml_backend_buffer_t buf = base->buffer;
+    if (buf == nullptr) {
+        return false;
+    }
+    if (!ggml_backend_buffer_is_rpc(buf)) {
+        return true;
+    }
+    ggml_backend_rpc_buffer_context * buf_ctx = (ggml_backend_rpc_buffer_context *)buf->context;
+    return buf_ctx->sock.get() != sock.get();
+}
